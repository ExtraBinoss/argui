import { Marker } from "@argui/ui"
import { Column, Text } from "@argui/native"

export component MarkerPage {
    Column #marker_page {
        width: 100%
        gap: 18.0

        Text { content: "Marker" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Quiet system notes between messages." color: var(--argui-muted-foreground) font_size: 14.0 }

        Marker { text: "All changes saved" }
        Marker { text: "Switched to the design branch" variant: "border" }
        Marker { text: "Today" variant: "separator" }
    }
}
