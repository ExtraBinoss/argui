import { Select } from "@argui/ui"
import { Column, Container, Text } from "@argui/native"

export component SelectPage {
    private property backend: string = "Vulkan"

    Column #select_page {
        width: 100%
        gap: 18.0

        Text { content: "Select" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Choose the backend for your next render." color: var(--argui-muted-foreground) font_size: 14.0 }

        Container #backend_select_anchor { width: 240px
            Select {
                anchor: "backend_select_anchor"
                label: "Choose a backend"
                value <=> backend
                options: ["Vulkan", "DirectX 12", "Metal", "WebGPU"]
                width: 240px
            }
        }
        Text { content: "Selected " + backend color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
