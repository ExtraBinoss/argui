import { Button, Input, Switch } from "@argui/ui"
import { Column, Row, Text } from "@argui/native"

export component QuestionnairePage {
    private property step: int = 0
    private property project: string = ""
    private property idea: string = ""
    private property keyboard: bool = false
    private property dark_mode: bool = false
    private property live_data: bool = false
    private property attempted: bool = false
    private property submitted: bool = false
    private property skipped_features: bool = false
    private property first_valid: bool = project != "" || idea != ""

    Column #questionnaire_page {
        width: 100%
        gap: 16.0

        Text { content: "Questionnaire" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Answer two short questions before submitting." color: var(--argui-muted-foreground) font_size: 14.0 }

        if step == 0 {
            Column { width: 100% gap: 12.0
                Text { content: "1 / 2" color: var(--argui-muted-foreground) font_size: 13.0 }
                Text { content: "What would you like to build?" color: var(--argui-foreground) font_size: 20.0 weight: 600 }
                Text { content: "Choose a starting point, or describe your idea." color: var(--argui-muted-foreground) font_size: 14.0 }
                Row { wrap: true gap: 8.0
                    Button { text: "Desktop app" variant: project == "Desktop app" ? "primary" : "outline" on click { project = "Desktop app" attempted = false submitted = false } }
                    Button { text: "Dashboard" variant: project == "Dashboard" ? "primary" : "outline" on click { project = "Dashboard" attempted = false submitted = false } }
                    Button { text: "Design tool" variant: project == "Design tool" ? "primary" : "outline" on click { project = "Design tool" attempted = false submitted = false } }
                }
                Input { value <=> idea label: "Your answer" placeholder: "Your answer" invalid: attempted && !first_valid }
                if attempted && !first_valid {
                    Text { content: "Choose or enter a valid answer." color: var(--argui-destructive) font_size: 13.0 }
                }
                Row { gap: 8.0
                    Button { text: "Previous" variant: "outline" enabled: false }
                    Button { text: "Skip" variant: "ghost" enabled: false }
                    Button { text: "Next" on click {
                        attempted = true
                        step = first_valid ? 1 : 0
                    } }
                }
            }
        }

        if step == 1 {
            Column { width: 100% gap: 12.0
                Text { content: "2 / 2" color: var(--argui-muted-foreground) font_size: 13.0 }
                Text { content: "Which features matter to you?" color: var(--argui-foreground) font_size: 20.0 weight: 600 }
                Switch { label: "Keyboard support" checked: keyboard on click { keyboard = !keyboard skipped_features = false submitted = false } }
                Switch { label: "Dark mode" checked: dark_mode on click { dark_mode = !dark_mode skipped_features = false submitted = false } }
                Switch { label: "Live data" checked: live_data on click { live_data = !live_data skipped_features = false submitted = false } }
                if skipped_features {
                    Text { content: "Optional features skipped." color: var(--argui-muted-foreground) font_size: 13.0 }
                }
                Row { gap: 8.0 wrap: true
                    Button { text: "Previous" variant: "outline" on click { step = 0 submitted = false } }
                    Button { text: "Skip" variant: "ghost" on click {
                        keyboard = false
                        dark_mode = false
                        live_data = false
                        skipped_features = true
                        submitted = false
                    } }
                    Button { text: "Submit" on click { submitted = true } }
                }
            }
        }

        if submitted {
            Text { content: "Your answers are ready." color: var(--argui-foreground) font_size: 14.0 weight: 600 }
        }
    }
}
