import { Breadcrumb, Card } from "@argui/ui"
import { Column, Text } from "@argui/native"

export component BreadcrumbPage {
    callback navigate(page: string)
    private property last_destination: string = "Breadcrumb"

    Column #breadcrumb_page {
        width: 100%
        gap: 20.0

        Text { content: "Breadcrumb" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Follow the trail back to an earlier page." color: var(--argui-muted-foreground) font_size: 14.0 }

        Breadcrumb {
            links: ["Home", "Components"]
            current: "Breadcrumb"
            on activate(link) {
                last_destination = link
                navigate(link == "Home" ? "Button" : "Card")
            }
        }

        Text { content: "A different separator" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
        Text { content: "Keep the current page quiet and let the path do the work." color: var(--argui-muted-foreground) font_size: 14.0 }

        Card {
            Column {
                gap: 14.0
                Text { content: "Component library" color: var(--argui-foreground) weight: 600 font_size: 17.0 }
                Text { content: "Build a familiar route through your workspace." color: var(--argui-muted-foreground) font_size: 14.0 }
                Breadcrumb {
                    links: ["Projects", "Component library"]
                    current: "Navigation"
                    separator: "›"
                    label: "Project location"
                    on activate(link) {
                        last_destination = link
                        navigate(link == "Projects" ? "Empty" : "Card")
                    }
                }
            }
        }

        Text { content: "Last destination: " + last_destination color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
