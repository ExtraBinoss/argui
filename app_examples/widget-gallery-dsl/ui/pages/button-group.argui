import { Button, Input, Menu, MenuItem, Popover } from "@argui/ui"
import { ButtonGroup, GroupAction, GroupInput, GroupSeparator } from "@argui/ui/button-group.argui"
import { Column, Container, Row, Text } from "@argui/native"
import { ArrowLeft, ChevronDown, Microphone, Minus, Paperclip, Plus, Search, Send } from "@argui/icons"

export component ButtonGroupPage {
    private property last_action: string = "Choose an action"
    private property count: int = 0
    private property search: string = ""
    private property message: string = ""
    private property amount: string = "10.00"
    private property currency: string = "$"
    private property follow_mode: string = "All notifications"
    private property menu_open: bool = false
    private property select_open: bool = false
    private property task_open: bool = false
    private property voice: bool = false
    private property task: string = ""

    Column {
        width: 100%
        gap: 22.0
        Text { content: "Button group" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Joined actions, fields and menus share a named surface while keeping their own interactions." color: var(--argui-muted-foreground) font_size: 14.0 }
        Text { content: last_action color: var(--argui-primary) weight: 600 font_size: 13.0 }

        Column {
            gap: 9.0
            Text { content: "Overview" color: var(--argui-muted-foreground) weight: 600 font_size: 13.0 }
            ButtonGroup { label: "Mail actions" width: 310px
                GroupAction { text: "Back" show_text: false on click { last_action = "Back" } ArrowLeft { size: 16px } }
                GroupSeparator {}
                GroupAction { text: "Archive" on click { last_action = "Archived message" } }
                GroupSeparator {}
                GroupAction { text: "Report" on click { last_action = "Reported message" } }
                GroupSeparator {}
                GroupAction { text: "Snooze" on click { last_action = "Snoozed message" } }
            }
        }

        Row {
            wrap: true
            gap: 22.0
            Column {
                gap: 9.0
                Text { content: "Orientation" color: var(--argui-muted-foreground) weight: 600 font_size: 13.0 }
                ButtonGroup { label: "Media controls" vertical: true width: 80px
                    GroupAction { text: "Increase" show_text: false on click { count = count + 1 last_action = "Level: " + str(count) } Plus { size: 16px } }
                    GroupSeparator { vertical: true }
                    GroupAction { text: "Decrease" show_text: false on click { count = count - 1 last_action = "Level: " + str(count) } Minus { size: 16px } }
                }
            }
            Column {
                gap: 9.0
                Text { content: "Sizes" color: var(--argui-muted-foreground) weight: 600 font_size: 13.0 }
                ButtonGroup { label: "Small actions" width: 138px
                    GroupAction { text: "Small" height: 30px padding: 9.0 on click { last_action = "Small" } }
                    GroupSeparator { height: 30px }
                    GroupAction { text: "Add" height: 30px padding: 9.0 on click { last_action = "Added small item" } }
                }
                ButtonGroup { label: "Default actions" width: 158px
                    GroupAction { text: "Default" on click { last_action = "Default" } }
                    GroupSeparator {}
                    GroupAction { text: "Add" on click { last_action = "Added item" } }
                }
                ButtonGroup { label: "Large actions" width: 178px
                    GroupAction { text: "Large" height: 44px padding: 17.0 on click { last_action = "Large" } }
                    GroupSeparator { height: 44px }
                    GroupAction { text: "Add" height: 44px padding: 17.0 on click { last_action = "Added large item" } }
                }
            }
        }

        Column {
            gap: 9.0
            Text { content: "Nested input and split action" color: var(--argui-muted-foreground) weight: 600 font_size: 13.0 }
            Row { wrap: true gap: 12.0
                ButtonGroup { label: "Compose message" width: 390px
                    GroupAction { text: "Add attachment" show_text: false on click { last_action = "Add attachment" } Paperclip { size: 16px } }
                    GroupSeparator {}
                    Container { min_width: 0.0 grow: 1.0
                        GroupInput { value <=> message label: "Message" placeholder: "Send a message…" on submit { last_action = "Sent: " + message message = "" } }
                    }
                    GroupAction { text: "Send" enabled: message != "" on click { last_action = "Sent: " + message message = "" } Send { size: 15px } }
                }
                ButtonGroup { label: "Clipboard actions" width: 150px
                    GroupAction { text: "Copy" on click { last_action = "Copied" } }
                    GroupSeparator {}
                    GroupAction { text: "Paste" on click { last_action = "Pasted" } }
                }
            }
        }

        Column {
            gap: 9.0
            Text { content: "Nested groups" color: var(--argui-muted-foreground) weight: 600 font_size: 13.0 }
            ButtonGroup { label: "Nested message actions" width: 410px
                ButtonGroup { label: "Attachment actions" width: 58px
                    GroupAction { text: "Add attachment" show_text: false on click { last_action = "Add attachment" } Plus { size: 16px } }
                }
                Container { width: 8px }
                ButtonGroup { label: "Nested message field" width: 340px
                    Container { min_width: 0.0 grow: 1.0
                        GroupInput { value <=> message label: "Nested message" placeholder: "Send a message…" on submit { last_action = "Sent: " + message message = "" } }
                    }
                    GroupAction { text: "Send" enabled: message != "" on click { last_action = "Sent: " + message message = "" } }
                }
            }
        }

        Column {
            gap: 9.0
            Text { content: "Search and voice input" color: var(--argui-muted-foreground) weight: 600 font_size: 13.0 }
            Row { wrap: true gap: 12.0
                ButtonGroup { label: "Search" width: 370px
                    GroupAction { text: "Search" show_text: false on click { last_action = "Search: " + search } Search { size: 16px } }
                    Container { min_width: 0.0 grow: 1.0
                        GroupInput { value <=> search label: "Search" placeholder: "Search…" on submit { last_action = "Search: " + search } }
                    }
                    GroupAction { text: "Go" enabled: search != "" on click { last_action = "Search: " + search } }
                }
                ButtonGroup { label: "Voice message" width: 238px
                    GroupAction { text: voice ? "Stop" : "Record" selected: voice on click { voice = !voice last_action = voice ? "Voice recording" : "Recording stopped" } Microphone { size: 15px } }
                    GroupSeparator {}
                    GroupAction { text: "Send" enabled: !voice && message != "" on click { last_action = "Sent: " + message message = "" } }
                }
            }
        }

        Row { wrap: true gap: 22.0
            Column {
                gap: 9.0
                Text { content: "Dropdown menu" color: var(--argui-muted-foreground) weight: 600 font_size: 13.0 }
                ButtonGroup { label: "Follow options" width: 225px
                    GroupAction { text: "Follow" on click { last_action = "Following · " + follow_mode } }
                    GroupSeparator {}
                    Container #follow_anchor {
                        GroupAction { text: "Follow options" show_text: false on click { menu_open = !menu_open } ChevronDown { size: 16px } }
                    }
                }
                Menu { open: menu_open anchor: "follow_anchor" label: "Follow options" on dismiss { menu_open = false }
                    MenuItem { text: "All notifications" on select { follow_mode = "All notifications" menu_open = false last_action = "Following · All notifications" } }
                    MenuItem { text: "Mentions only" on select { follow_mode = "Mentions only" menu_open = false last_action = "Following · Mentions only" } }
                    MenuItem { text: "Unfollow" on select { follow_mode = "Off" menu_open = false last_action = "Unfollowed" } }
                }
            }
            Column {
                gap: 9.0
                Text { content: "Select" color: var(--argui-muted-foreground) weight: 600 font_size: 13.0 }
                ButtonGroup { label: "Currency amount" width: 330px
                    Container #currency_anchor {
                        GroupAction { text: currency on click { select_open = !select_open } ChevronDown { size: 14px } }
                    }
                    GroupSeparator {}
                    Container { min_width: 0.0 grow: 1.0
                        GroupInput { value <=> amount label: "Amount" placeholder: "10.00" }
                    }
                    GroupAction { text: "Send" enabled: amount != "" on click { last_action = "Sent " + currency + amount } }
                }
                Menu { open: select_open anchor: "currency_anchor" label: "Currency" width: 100px on dismiss { select_open = false }
                    MenuItem { text: "$" selected: currency == "$" on select { currency = "$" select_open = false } }
                    MenuItem { text: "€" selected: currency == "€" on select { currency = "€" select_open = false } }
                    MenuItem { text: "£" selected: currency == "£" on select { currency = "£" select_open = false } }
                }
            }
        }

        Column {
            gap: 9.0
            Text { content: "Popover" color: var(--argui-muted-foreground) weight: 600 font_size: 13.0 }
            ButtonGroup { label: "Copilot options" width: 220px
                GroupAction { text: "Copilot" on click { task_open = true } }
                GroupSeparator {}
                Container #task_anchor {
                    GroupAction { text: "Copilot options" show_text: false on click { task_open = !task_open } ChevronDown { size: 16px } }
                }
            }
            Popover { open: task_open anchor: "task_anchor" width: 300px on dismiss { task_open = false }
                Column { gap: 10.0
                    Text { content: "Start a new task" color: var(--argui-foreground) weight: 600 font_size: 15.0 }
                    Input { value <=> task label: "Task" placeholder: "I need to…" }
                    Button { text: "Start task" enabled: task != "" on click { last_action = "Started: " + task task_open = false task = "" } }
                }
            }
        }

        Column {
            width: 100%
            gap: 9.0
            Row { width: 100% justify_content: "end"
                Text { content: "RTL · إجراءات الرسالة" color: var(--argui-muted-foreground) weight: 600 font_size: 13.0 }
            }
            Row { width: 100% justify_content: "end"
                ButtonGroup { label: "إجراءات الرسالة" width: 330px
                    GroupAction { text: "•••" on click { last_action = "More RTL options" } }
                    GroupSeparator {}
                    GroupAction { text: "تأجيل" on click { last_action = "Snoozed RTL message" } }
                    GroupSeparator {}
                    GroupAction { text: "تقرير" on click { last_action = "Reported RTL message" } }
                    GroupSeparator {}
                    GroupAction { text: "أرشفة" on click { last_action = "Archived RTL message" } }
                }
            }
        }
    }
}
