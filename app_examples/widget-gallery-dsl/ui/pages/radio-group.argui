import { RadioGroup } from "@argui/ui"
import { Column, Text } from "@argui/native"

export component RadioGroupPage {
    private property selected_preset: string = "Maximum quality"

    Column #radio_group_page {
        width: 100%
        gap: 18.0
        Text { content: "Radio group" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Choose a rendering preset. Use the arrow keys to compare the options." color: var(--argui-muted-foreground) font_size: 14.0 }
        Text { content: "Quality preset" color: var(--argui-foreground) weight: 600 font_size: 17.0 }
        RadioGroup {
            label: "Effect quality"
            options: ["Maximum quality", "Balanced", "Performance"]
            value <=> selected_preset
        }
        Text { content: "Selected preset: " + selected_preset color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
