import { Button, Slider } from "@argui/ui"
import { Column, Container, Rectangle, Row, Text } from "@argui/native"

export effect GlassBorder {
    shader: "../../assets/worley-border.wgsl"
    damage: "bounded"
    parameter intensity: float = 0.7
    parameter scale: float = 0.035
}

export component LiquidGlassPage {
    private property blur_amount: float = 18.0
    private property border_effect: bool = true
    private property section: string = "Explore"

    Column {
        width: 100%
        gap: 18.0
        Text { content: "Liquid glass" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Rectangle, Text and other base surfaces can sample pixels already painted behind them." color: var(--argui-muted-foreground) font_size: 14.0 }
        Row {
            wrap: true
            gap: 18.0
            Column {
                gap: 6.0
                Text { content: "Backdrop blur · " + str(blur_amount) + " px" color: var(--argui-foreground) font_size: 13.0 }
                Slider { label: "Backdrop blur" minimum: 0.0 maximum: 36.0 value: blur_amount on changed(next) { blur_amount = next } }
            }
            Button { text: border_effect ? "Disable WGSL border" : "Enable WGSL border" variant: "outline" on click { border_effect = !border_effect } }
        }

        Container {
            width: 720px
            height: 492px
            Rectangle {
                width: 720px
                height: 492px
                radius: 22.0
                clip: true
                background: linear_gradient([#f5b44c, #eb7baf, #7987ed], [0.0, 0.48, 1.0], 24.0, "oklab")
                Column {
                    width: 100%
                    padding: 24.0
                    gap: 22.0
                    Text { content: "CHROMATIC" color: #172b45 weight: 700 font_size: 12.0 }
                    Text { content: section == "Explore" ? "A little more color." : section == "Collections" ? "Made to go together." : "Keep the good ones." color: #172b45 weight: 750 font_size: 29.0 }
                    Text { content: "Fresh palettes for everyday inspiration." color: #172b45 font_size: 14.0 }
                    Row {
                        gap: 14.0
                        Rectangle {
                            width: 200px height: 190px radius: 18.0
                            background: linear_gradient([#ffc875, #fa6b80], [0.0, 1.0], 45.0, "srgb")
                            Column { padding: 20.0 gap: 8.0
                                Text { content: "01  COLOR STUDY" color: #172b45 weight: 700 font_size: 11.0 }
                                Text { content: "Golden hour" color: #172b45 weight: 700 font_size: 21.0 }
                                Text { content: "Warm tones · 12 colors" color: #172b45 font_size: 12.0 }
                            }
                        }
                        Rectangle {
                            width: 200px height: 190px radius: 18.0
                            background: linear_gradient([#63daf3, #747af4], [0.0, 1.0], 45.0, "srgb")
                            Column { padding: 20.0 gap: 8.0
                                Text { content: "02  COLOR STUDY" color: #172b45 weight: 700 font_size: 11.0 }
                                Text { content: "Electric blue" color: #172b45 weight: 700 font_size: 21.0 }
                                Text { content: "Cool tones · 8 colors" color: #172b45 font_size: 12.0 }
                            }
                        }
                        Rectangle {
                            width: 200px height: 190px radius: 18.0
                            background: linear_gradient([#ecc1f6, #a27af0], [0.0, 1.0], 45.0, "srgb")
                            Column { padding: 20.0 gap: 8.0
                                Text { content: "03  COLOR STUDY" color: #172b45 weight: 700 font_size: 11.0 }
                                Text { content: "Orchid garden" color: #172b45 weight: 700 font_size: 21.0 }
                                Text { content: "Pastels · 16 colors" color: #172b45 font_size: 12.0 }
                            }
                        }
                    }
                }
                Row { x: 28px y: 366px
                    Rectangle { width: 72px height: 112px background: solid(#172b45) }
                    Rectangle { width: 72px height: 112px background: solid(#ffe7b8) }
                    Rectangle { width: 72px height: 112px background: solid(#172b45) }
                    Rectangle { width: 72px height: 112px background: solid(#ffe7b8) }
                    Rectangle { width: 72px height: 112px background: solid(#172b45) }
                    Rectangle { width: 72px height: 112px background: solid(#ffe7b8) }
                    Rectangle { width: 72px height: 112px background: solid(#172b45) }
                    Rectangle { width: 72px height: 112px background: solid(#ffe7b8) }
                    Rectangle { width: 72px height: 112px background: solid(#172b45) }
                }
            }

            Rectangle {
                x: 76px
                y: 390px
                width: 568px
                height: 72px
                radius: 24.0
                clip: true
                background: solid(#ffffff47)
                backdrop_filter: "blur(" + str(blur_amount) + "px)"
                border_color: #ffffffb2
                border_width: 2.0
                effect: GlassBorder { scope: "border" intensity: border_effect ? 0.85 : 0.0 scale: 0.035 }
                Row {
                    padding: 12.0
                    gap: 8.0
                    Button { text: "Explore" variant: section == "Explore" ? "secondary" : "ghost" on click { section = "Explore" } }
                    Button { text: "Collections" variant: section == "Collections" ? "secondary" : "ghost" on click { section = "Collections" } }
                    Button { text: "Saved" variant: section == "Saved" ? "secondary" : "ghost" on click { section = "Saved" } }
                }
            }
        }
        Container { width: 720px height: 82px
            Row { height: 82px
                Rectangle { width: 144px height: 82px background: solid(#172b45) }
                Rectangle { width: 144px height: 82px background: solid(#f8cb63) }
                Rectangle { width: 144px height: 82px background: solid(#172b45) }
                Rectangle { width: 144px height: 82px background: solid(#f8cb63) }
                Rectangle { width: 144px height: 82px background: solid(#172b45) }
            }
            Text {
                x: 160px y: 15px width: 400px height: 52px
                content: "Text backdrop blur · " + str(blur_amount) + " px"
                color: #172b45
                font_size: 20.0
                weight: 700
                background: #ffffff52
                backdrop_filter: "blur(" + str(blur_amount) + "px)"
            }
        }
    }
}
