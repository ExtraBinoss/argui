import { ReorderItem } from "@argui/ui"
import { Column, Text } from "@argui/native"

export component DragDropPage {
    private property first: int = 0
    private property second: int = 1
    private property third: int = 2
    private property fourth: int = 3
    private property temporary: int = 0
    private property moves: int = 0

    Column #drag_drop_page {
        width: 100%
        gap: 14.0

        Text { content: "Drag and drop" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Reorder the sequence with Up, Down, or the arrow keys. Pointer dragging requires the native gesture API." color: var(--argui-muted-foreground) font_size: 14.0 }

        Column { width: 100% gap: 10.0
            for position in [0, 1, 2, 3] key position {
                ReorderItem {
                    position: position
                    first: position == 0
                    last: position == 3
                    title: (position == 0 ? first : position == 1 ? second : position == 2 ? third : fourth) == 0 ? "Opening titles" : (position == 0 ? first : position == 1 ? second : position == 2 ? third : fourth) == 1 ? "Product close-up" : (position == 0 ? first : position == 1 ? second : position == 2 ? third : fourth) == 2 ? "Customer story" : "Final call to action"
                    detail: (position == 0 ? first : position == 1 ? second : position == 2 ? third : fourth) == 0 ? "00:00 · 5 seconds" : (position == 0 ? first : position == 1 ? second : position == 2 ? third : fourth) == 1 ? "00:05 · 7 seconds" : (position == 0 ? first : position == 1 ? second : position == 2 ? third : fourth) == 2 ? "00:12 · 9 seconds" : "00:21 · 4 seconds"
                    accent: (position == 0 ? first : position == 1 ? second : position == 2 ? third : fourth) == 0 ? #2563eb : (position == 0 ? first : position == 1 ? second : position == 2 ? third : fourth) == 1 ? #7c3aed : (position == 0 ? first : position == 1 ? second : position == 2 ? third : fourth) == 2 ? #db2777 : #059669
                    on move_up(index) {
                        temporary = index == 1 ? first : index == 2 ? second : third
                        first = index == 1 ? second : first
                        second = index == 1 ? temporary : index == 2 ? third : second
                        third = index == 2 ? temporary : index == 3 ? fourth : third
                        fourth = index == 3 ? temporary : fourth
                        moves = moves + (index > 0 ? 1 : 0)
                    }
                    on move_down(index) {
                        temporary = index == 0 ? first : index == 1 ? second : third
                        first = index == 0 ? second : first
                        second = index == 0 ? temporary : index == 1 ? third : second
                        third = index == 1 ? temporary : index == 2 ? fourth : third
                        fourth = index == 2 ? temporary : fourth
                        moves = moves + (index < 3 ? 1 : 0)
                    }
                }
            }
        }
        Text { content: "Moves: " + str(moves) color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
