import { Column, FocusScope, Rectangle, Row, Text, TouchArea } from "@argui/native"

component FileDisclosure {
    in property title: string
    in property description: string = ""
    in property open: bool = false
    callback toggle()
    slot content

    Column {
        width: 100%
        gap: 8.0
        FocusScope #trigger {
            width: 100%
            role: "button"
            accessible_name: title
            expandable: true
            expanded: open
            keyboard_activation: "enter_or_space"
            on click { toggle() }
            TouchArea #touch {
                mouse_cursor: "pointer"
                Rectangle {
                    width: 100%
                    radius: 7.0
                    background: solid(touch.pressed ? var(--argui-neutral-pressed) : touch.has_hover ? var(--argui-muted) : var(--argui-surface))
                    border_color: trigger.focus_visible ? var(--argui-ring) : var(--argui-border)
                    border_width: trigger.focus_visible ? 2.0 : 1.0
                    Row {
                        width: 100%
                        padding: 12.0
                        gap: 8.0
                        align_items: "center"
                        Column {
                            grow: 1.0
                            Text { content: description == "" ? title : description color: var(--argui-foreground) font_size: 14.0 weight: 600 }
                        }
                        Text { content: open ? "⌄" : "›" color: var(--argui-foreground) font_size: 18.0 weight: 600 }
                    }
                }
            }
        }
        if open {
            Column { width: 100% gap: 8.0 content }
        }
    }
}

export component CollapsiblePage {
    private property project_open: bool = false
    private property archive_open: bool = false

    Column #collapsible_page {
        width: 100%
        gap: 20.0
        Text { content: "Collapsible" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Show and hide content with a button, Enter or Space." color: var(--argui-muted-foreground) font_size: 14.0 }
        Text { content: "A closer look" color: var(--argui-foreground) weight: 600 font_size: 17.0 }
        Text { content: "Expand the project or archive to browse its components." color: var(--argui-muted-foreground) font_size: 13.0 }

        Column {
            width: 100%
            gap: 24.0
            FileDisclosure {
                title: "Project files"
                description: "3 components in this project"
                open: project_open
                on toggle { project_open = !project_open }
                Rectangle { width: 100% border_color: var(--argui-border) border_width: 1.0 radius: 7.0
                    Row { padding: 12.0 Text { content: "components/button.rs" color: var(--argui-foreground) font_size: 14.0 } }
                }
                Rectangle { width: 100% border_color: var(--argui-border) border_width: 1.0 radius: 7.0
                    Row { padding: 12.0 Text { content: "components/card.rs" color: var(--argui-foreground) font_size: 14.0 } }
                }
                Rectangle { width: 100% border_color: var(--argui-border) border_width: 1.0 radius: 7.0
                    Row { padding: 12.0 Text { content: "components/badge.rs" color: var(--argui-foreground) font_size: 14.0 } }
                }
            }
            FileDisclosure {
                title: "Archived files"
                open: archive_open
                on toggle { archive_open = !archive_open }
                Rectangle { width: 100% border_color: var(--argui-border) border_width: 1.0 radius: 7.0
                    Row { padding: 12.0 Text { content: "archive/button-v1.rs" color: var(--argui-foreground) font_size: 14.0 } }
                }
                Rectangle { width: 100% border_color: var(--argui-border) border_width: 1.0 radius: 7.0
                    Row { padding: 12.0 Text { content: "archive/theme-v1.rs" color: var(--argui-foreground) font_size: 14.0 } }
                }
            }
        }
        Text { content: (project_open ? "Project files open" : "Project files closed") + " · " + (archive_open ? "Archive open" : "Archive closed") color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
