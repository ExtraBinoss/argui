import { Button } from "@argui/ui"
import { Column, Rectangle, Text } from "@argui/native"
import { FileAttachment } from "@argui/ui/attachment.argui"

export component AttachmentPage {
    private property references_progress: float = 64.0
    private property notes_state: int = 0
    private property selected_file: string = ""

    Column {
        width: 100%
        gap: 20.0
        Text { content: "Attachment" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "File previews show transfer state, progress and the next available action." color: var(--argui-muted-foreground) font_size: 14.0 }

        Column {
            width: 100%
            gap: 12.0
            FileAttachment {
                filename: "design.fig"
                kind: "FIG"
                status: "Uploaded"
                Button { text: "Details" variant: "outline" on click { selected_file = selected_file == "design.fig" ? "" : "design.fig" } }
            }
            FileAttachment {
                filename: "references.zip"
                kind: "ZIP"
                status: references_progress >= 100.0 ? "Uploaded" : "Uploading · " + str(references_progress) + "%"
                progress: references_progress
                busy: references_progress < 100.0
                if references_progress < 100.0 {
                    Button { text: "Advance" variant: "outline" on click { references_progress = references_progress >= 89.0 ? 100.0 : references_progress + 25.0 } }
                }
                if references_progress >= 100.0 {
                    Button { text: "Details" variant: "outline" on click { selected_file = selected_file == "references.zip" ? "" : "references.zip" } }
                }
            }
            FileAttachment {
                filename: "notes.pdf"
                kind: "PDF"
                status: notes_state == 0 ? "Transfer failed" : notes_state == 1 ? "Uploading · 50%" : "Uploaded"
                progress: 50.0
                error: notes_state == 0
                busy: notes_state == 1
                if notes_state < 2 {
                    Button { text: notes_state == 0 ? "Retry" : "Complete" variant: "outline" on click { notes_state = notes_state + 1 } }
                }
                if notes_state == 2 {
                    Button { text: "Details" variant: "outline" on click { selected_file = selected_file == "notes.pdf" ? "" : "notes.pdf" } }
                }
            }
        }

        if selected_file != "" {
            Rectangle {
                width: 100%
                background: solid(var(--argui-muted))
                radius: 9.0
                Column {
                    padding: 14.0
                    gap: 5.0
                    Text { content: selected_file color: var(--argui-foreground) weight: 600 font_size: 14.0 }
                    Text { content: "Transfer complete · Available in this project" color: var(--argui-muted-foreground) font_size: 13.0 }
                }
            }
        }
    }
}
