                    Text { content: "Minimum · ffi fl · AVATAR · 0123456789" color: #f8fafc font_size: 12.0 line_height: 18.0 }
                    Text { content: "Crème brûlée · naïve · coöperate" color: #f8fafc font_size: 14.0 line_height: 21.0 }
