import { Button } from "@argui/ui"
import { AnimatedText } from "@argui/ui/animated-text.argui"
import { Column, Container, Row, Text } from "@argui/native"

export component AnimatedTextPage {
    private property value: int = 10
    private property first_value: string = "10"
    private property second_value: string = "10"
    private property show_second: bool = false
    private property saved: bool = false
    private property first_status: string = "Draft"
    private property second_status: string = "Draft"
    private property show_second_status: bool = false

    Column {
        width: 100%
        gap: 22.0
        Text { content: "Animated text" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Compare roll, slide and fade while changing the same value." color: var(--argui-muted-foreground) font_size: 14.0 }

        Row { wrap: true gap: 14.0
            Container { width: 190px padding: 15.0 background: var(--argui-surface) border_color: var(--argui-border) radius: 11.0
                Column { gap: 9.0 Text { content: "Roll" color: var(--argui-muted-foreground) font_size: 13.0 } AnimatedText { first: first_value second: second_value show_second: show_second mode: "roll" } }
            }
            Container { width: 190px padding: 15.0 background: var(--argui-surface) border_color: var(--argui-border) radius: 11.0
                Column { gap: 9.0 Text { content: "Slide" color: var(--argui-muted-foreground) font_size: 13.0 } AnimatedText { first: first_value second: second_value show_second: show_second mode: "slide" } }
            }
            Container { width: 190px padding: 15.0 background: var(--argui-surface) border_color: var(--argui-border) radius: 11.0
                Column { gap: 9.0 Text { content: "Fade" color: var(--argui-muted-foreground) font_size: 13.0 } AnimatedText { first: first_value second: second_value show_second: show_second mode: "fade" } }
            }
        }

        Row { wrap: true gap: 8.0
            Button { text: "−1" variant: "outline" on click {
                value = value > 0 ? value - 1 : 0
                first_value = show_second ? str(value) : first_value
                second_value = show_second ? second_value : str(value)
                show_second = !show_second
            } }
            Button { text: "+1" on click {
                value = value + 1
                first_value = show_second ? str(value) : first_value
                second_value = show_second ? second_value : str(value)
                show_second = !show_second
            } }
            Button { text: "99 / 100" variant: "outline" on click {
                value = value == 99 ? 100 : 99
                first_value = show_second ? str(value) : first_value
                second_value = show_second ? second_value : str(value)
                show_second = !show_second
            } }
            Button { text: "Reset to 10" variant: "ghost" on click {
                value = 10
                first_value = show_second ? str(value) : first_value
                second_value = show_second ? second_value : str(value)
                show_second = !show_second
            } }
        }

        Row { wrap: true gap: 12.0 align_items: "center"
            Button { text: "Toggle saved status" variant: "outline" on click {
                saved = !saved
                first_status = show_second_status ? (saved ? "Saved" : "Draft") : first_status
                second_status = show_second_status ? second_status : (saved ? "Saved" : "Draft")
                show_second_status = !show_second_status
            } }
            AnimatedText { first: first_status second: second_status show_second: show_second_status mode: "fade" font_size: 24.0 width: 110px height: 40px }
        }
    }
}
