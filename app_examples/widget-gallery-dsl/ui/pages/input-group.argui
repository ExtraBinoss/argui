import { InputGroup } from "@argui/ui"
import { Column, Text } from "@argui/native"

export component InputGroupPage {
    private property domain: string = ""
    private property preview: string = ""

    Column #input_group_page {
        width: 100%
        gap: 18.0
        Text { content: "Input group" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "A prefix, editable domain, and action share one input surface." color: var(--argui-muted-foreground) font_size: 14.0 }
        Text { content: "Website" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
        InputGroup {
            label: "Domain"
            leading_text: "https://"
            placeholder: "example.com"
            action_text: "Preview"
            value <=> domain
            on action(next) { preview = "Preview: https://" + next }
        }
        Text { content: preview == "" ? "Enter a domain and choose Preview." : preview color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
