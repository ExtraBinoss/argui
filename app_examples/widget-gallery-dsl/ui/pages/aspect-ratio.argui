import { Column, Rectangle, Row, Text } from "@argui/native"

export component AspectRatioPage {
    Column #aspect_ratio_page {
        width: 100%
        gap: 20.0

        Text { content: "Aspect ratio" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Keep content at a consistent width-to-height ratio." color: var(--argui-muted-foreground) font_size: 14.0 }
        Text { content: "Consistent proportions" color: var(--argui-foreground) weight: 600 font_size: 17.0 }

        Rectangle {
            width: 480px
            height: 270px
            background: solid(var(--argui-muted))
            radius: 12.0
            clip: true
            Row {
                width: 100%
                height: 100%
                align_items: "center"
                justify_content: "center"
                Text { content: "16 : 9 preview" color: var(--argui-foreground) weight: 600 font_size: 20.0 }
            }
        }

        Row {
            wrap: true
            gap: 16.0
            Column {
                gap: 8.0
                Rectangle {
                    width: 144px
                    height: 144px
                    radius: 10.0
                    background: solid(var(--argui-muted))
                    Row { width: 100% height: 100% align_items: "center" justify_content: "center"
                        Text { content: "1 : 1" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
                    }
                }
                Text { content: "Square" color: var(--argui-muted-foreground) font_size: 13.0 }
            }
            Column {
                gap: 8.0
                Rectangle {
                    width: 144px
                    height: 108px
                    radius: 10.0
                    background: solid(var(--argui-muted))
                    Row { width: 100% height: 100% align_items: "center" justify_content: "center"
                        Text { content: "4 : 3" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
                    }
                }
                Text { content: "Photo" color: var(--argui-muted-foreground) font_size: 13.0 }
            }
            Column {
                gap: 8.0
                Rectangle {
                    width: 144px
                    height: 81px
                    radius: 10.0
                    background: solid(var(--argui-muted))
                    Row { width: 100% height: 100% align_items: "center" justify_content: "center"
                        Text { content: "16 : 9" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
                    }
                }
                Text { content: "Video" color: var(--argui-muted-foreground) font_size: 13.0 }
            }
        }
    }
}
