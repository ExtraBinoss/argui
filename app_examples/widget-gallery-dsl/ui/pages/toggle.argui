import { Toggle } from "@argui/ui"
import { Column, Text } from "@argui/native"

export component TogglePage {
    private property bold: bool = false

    Column #toggle_page {
        width: 100%
        gap: 18.0

        Text { content: "Toggle" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Press a button to keep a formatting option active." color: var(--argui-muted-foreground) font_size: 14.0 }
        Toggle { label: "Bold" pressed <=> bold }
        Text { content: bold ? "Bold enabled" : "Bold disabled" color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
