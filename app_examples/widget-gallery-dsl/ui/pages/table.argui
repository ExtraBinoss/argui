import { DataTable, DataTableRow } from "@argui/ui"
import { Column, FocusScope, Row, Text } from "@argui/native"

component ItemRow {
    in property name: string
    in property value: string
    in property selected: bool = false
    callback select()

    DataTableRow {
        label: name
        selected: selected
        on select { select() }
        Text { content: name width: 180px color: var(--argui-foreground) font_size: 14.0 }
        Text { content: value width: 120px color: var(--argui-foreground) font_size: 14.0 }
    }
}

export component TablePage {
    private property item1: bool = false
    private property item2: bool = false
    private property item3: bool = false
    private property item4: bool = false
    private property item5: bool = false
    private property item6: bool = false
    private property item7: bool = false
    private property item8: bool = false

    Column #table_page {
        width: 100%
        gap: 18.0
        Text { content: "Table" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Click a row to toggle its selection. Use Tab and Enter or Space for keyboard access." color: var(--argui-muted-foreground) font_size: 14.0 }

        DataTable { label: "Items" width: 340px
            FocusScope {
                role: "row"
                focus_on_tab_navigation: false
                focus_on_click: false
                Row {
                    width: 100%
                    height: 38px
                    padding: 8.0
                    background: var(--argui-muted)
                    FocusScope { role: "column_header" accessible_name: "Name" focus_on_tab_navigation: false focus_on_click: false
                        Text { content: "Name" width: 180px color: var(--argui-muted-foreground) weight: 600 font_size: 14.0 }
                    }
                    FocusScope { role: "column_header" accessible_name: "Value" focus_on_tab_navigation: false focus_on_click: false
                        Text { content: "Value" width: 120px color: var(--argui-muted-foreground) weight: 600 font_size: 14.0 }
                    }
                }
            }
            ItemRow { name: "Item 1" value: "0" selected: item1 on select { item1 = !item1 } }
            ItemRow { name: "Item 2" value: "10" selected: item2 on select { item2 = !item2 } }
            ItemRow { name: "Item 3" value: "20" selected: item3 on select { item3 = !item3 } }
            ItemRow { name: "Item 4" value: "30" selected: item4 on select { item4 = !item4 } }
            ItemRow { name: "Item 5" value: "40" selected: item5 on select { item5 = !item5 } }
            ItemRow { name: "Item 6" value: "50" selected: item6 on select { item6 = !item6 } }
            ItemRow { name: "Item 7" value: "60" selected: item7 on select { item7 = !item7 } }
            ItemRow { name: "Item 8" value: "70" selected: item8 on select { item8 = !item8 } }
        }
        Text { content: str((item1 ? 1 : 0) + (item2 ? 1 : 0) + (item3 ? 1 : 0) + (item4 ? 1 : 0) + (item5 ? 1 : 0) + (item6 ? 1 : 0) + (item7 ? 1 : 0) + (item8 ? 1 : 0)) + " selected" color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
