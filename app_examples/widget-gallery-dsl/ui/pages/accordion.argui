import { Column, Text } from "@argui/native"
import { AccordionSection } from "@argui/ui/accordion.argui"

export component AccordionPage {
    private property keyboard_open: bool = true
    private property themes_open: bool = false
    private property state_open: bool = false

    Column {
        width: 100%
        gap: 20.0
        Text { content: "Accordion" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Expand related answers independently. Tab reaches headings; Up and Down move between them; Enter or Space toggles one." color: var(--argui-muted-foreground) font_size: 14.0 }

        Column {
            width: 100%
            gap: 10.0
            AccordionSection {
                title: "Can I use the keyboard?"
                open: keyboard_open
                next: true
                on toggle { keyboard_open = !keyboard_open }
                Text { content: "Use Tab to reach a heading, Up and Down to move to an adjacent heading, and Enter or Space to expand it." color: var(--argui-muted-foreground) font_size: 14.0 }
            }
            AccordionSection {
                title: "Does it support dark mode?"
                open: themes_open
                previous: true
                next: true
                on toggle { themes_open = !themes_open }
                Text { content: "Yes. Change the gallery appearance above and the sections adapt to the active theme." color: var(--argui-muted-foreground) font_size: 14.0 }
            }
            AccordionSection {
                title: "Where is the state stored?"
                open: state_open
                previous: true
                on toggle { state_open = !state_open }
                Text { content: "The page holds the open state for each section. Opening one answer leaves the others as they are." color: var(--argui-muted-foreground) font_size: 14.0 }
            }
        }
    }
}
