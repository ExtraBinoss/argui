import { Button, Menu, MenuItem, Select, Combobox } from "@argui/ui"
import { Column, Container, Text } from "@argui/native"

export component SelectionPage {
    private property menu_open: bool = false
    private property menu_choice: string = "None"
    private property selected_color: string = "Blue"
    private property search_value: string = ""

    Column {
        width: 100%
        gap: 18.0
        Text { content: "Menu and selection" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Choose by pointer or keyboard; type into the combobox." color: var(--argui-muted-foreground) font_size: 14.0 }

        Container #menu_anchor {
            width: 180px
            Button { text: "Open menu" on click { menu_open = !menu_open } }
        }
        Menu {
            open <=> menu_open
            anchor: "menu_anchor"
            label: "Actions"
            MenuItem { text: "Copy" on select { menu_choice = "Copy" menu_open = false } }
            MenuItem { text: "Share" on select { menu_choice = "Share" menu_open = false } }
            MenuItem { text: "Delete" on select { menu_choice = "Delete" menu_open = false } }
        }
        Text { content: "Menu choice: " + menu_choice color: var(--argui-muted-foreground) font_size: 13.0 }

        Text { content: "Select" color: var(--argui-foreground) font_size: 15.0 weight: 600 }
        Container #color_select {
            width: 220px
            Select {
                anchor: "color_select"
                label: "Color"
                value <=> selected_color
                options: ["Blue", "Violet", "Emerald"]
            }
        }
        Text { content: "Selected color: " + selected_color color: var(--argui-muted-foreground) font_size: 13.0 }

        Text { content: "Combobox" color: var(--argui-foreground) font_size: 15.0 weight: 600 }
        Container #fruit_combo {
            width: 220px
            Combobox {
                anchor: "fruit_combo"
                label: "Fruit"
                value <=> search_value
                options: ["Apple", "Apricot", "Banana", "Cherry"]
            }
        }
        Text { content: "Fruit: " + search_value color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
