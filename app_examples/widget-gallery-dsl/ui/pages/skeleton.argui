import { Avatar, Button, Card, Skeleton } from "@argui/ui"
import { Column, FocusScope, Rectangle, Row, Text } from "@argui/native"

export component SkeletonPage {
    private property loaded: bool = false

    Column #skeleton_page {
        width: 100%
        gap: 20.0
        Text { content: "Skeleton" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Preview the loading state, then reveal the finished content." color: var(--argui-muted-foreground) font_size: 14.0 }
        Text { content: "Leave room for what comes next" color: var(--argui-foreground) weight: 600 font_size: 17.0 }

        FocusScope {
            role: "group"
            accessible_name: loaded ? "Article preview" : "Loading article"
            busy: !loaded
            focus_on_tab_navigation: false
            focus_on_click: false
            Card {
                Column {
                    width: 100%
                    gap: 20.0
                    if !loaded {
                        Skeleton { width: 420px height: 160px }
                        Row {
                            width: 100%
                            gap: 14.0
                            align_items: "center"
                            Skeleton { width: 44px height: 44px radius: 22.0 }
                            Column {
                                width: 65%
                                grow: 1.0
                                gap: 10.0
                                Skeleton { width: 300px height: 18px }
                                Skeleton { width: 220px height: 14px }
                            }
                        }
                    }
                    if loaded {
                        Rectangle {
                            width: 100%
                            height: 160px
                            background: solid(var(--argui-muted))
                            radius: 6.0
                            Column {
                                padding: 24.0
                                gap: 10.0
                                Text { content: "A place for your next idea." color: var(--argui-foreground) font_size: 26.0 weight: 600 }
                                Text { content: "A few thoughtful details make all the difference." color: var(--argui-muted-foreground) font_size: 14.0 }
                            }
                        }
                        Row {
                            gap: 14.0
                            align_items: "center"
                            Avatar { name: "Ada Lovelace" initials: "AL" size: 44.0 }
                            Column {
                                gap: 6.0
                                Text { content: "Designing something new" color: var(--argui-foreground) weight: 600 font_size: 15.0 }
                                Text { content: "Ada Lovelace · 5 min read" color: var(--argui-muted-foreground) font_size: 13.0 }
                            }
                        }
                    }
                }
            }
        }
        Button { text: loaded ? "Show loading" : "Show content" variant: "outline" on click { loaded = !loaded } }
    }
}
