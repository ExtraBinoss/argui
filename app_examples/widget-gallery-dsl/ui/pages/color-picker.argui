import { Button } from "@argui/ui"
import { ColorPicker } from "@argui/ui/color-picker.argui"
import { Column, FocusScope, Rectangle, Row, Text, TouchArea } from "@argui/native"

export component ColorPickerPage {
    private property hue: float = 257.0
    private property saturation: float = 0.74
    private property value: float = 0.95
    private property opacity: float = 80.0
    private property format: string = "HEX"
    private property enabled: bool = true
    private property preview_clicks: int = 0
    private property preview_color: color = hsv(hue, saturation, value, opacity / 100.0)

    Column {
        width: 100%
        gap: 18.0
        Text { content: "Color picker" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Drag on the pad to choose any color, then adjust hue and opacity." color: var(--argui-muted-foreground) font_size: 14.0 }

        Row { gap: 30.0 wrap: true
            ColorPicker { label: "Accent color" hue <=> hue saturation <=> saturation value <=> value opacity <=> opacity format <=> format enabled: enabled }
            Column { gap: 14.0
                Text { content: "Live preview" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
                Rectangle { width: 180px height: 100px radius: 12.0 background: solid(preview_color) }
                FocusScope #preview_button {
                    role: "button"
                    accessible_name: "Live button preview"
                    keyboard_activation: "enter_or_space"
                    on click { preview_clicks = preview_clicks + 1 }
                    TouchArea #preview_touch {
                        mouse_cursor: "pointer"
                        Rectangle {
                            background: solid(preview_color)
                            border_color: preview_button.focus_visible ? var(--argui-ring) : preview_color
                            border_width: preview_button.focus_visible ? 2.0 : 0.0
                            radius: 8.0
                            Row { padding: 12.0
                                Text { content: "Live button preview" color: #ffffff weight: 600 font_size: 14.0 }
                            }
                        }
                    }
                }
                Text { content: "Preview clicks: " + str(preview_clicks) color: var(--argui-muted-foreground) font_size: 12.0 }
                Button { text: enabled ? "Disable editor" : "Enable editor" variant: "outline" on click { enabled = !enabled } }
            }
        }
    }
}
