import { Menu, MenuItem, Separator, SubMenu } from "@argui/ui"
import { ContextMenuTrigger } from "@argui/ui/context-menu.argui"
import { Column, Container, Text } from "@argui/native"

export component ContextMenuPage {
    private property menu_open: bool = false
    private property menu_x: length = 0px
    private property menu_y: length = 0px
    private property layout_open: bool = false
    private property show_details: bool = true
    private property compact: bool = false
    private property note_count: int = 1
    private property status: string = "Open the note actions menu."

    Column {
        width: 100%
        gap: 20.0
        Text { content: "Context menu" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Open actions by click, right click, Shift+F10 or the context-menu key. Escape dismisses the menu." color: var(--argui-muted-foreground) font_size: 14.0 }

        Container #note_anchor {
            ContextMenuTrigger {
                open <=> menu_open
                pointer_x <=> menu_x
                pointer_y <=> menu_y
                label: "Project note actions"
                Container {
                width: 360px
                height: 150px
                padding: 18.0
                background: var(--argui-surface)
                border_color: var(--argui-border)
                radius: 10.0
                Column {
                    width: 100%
                    gap: 8.0
                    Text { content: "Project notes" color: var(--argui-foreground) weight: 700 font_size: 17.0 }
                    Text { content: "Click or use the keyboard to open note actions." color: var(--argui-muted-foreground) font_size: 13.0 }
                    Text { content: str(note_count) + " note(s)" color: var(--argui-primary) weight: 600 font_size: 13.0 }
                }
                }
            }
            Container #note_pointer_anchor { x: menu_x y: menu_y width: 1px height: 1px }
        }
        Menu { open: menu_open anchor: "note_pointer_anchor" label: "Project note actions" width: 230px on dismiss { menu_open = false layout_open = false }
            MenuItem { text: "New note" enabled: note_count < 8 on select { note_count = note_count + 1 status = "Added note " + str(note_count) menu_open = false } }
            MenuItem { text: "Duplicate last note" enabled: note_count < 8 on select { note_count = note_count + 1 status = "Duplicated note " + str(note_count - 1) menu_open = false } }
            Separator {}
            MenuItem { text: "Reset notebook" on select { note_count = 1 status = "Notebook reset to one note" menu_open = false } }
            Separator {}
            MenuItem { text: show_details ? "✓ Show details" : "Show details" on select { show_details = !show_details menu_open = false status = show_details ? "Details shown" : "Details hidden" } }
            Container #layout_anchor {
                SubMenu {
                    anchor: "layout_anchor"
                    text: "Layout"
                    parent_open: menu_open
                    open: layout_open
                    on activate { layout_open = true }
                    on hover { layout_open = true }
                    on dismiss { layout_open = false }
                    MenuItem { text: compact ? "Comfortable" : "✓ Comfortable" on select { compact = false layout_open = false menu_open = false status = "Comfortable layout" } }
                    MenuItem { text: compact ? "✓ Compact" : "Compact" on select { compact = true layout_open = false menu_open = false status = "Compact layout" } }
                }
            }
        }

        Text { content: status color: var(--argui-muted-foreground) font_size: 13.0 }
        Column { width: 100% gap: 8.0
            for note in ["1", "2", "3", "4", "5", "6", "7", "8"] key note {
                if note_count >= 1 && note == "1" || note_count >= 2 && note == "2" || note_count >= 3 && note == "3" || note_count >= 4 && note == "4" || note_count >= 5 && note == "5" || note_count >= 6 && note == "6" || note_count >= 7 && note == "7" || note_count >= 8 && note == "8" {
                    Container {
                        width: 360px
                        padding: compact ? 8.0 : 16.0
                        background: var(--argui-surface)
                        border_color: var(--argui-border)
                        radius: 8.0
                        Column { gap: 4.0
                            Text { content: "Project note " + note color: var(--argui-foreground) weight: 600 font_size: 14.0 }
                            if show_details { Text { content: "Design review · Draft" color: var(--argui-muted-foreground) font_size: 12.0 } }
                        }
                    }
                }
            }
        }
    }
}
