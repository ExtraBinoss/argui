import { Avatar } from "@argui/ui"
import { Column, Row, Text } from "@argui/native"

export component AvatarPage {
    Column #avatar_page {
        width: 100%
        gap: 20.0

        Text { content: "Avatar" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "People and teams use a portrait or initials when a photo is unavailable." color: var(--argui-muted-foreground) font_size: 14.0 }

        Row {
            gap: 16.0
            align_items: "center"
            Avatar { name: "Argui workspace" initials: "AR" size: 64.0 portrait: true }
            Column {
                gap: 4.0
                Text { content: "Argui workspace" color: var(--argui-foreground) weight: 600 font_size: 17.0 }
                Text { content: "Design and development" color: var(--argui-muted-foreground) font_size: 14.0 }
            }
        }

        Row {
            wrap: true
            gap: 16.0
            align_items: "center"
            Avatar { name: "Ada Lovelace" initials: "AL" size: 24.0 }
            Avatar { name: "Grace Hopper" initials: "GH" }
            Avatar { name: "Linus Torvalds" initials: "LT" size: 64.0 }
            Avatar { name: "Photo unavailable" initials: "?" }
        }
    }
}
