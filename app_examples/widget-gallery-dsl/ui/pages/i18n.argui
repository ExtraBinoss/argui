import { Button } from "@argui/ui"
import { Column, Rectangle, Row, Text } from "@argui/native"

export component I18nPage {
    private property language: int = 0
    private property notifications: int = 1
    private property save_preview_presses: int = 0

    Column {
        width: 100%
        gap: 18.0
        Text { content: "Internationalization" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Switch this panel's copy between English, French and Arabic, then change the notification count." color: var(--argui-muted-foreground) font_size: 14.0 }
        Text { content: "This panel uses local strings; the gallery has no Fluent catalogs connected to its DSL tr() resolver." color: var(--argui-muted-foreground) font_size: 13.0 }
        Row {
            wrap: true
            gap: 9.0
            Button { text: "English" variant: language == 0 ? "secondary" : "outline" on click { language = 0 } }
            Button { text: "Français" variant: language == 1 ? "secondary" : "outline" on click { language = 1 } }
            Button { text: "العربية" variant: language == 2 ? "secondary" : "outline" on click { language = 2 } }
        }
        Rectangle {
            width: 620px
            radius: 12.0
            background: solid(var(--argui-surface))
            border_color: var(--argui-border)
            border_width: 1.0
            Column {
                width: 100%
                padding: 20.0
                gap: 15.0
                Text { content: language == 0 ? "Welcome, Ada!" : language == 1 ? "Bienvenue, Ada !" : "مرحبًا، Ada!" width: 100% color: var(--argui-foreground) weight: 700 font_size: 24.0 text_align: language == 2 ? "right" : "left" }
                Text {
                    content: language == 0 ? notifications == 1 ? "You have one notification." : "You have " + str(notifications) + " notifications." : language == 1 ? notifications == 1 ? "Vous avez une notification." : "Vous avez " + str(notifications) + " notifications." : notifications == 1 ? "لديك إشعار واحد." : "لديك " + str(notifications) + " إشعارات."
                    width: 100%
                    color: var(--argui-foreground)
                    font_size: 16.0
                    text_align: language == 2 ? "right" : "left"
                }
                Text { content: language == 0 ? "Preview language: English" : language == 1 ? "Langue affichée : français" : "لغة العرض: العربية" width: 100% color: var(--argui-muted-foreground) font_size: 13.0 text_align: language == 2 ? "right" : "left" }
                Row {
                    width: 100%
                    wrap: true
                    gap: 8.0
                    justify_content: language == 2 ? "end" : "start"
                    Button { text: language == 0 ? "Fewer" : language == 1 ? "Moins" : "أقل" variant: "outline" on click { notifications = notifications > 0 ? notifications - 1 : 0 } }
                    Button { text: language == 0 ? "More" : language == 1 ? "Plus" : "أكثر" variant: "outline" on click { notifications = notifications < 99 ? notifications + 1 : 99 } }
                    Button { text: language == 0 ? "Save changes" : language == 1 ? "Enregistrer" : "حفظ التغييرات" on click { save_preview_presses = save_preview_presses + 1 } }
                }
                Text { content: "Localized button label preview · presses: " + str(save_preview_presses) color: var(--argui-muted-foreground) font_size: 12.0 }
                Rectangle {
                    width: 100% radius: 8.0 background: solid(var(--argui-muted))
                    Column { padding: 12.0 gap: 4.0
                        Text { content: "English-only copy preview" color: var(--argui-muted-foreground) weight: 600 font_size: 12.0 }
                        Text { content: "This English-only sentence stays the same in every preview language." color: var(--argui-foreground) font_size: 14.0 }
                    }
                }
            }
        }
    }
}
