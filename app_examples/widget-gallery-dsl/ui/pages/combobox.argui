import { Button, Combobox } from "@argui/ui"
import { Column, Container, Row, Text } from "@argui/native"

export component ComboboxPage {
    private property framework: string = ""
    private property combo_open: bool = false
    private property last_choice: string = "No framework selected"

    Column {
        width: 100%
        gap: 20.0
        Text { content: "Combobox" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Type to narrow the list, or choose a framework from the suggestions." color: var(--argui-muted-foreground) font_size: 14.0 }

        Column {
            gap: 8.0
            Text { content: "Search frameworks" color: var(--argui-foreground) weight: 600 font_size: 14.0 }
            Row {
                wrap: true
                gap: 10.0
                Container #framework_anchor {
                    width: 300px
                    Combobox {
                        anchor: "framework_anchor"
                        label: "Search frameworks"
                        placeholder: "Search frameworks…"
                        width: 300px
                        value <=> framework
                        open <=> combo_open
                        options: ["Next.js", "SvelteKit", "Nuxt.js", "Remix", "Astro"]
                        on changed(value) { last_choice = value == "" ? "No framework selected" : "Selected " + value }
                    }
                }
                Button { text: "Clear" variant: "outline" enabled: framework != "" on click { framework = "" combo_open = false last_choice = "No framework selected" } }
            }
            Text { content: last_choice color: var(--argui-muted-foreground) font_size: 13.0 }
        }

        Column {
            gap: 8.0
            Text { content: "Unavailable" color: var(--argui-foreground) weight: 600 font_size: 14.0 }
            Container #disabled_framework_anchor {
                width: 300px
                Combobox { anchor: "disabled_framework_anchor" label: "Unavailable framework" value: "Archived choice" enabled: false width: 300px }
            }
        }
    }
}
