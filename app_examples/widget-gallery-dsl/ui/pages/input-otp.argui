import { InputOtp } from "@argui/ui"
import { Column, Text } from "@argui/native"

export component InputOtpPage {
    private property code: string = ""
    private property submitted: bool = false

    Column #input_otp_page {
        width: 100%
        gap: 18.0

        Text { content: "Input OTP" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Six separate code cells share one accessible editor." color: var(--argui-muted-foreground) font_size: 14.0 }

        InputOtp {
            value <=> code
            label: "Verification code"
            on submit(value) { code = value submitted = true }
        }
        Text { content: "Enter six digits. You can paste the whole code." color: var(--argui-muted-foreground) font_size: 13.0 }
        Text { content: submitted ? "Code submitted: " + code : code == "" ? "Keep typing" : "Code entered: " + code color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
