import { Slider } from "@argui/ui"
import { FancySlider } from "@argui/ui/fancy-slider.argui"
import { Column, Text } from "@argui/native"

export component SliderPage {
    private property volume: float = 25.0
    private property changes: int = 0
    private property custom_value: float = 62.0

    Column {
        width: 100%
        gap: 18.0
        Text { content: "Slider" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Drag the thumb or tap the track." color: var(--argui-muted-foreground) font_size: 14.0 }
        Text { content: "Volume: " + str(volume) color: var(--argui-foreground) font_size: 15.0 }
        Slider #volume_slider {
            label: "Volume"
            value <=> volume
            on changed(next) { changes = changes + 1 }
        }
        Text { content: "Updates: " + str(changes) color: var(--argui-muted-foreground) font_size: 13.0 }
        Text { content: "Studio slider" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
        Text { content: "Fine ticks, animated hover halo, live value, and keyboard steps." color: var(--argui-muted-foreground) font_size: 13.0 }
        FancySlider { label: "Studio value" value <=> custom_value width: 340px }
        Text { content: "Studio value: " + str(custom_value) color: var(--argui-muted-foreground) font_size: 13.0 }
        Text { content: "Disabled" color: var(--argui-foreground) font_size: 14.0 }
        Slider { label: "Disabled volume" value: 40.0 enabled: false }
    }
}
