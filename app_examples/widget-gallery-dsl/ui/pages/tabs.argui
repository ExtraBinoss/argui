import { Tabs } from "@argui/ui"
import { Column, Text } from "@argui/native"

export component TabsPage {
    private property selected_tab: string = "General"

    Column #tabs_page {
        width: 100%
        gap: 18.0
        Text { content: "Tabs" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Switch categories to explore the available workspace settings." color: var(--argui-muted-foreground) font_size: 14.0 }
        Text { content: "Tabbed settings" color: var(--argui-foreground) weight: 600 font_size: 17.0 }

        Tabs {
            label: "Workspace settings"
            tabs: ["General", "Performance", "Advanced"]
            value <=> selected_tab
            if selected_tab == "General" {
                Text { content: "General rendering preferences" color: var(--argui-muted-foreground) font_size: 14.0 }
            }
            if selected_tab == "Performance" {
                Text { content: "Frame pacing and caches" color: var(--argui-muted-foreground) font_size: 14.0 }
            }
            if selected_tab == "Advanced" {
                Text { content: "Custom WGSL registry" color: var(--argui-muted-foreground) font_size: 14.0 }
            }
        }
        Text { content: "Current tab: " + selected_tab color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
