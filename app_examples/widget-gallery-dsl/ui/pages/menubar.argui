import { Button, Menu, MenuBar, MenuItem, Separator, SubMenu } from "@argui/ui"
import { Column, Container, Row, Text } from "@argui/native"

export component MenubarPage {
    private property active_menu: string = ""
    private property layout_open: bool = false
    private property notes: int = 1
    private property details: bool = true
    private property compact: bool = false
    private property status: string = "Add a note, then try Show details and Layout."

    Column #menubar_page {
        width: 100%
        gap: 18.0
        Text { content: "Menubar" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Use File and View to manage this notebook preview." color: var(--argui-muted-foreground) font_size: 14.0 }

        MenuBar { label: "Menu bar"
            Container #file_anchor { width: 120px
                Button { text: "File" variant: "ghost" select_trigger: true expanded: active_menu == "File"
                    on click { active_menu = active_menu == "File" ? "" : "File" layout_open = false }
                    on hover { active_menu = active_menu == "" ? "" : "File" } }
            }
            Container #view_anchor { width: 120px
                Button { text: "View" variant: "ghost" select_trigger: true expanded: active_menu == "View"
                    on click { active_menu = active_menu == "View" ? "" : "View" }
                    on hover { active_menu = active_menu == "" ? "" : "View" } }
            }
        }
        Menu { open: active_menu == "File" anchor: "file_anchor" label: "File" width: 230px on dismiss { active_menu = "" }
            MenuItem { text: "New note" enabled: notes < 8 on select { notes = notes + 1 status = "Created note " + str(notes) + "." active_menu = "" } }
            MenuItem { text: "Duplicate last note" enabled: notes < 8 on select { notes = notes + 1 status = "Duplicated the last note." active_menu = "" } }
            Separator {}
            MenuItem { text: "Reset notebook" on select { notes = 1 status = "Notebook reset to one note." active_menu = "" } }
        }
        Menu { open: active_menu == "View" anchor: "view_anchor" label: "View" width: 230px on dismiss { active_menu = "" layout_open = false }
            MenuItem { text: "Show details" selected: details on select { details = !details status = details ? "Details visible." : "Details hidden." } }
            Container #layout_anchor {
                SubMenu { anchor: "layout_anchor" text: "Layout" parent_open: active_menu == "View" open: layout_open
                    on activate { layout_open = true } on hover { layout_open = true } on dismiss { layout_open = false }
                    MenuItem { text: "Comfortable" selected: !compact on select { compact = false status = "Comfortable layout." active_menu = "" layout_open = false } }
                    MenuItem { text: "Compact" selected: compact on select { compact = true status = "Compact layout." active_menu = "" layout_open = false } }
                }
            }
        }

        Text { content: status color: var(--argui-muted-foreground) font_size: 13.0 }
        Column {
            width: 100%
            gap: 8.0
            for note in [1, 2, 3, 4, 5, 6, 7, 8] key note {
                if note <= notes {
                    Container { width: 100% padding: 12.0 border_color: var(--argui-border) radius: 8.0
                        Column { gap: compact ? 4.0 : 12.0
                            Text { content: "Project note " + str(note) color: var(--argui-foreground) weight: 600 font_size: 15.0 }
                            if details { Text { content: "Design review · Draft" color: var(--argui-muted-foreground) font_size: 13.0 } }
                        }
                    }
                }
            }
        }
    }
}
