import { Kbd, Separator } from "@argui/ui"
import { Column, Row, Text } from "@argui/native"

component ShortcutRow {
    in property action: string
    in property keys: array<string>
    in property label: string

    Row {
        width: 100%
        gap: 16.0
        align_items: "center"
        justify_content: "space_between"
        Column { grow: 1.0 Text { content: action color: var(--argui-foreground) font_size: 14.0 } }
        Kbd { keys: keys label: label }
    }
}

export component KbdPage {
    Column #kbd_page {
        width: 100%
        gap: 18.0
        Text { content: "Kbd" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Show a key or a complete combination alongside its action." color: var(--argui-muted-foreground) font_size: 14.0 }
        Text { content: "Keyboard shortcuts" color: var(--argui-foreground) weight: 600 font_size: 17.0 }
        Column {
            width: 100%
            gap: 16.0
            ShortcutRow { action: "Search components" keys: ["Ctrl", "K"] label: "Control plus K" }
            Separator {}
            ShortcutRow { action: "Change theme" keys: ["Ctrl", "Shift", "L"] label: "Control plus Shift plus L" }
            ShortcutRow { action: "Confirm" keys: ["Enter"] label: "Enter" }
            ShortcutRow { action: "Dismiss" keys: ["Esc"] label: "Escape" }
            ShortcutRow { action: "On macOS" keys: ["Cmd", "K"] label: "Command plus K" }
        }
    }
}
