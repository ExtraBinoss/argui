import { Button, Input } from "@argui/ui"
import { Column, Row, Text, VirtualWindow } from "@argui/native"

export component AsyncTasksPage {
    in property status: string
    in property results: model<string>
    in property loading: bool
    callback request_search(query: string)
    callback cancel_search()
    private property query: string = ""
    private property offset: float = 0.0

    Column {
        width: 100%
        gap: 18.0
        Text { content: "Async tasks" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Search 10,000 local drafts. New requests cancel old results." color: var(--argui-muted-foreground) font_size: 14.0 }
        Input { value <=> query label: "Draft search" search: true placeholder: "Title or id:500" on submit { request_search(query) } }
        Row { gap: 8.0 wrap: true
            Button { text: "Search" on click { request_search(query) } }
            Button { text: "Cancel" variant: "ghost" enabled: loading on click { cancel_search() } }
        }
        Text { content: status color: var(--argui-muted-foreground) font_size: 13.0 }
        VirtualWindow #task_results {
            width: 100%
            height: 256px
            row_height: 32.0
            overscan: 2
            offset <=> offset
            for row in results key row {
                Text { content: row height: 32px }
            }
        }
    }
}
