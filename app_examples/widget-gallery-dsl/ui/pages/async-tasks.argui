import { Button, Input } from "@argui/ui"
import { Column, Container, Row, Text } from "@argui/native"

export component AsyncTasksPage {
    private property query: string = ""
    private property active_query: string = ""
    private property status: string = "Five local draft titles are ready to search."

    Column {
        width: 100%
        gap: 18.0
        Text { content: "Async tasks" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Search the local draft sample. Search and Cancel update the visible results immediately." color: var(--argui-muted-foreground) font_size: 14.0 }

        Container { width: 100%
            Input { value <=> query label: "Draft search" search: true placeholder: "Title, such as Design" on submit { active_query = query status = query == "" ? "Showing every draft" : "Filtered by: " + query } }
        }
        Row { gap: 8.0 wrap: true
            Button { text: "Search" on click { active_query = query status = query == "" ? "Showing every draft" : "Filtered by: " + query } }
            Button { text: "Cancel" variant: "ghost" enabled: query != "" || active_query != "" on click { query = "" active_query = "" status = "Search cleared" } }
        }
        Text { content: status color: var(--argui-muted-foreground) font_size: 13.0 }

        Column { width: 100% gap: 8.0
            if active_query == "" || contains("Architecture", active_query) {
                Button { text: "Draft 00000 · Architecture" variant: "outline" on click { status = "Opened Architecture" } }
            }
            if active_query == "" || contains("Design review", active_query) {
                Button { text: "Draft 00001 · Design review" variant: "outline" on click { status = "Opened Design review" } }
            }
            if active_query == "" || contains("Release notes", active_query) {
                Button { text: "Draft 00002 · Release notes" variant: "outline" on click { status = "Opened Release notes" } }
            }
            if active_query == "" || contains("Meeting agenda", active_query) {
                Button { text: "Draft 00003 · Meeting agenda" variant: "outline" on click { status = "Opened Meeting agenda" } }
            }
            if active_query == "" || contains("Travel plans", active_query) {
                Button { text: "Draft 00004 · Travel plans" variant: "outline" on click { status = "Opened Travel plans" } }
            }
            if active_query != "" && !contains("Architecture", active_query) && !contains("Design review", active_query) && !contains("Release notes", active_query) && !contains("Meeting agenda", active_query) && !contains("Travel plans", active_query) {
                Text { content: "No matching drafts in the local sample." color: var(--argui-muted-foreground) font_size: 14.0 }
            }
        }
    }
}
