import { Button } from "@argui/ui"
import { Column, Container, Rectangle, Row, Text } from "@argui/native"

component MotionCard {
    in property title: string
    in property detail: string
    slot art

    Column {
        width: 260px
        min_width: 220.0
        grow: 1.0
        gap: 10.0
        padding: 14.0
        background: var(--argui-surface)
        border_color: var(--argui-border)
        radius: 12.0
        Text { content: title color: var(--argui-foreground) weight: 650 font_size: 15.0 }
        Text { content: detail color: var(--argui-muted-foreground) font_size: 12.0 }
        Rectangle {
            width: 100%
            height: 104px
            background: solid(var(--argui-muted))
            radius: 9.0
            clip: true
            art
        }
    }
}

export component AnimationLabPage {
    private property expanded: bool = false
    private property playing: bool = true
    private property sweep: float = 0.0
    private property turn: float = 0.0
    private property pulse: float = 0.0
    private property hold: float = 0.0

    animate sweep { from: 0.0 to: 1.0 duration: 2600ms iterations: "infinite" }
    animate turn { duration: 2400ms iterations: "infinite" keyframes { 0%: 0.0 50%: 180.0 100%: 360.0 } }
    animate pulse { duration: 1600ms iterations: "infinite" keyframes { 0%: 0.0 50%: 1.0 100%: 0.0 } }
    animate hold { duration: 2000ms iterations: "infinite" keyframes { 0%: 0.0 40%: 0.0 41%: 1.0 90%: 1.0 91%: 0.0 100%: 0.0 } }

    Column {
        width: 100%
        gap: 20.0
        Text { content: "Animation lab" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Generic rectangles, text and layout primitives animated directly in DSL." color: var(--argui-muted-foreground) font_size: 14.0 }
        Row {
            wrap: true
            gap: 10.0
            Button { text: expanded ? "Use compact target" : "Change target" variant: "outline" on click { expanded = !expanded } }
            Button { text: playing ? "Hide looping motion" : "Show looping motion" variant: "outline" on click { playing = !playing } }
            Text { content: expanded ? "The transition retargeted each surface." : "Choose another target to see the transition." color: var(--argui-muted-foreground) font_size: 12.0 }
        }

        Text { content: "Implicit transitions" color: var(--argui-foreground) weight: 700 font_size: 19.0 }
        Text { content: "Change the target above; presented values interpolate without per-frame handlers." color: var(--argui-muted-foreground) font_size: 13.0 }
        Row {
            width: 100%
            wrap: true
            gap: 12.0
            MotionCard { title: "Opacity" detail: "Fade a whole surface"
                Rectangle { x: 80px y: 22px width: 72px height: 60px radius: 15.0 background: solid(var(--argui-primary)) opacity: 1.0 states { changed when expanded { opacity: 0.25 } } animate opacity { transition: in-out duration: 420ms } }
            }
            MotionCard { title: "Size" detail: "Layout width retargets"
                Rectangle { x: 18px y: 26px width: 74px height: 52px radius: 14.0 background: solid(var(--argui-primary)) states { changed when expanded { width: 174px } } animate width { transition: in-out duration: 520ms } }
            }
            MotionCard { title: "Rounded corners" detail: "Shape remains one primitive"
                Rectangle { x: 82px y: 20px width: 68px height: 68px radius: 7.0 background: solid(var(--argui-primary)) states { changed when expanded { radius: 34.0 } } animate radius { transition: in-out duration: 380ms } }
            }
            MotionCard { title: "Rotation" detail: "Compositor transform"
                Rectangle { x: 89px y: 24px width: 58px height: 58px radius: 11.0 background: solid(var(--argui-primary)) rotation: 0.0 states { changed when expanded { rotation: 135.0 } } animate rotation { transition: in-out duration: 520ms } }
            }
            MotionCard { title: "Layout gap" detail: "Spacing retargets with the layout"
                Row { x: 28px y: 37px gap: 5.0 states { changed when expanded { gap: 24.0 } } animate gap { transition: in-out duration: 480ms }
                    Rectangle { width: 28px height: 28px radius: 6.0 background: solid(var(--argui-primary)) }
                    Rectangle { width: 28px height: 28px radius: 6.0 background: solid(var(--argui-ring)) }
                    Rectangle { width: 28px height: 28px radius: 6.0 background: solid(var(--argui-primary)) }
                }
            }
            MotionCard { title: "Text color" detail: "Color is a typed animation value"
                Text { x: 43px y: 38px content: "Argui" color: var(--argui-primary) font_size: 24.0 weight: 700 states { changed when expanded { color: var(--argui-destructive) } } animate color { transition: in-out duration: 500ms } }
            }
        }

        Text { content: "Timeline and keyframes" color: var(--argui-foreground) weight: 700 font_size: 19.0 }
        Text { content: "Looping properties drive several surfaces from one clock." color: var(--argui-muted-foreground) font_size: 13.0 }
        Row {
            width: 100%
            wrap: true
            gap: 12.0
            MotionCard { title: "Travel" detail: "A position follows a timeline"
                Rectangle { x: playing ? 16px + sweep * 164px : 16px y: 28px width: 46px height: 46px radius: 13.0 background: solid(var(--argui-primary)) }
            }
            MotionCard { title: "Keyframe spin" detail: "Three authored keyframes"
                Rectangle { x: 92px y: 24px width: 56px height: 56px radius: 12.0 background: solid(var(--argui-primary)) rotation: playing ? turn : 0.0 }
            }
            MotionCard { title: "Pulse" detail: "Opacity and size share a phase"
                Rectangle { x: 82px y: 22px width: playing ? 52px + pulse * 26px : 52px height: playing ? 52px + pulse * 26px : 52px radius: 100.0 background: solid(var(--argui-primary)) opacity: playing ? 0.45 + pulse * 0.55 : 0.7 }
            }
            MotionCard { title: "Five steps" detail: "Discrete progress indicators"
                Row { x: 24px y: 37px gap: 8.0
                    Rectangle { width: 28px height: 28px radius: 7.0 background: solid(playing && sweep > 0.1 ? var(--argui-primary) : var(--argui-border)) }
                    Rectangle { width: 28px height: 28px radius: 7.0 background: solid(playing && sweep > 0.3 ? var(--argui-primary) : var(--argui-border)) }
                    Rectangle { width: 28px height: 28px radius: 7.0 background: solid(playing && sweep > 0.5 ? var(--argui-primary) : var(--argui-border)) }
                    Rectangle { width: 28px height: 28px radius: 7.0 background: solid(playing && sweep > 0.7 ? var(--argui-primary) : var(--argui-border)) }
                    Rectangle { width: 28px height: 28px radius: 7.0 background: solid(playing && sweep > 0.9 ? var(--argui-primary) : var(--argui-border)) }
                }
            }
        }

        Text { content: "Composition" color: var(--argui-foreground) weight: 700 font_size: 19.0 }
        Text { content: "Multiple primitive properties can respond to the same state or animation." color: var(--argui-muted-foreground) font_size: 13.0 }
        Row {
            width: 100%
            wrap: true
            gap: 12.0
            MotionCard { title: "Opposing tracks" detail: "Two elements, one timeline"
                Rectangle { x: playing ? 12px + sweep * 145px : 12px y: 20px width: 42px height: 26px radius: 9.0 background: solid(var(--argui-primary)) }
                Rectangle { x: playing ? 157px - sweep * 145px : 157px y: 58px width: 42px height: 26px radius: 9.0 background: solid(var(--argui-ring)) }
            }
            MotionCard { title: "Color sequence" detail: "Theme colors change by phase"
                Rectangle { x: 76px y: 18px width: 78px height: 68px radius: 18.0 background: solid(playing && sweep > 0.66 ? var(--argui-ring) : playing && sweep > 0.33 ? var(--argui-primary-hover) : var(--argui-primary)) }
            }
            MotionCard { title: "Stagger" detail: "Five offsets from one value"
                Row { x: 31px y: 48px gap: 10.0
                    Rectangle { y: 0px width: 24px height: 24px radius: 12.0 background: solid(var(--argui-primary)) states { lifted when playing && sweep > 0.1 { y: -20px } } animate y { transition: in-out duration: 180ms } }
                    Rectangle { y: 0px width: 24px height: 24px radius: 12.0 background: solid(var(--argui-primary)) states { lifted when playing && sweep > 0.25 { y: -20px } } animate y { transition: in-out duration: 180ms } }
                    Rectangle { y: 0px width: 24px height: 24px radius: 12.0 background: solid(var(--argui-primary)) states { lifted when playing && sweep > 0.4 { y: -20px } } animate y { transition: in-out duration: 180ms } }
                    Rectangle { y: 0px width: 24px height: 24px radius: 12.0 background: solid(var(--argui-primary)) states { lifted when playing && sweep > 0.55 { y: -20px } } animate y { transition: in-out duration: 180ms } }
                    Rectangle { y: 0px width: 24px height: 24px radius: 12.0 background: solid(var(--argui-primary)) states { lifted when playing && sweep > 0.7 { y: -20px } } animate y { transition: in-out duration: 180ms } }
                }
            }
            MotionCard { title: "Retargeting" detail: "Click Change target repeatedly"
                Rectangle { x: 18px y: 28px width: 48px height: 48px radius: 12.0 background: solid(var(--argui-primary)) states { changed when expanded { x: 158px } } animate x { transition: in-out duration: 700ms } }
            }
        }

        Text { content: "Physics and timing" color: var(--argui-foreground) weight: 700 font_size: 19.0 }
        Text { content: "DSL spring transitions and held keyframes cover two more motion patterns. Native inertia, additive tracks and custom curves require the Rust animation API." color: var(--argui-muted-foreground) font_size: 13.0 }
        Row { width: 100% wrap: true gap: 12.0
            MotionCard { title: "Spring retarget" detail: "Target changes with spring damping"
                Rectangle { x: 87px y: 24px width: 58px height: 58px radius: 12.0 background: solid(var(--argui-primary)) rotation: 0.0 states { changed when expanded { rotation: 130.0 } } animate rotation { transition: in-out spring { stiffness: 220 damping: 24 } } }
            }
            MotionCard { title: "Held keyframes" detail: "A value waits before it changes"
                Rectangle { x: playing && hold > 0.5 ? 151px : 22px y: 28px width: 47px height: 47px radius: 12.0 background: solid(var(--argui-primary)) }
            }
        }
    }
}
