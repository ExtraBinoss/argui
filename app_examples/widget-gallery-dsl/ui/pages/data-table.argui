import { Button } from "@argui/ui"
import { DataTable, DataTableRow } from "@argui/ui/data-table.argui"
import { DataTableResizeHandle } from "@argui/ui/data-table-resize-handle.argui"
import { ArrowDown, ArrowUp, ArrowsSort, Minus, Plus } from "@argui/icons"
import { Column, Container, Flickable, Row, Text } from "@argui/native"

component TaskTableRow {
    in property title: string
    in property owner: string
    in property status: string
    in property initial_hours: int
    in property selected: bool = false
    in property task_width: float = 270.0
    in property status_width: float = 135.0
    in property owner_width: float = 170.0
    in property hours_width: float = 105.0
    callback select()
    private property hours: int = initial_hours

    DataTableRow {
        label: title + ", " + owner + ", " + status
        selected: selected
        on select { select() }
        Container { width: task_width * 1px padding: 11.0
            Text { content: title color: var(--argui-foreground) weight: 600 font_size: 13.0 no_wrap: true }
        }
        Container { width: status_width * 1px padding: 11.0
            Text { content: status color: var(--argui-foreground) font_size: 12.0 no_wrap: true }
        }
        Container { width: owner_width * 1px padding: 11.0
            Text { content: owner color: var(--argui-muted-foreground) font_size: 13.0 no_wrap: true }
        }
        Row { width: hours_width * 1px gap: 4.0 align_items: "center"
            Button { text: "Decrease hours" variant: "ghost" show_text: false height: 28px padding: 6.0 enabled: hours > 0 on click { hours = hours - 1 }
                Minus { size: 15px color: var(--argui-foreground) }
            }
            Text { content: str(hours) color: var(--argui-foreground) font_size: 13.0 }
            Button { text: "Increase hours" variant: "ghost" show_text: false height: 28px padding: 6.0 on click { hours = hours + 1 }
                Plus { size: 15px color: var(--argui-foreground) }
            }
        }
    }
}

export component DataTablePage {
    private property tasks: array<string> = [
        "Audit the design system", "Build the settings page", "Review keyboard navigation",
        "Update the documentation", "Polish empty states", "Ship the component gallery"
    ]
    private property sort_mode: string = "Source order"
    private property task_desc: bool = false
    private property status_desc: bool = false
    private property hours_desc: bool = false
    private property selected_task: string = ""
    private property task_width: float = 270.0
    private property status_width: float = 135.0
    private property owner_width: float = 170.0
    private property hours_width: float = 105.0

    Column {
        width: 100%
        gap: 18.0
        Text { content: "Data table" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Drag column dividers to resize, sort tasks, select a row, and adjust estimated hours." color: var(--argui-muted-foreground) font_size: 14.0 }
        Row { wrap: true gap: 12.0
            Text { content: "Sort: " + sort_mode color: var(--argui-muted-foreground) font_size: 13.0 }
            Text { content: selected_task == "" ? "No row selected" : "Selected: " + selected_task color: var(--argui-primary) font_size: 13.0 weight: 600 }
        }

        Flickable { width: 100% height: 360px scroll_x: true scroll_y: false
            DataTable { label: "Project tasks" width: (task_width + status_width + owner_width + hours_width) * 1px
                Row { width: 100% height: 46px background: var(--argui-muted) align_items: "center"
                    Row { width: task_width * 1px height: 46px align_items: "center"
                        Container { width: task_width * 1px - 10px
                        Button { text: "Task" variant: "ghost" on click {
                            tasks = task_desc ? ["Update the documentation", "Ship the component gallery", "Review keyboard navigation", "Polish empty states", "Build the settings page", "Audit the design system"] : ["Audit the design system", "Build the settings page", "Polish empty states", "Review keyboard navigation", "Ship the component gallery", "Update the documentation"]
                            sort_mode = task_desc ? "Task descending" : "Task ascending"
                            task_desc = !task_desc
                        }
                            if sort_mode == "Task ascending" { ArrowUp { size: 14px color: var(--argui-muted-foreground) } }
                            if sort_mode == "Task descending" { ArrowDown { size: 14px color: var(--argui-muted-foreground) } }
                            if sort_mode != "Task ascending" && sort_mode != "Task descending" { ArrowsSort { size: 14px color: var(--argui-muted-foreground) } }
                        }
                        }
                        DataTableResizeHandle { label: "Resize Task column" value <=> task_width x: task_width * 1px - 10px minimum: 170.0 maximum: 420.0 }
                    }
                    Row { width: status_width * 1px height: 46px align_items: "center"
                        Container { width: status_width * 1px - 10px
                        Button { text: "Status" variant: "ghost" on click {
                            tasks = status_desc ? ["Audit the design system", "Update the documentation", "Build the settings page", "Polish empty states", "Review keyboard navigation", "Ship the component gallery"] : ["Review keyboard navigation", "Ship the component gallery", "Build the settings page", "Polish empty states", "Audit the design system", "Update the documentation"]
                            sort_mode = status_desc ? "Status descending" : "Status ascending"
                            status_desc = !status_desc
                        }
                            if sort_mode == "Status ascending" { ArrowUp { size: 14px color: var(--argui-muted-foreground) } }
                            if sort_mode == "Status descending" { ArrowDown { size: 14px color: var(--argui-muted-foreground) } }
                            if sort_mode != "Status ascending" && sort_mode != "Status descending" { ArrowsSort { size: 14px color: var(--argui-muted-foreground) } }
                        }
                        }
                        DataTableResizeHandle { label: "Resize Status column" value <=> status_width x: status_width * 1px - 10px minimum: 100.0 maximum: 260.0 }
                    }
                    Row { width: owner_width * 1px height: 46px align_items: "center"
                        Container { width: owner_width * 1px - 10px padding: 11.0
                            Text { content: "Assignee" color: var(--argui-muted-foreground) weight: 600 font_size: 13.0 }
                        }
                        DataTableResizeHandle { label: "Resize Assignee column" value <=> owner_width x: owner_width * 1px - 10px minimum: 120.0 maximum: 300.0 }
                    }
                    Container { width: hours_width * 1px
                        Button { text: "Hours" variant: "ghost" on click {
                            tasks = hours_desc ? ["Review keyboard navigation", "Ship the component gallery", "Audit the design system", "Update the documentation", "Build the settings page", "Polish empty states"] : ["Polish empty states", "Build the settings page", "Update the documentation", "Audit the design system", "Ship the component gallery", "Review keyboard navigation"]
                            sort_mode = hours_desc ? "Hours descending" : "Hours ascending"
                            hours_desc = !hours_desc
                        }
                            if sort_mode == "Hours ascending" { ArrowUp { size: 14px color: var(--argui-muted-foreground) } }
                            if sort_mode == "Hours descending" { ArrowDown { size: 14px color: var(--argui-muted-foreground) } }
                            if sort_mode != "Hours ascending" && sort_mode != "Hours descending" { ArrowsSort { size: 14px color: var(--argui-muted-foreground) } }
                        }
                    }
                }
                for title in tasks key title {
                    TaskTableRow {
                        title: title
                        owner: title == "Audit the design system" || title == "Update the documentation" ? "Alex Morgan" : title == "Build the settings page" || title == "Polish empty states" ? "Sam Chen" : "Jordan Lee"
                        status: title == "Audit the design system" || title == "Update the documentation" ? "In progress" : title == "Build the settings page" || title == "Polish empty states" ? "Done" : "Backlog"
                        initial_hours: title == "Audit the design system" ? 8 : title == "Build the settings page" ? 4 : title == "Review keyboard navigation" ? 13 : title == "Update the documentation" ? 6 : title == "Polish empty states" ? 3 : 10
                        selected: selected_task == title
                        task_width: task_width
                        status_width: status_width
                        owner_width: owner_width
                        hours_width: hours_width
                        on select { selected_task = title }
                    }
                }
            }
        }
        Text { content: "1 of 6 rows selected at most · Use the − and + controls to edit hours." color: var(--argui-muted-foreground) font_size: 12.0 }
    }
}
