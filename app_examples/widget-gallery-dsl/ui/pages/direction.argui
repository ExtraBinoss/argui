import { Column, Container, Row, Text } from "@argui/native"

export component DirectionPage {
    Column #direction_page {
        width: 100%
        gap: 24.0

        Text { content: "Direction" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Compare left-to-right and right-to-left arrangements." color: var(--argui-muted-foreground) font_size: 14.0 }

        Column { width: 100% gap: 12.0
            Text { content: "Left to right" color: var(--argui-foreground) font_size: 17.0 weight: 600 }
            Row { width: 100% wrap: true gap: 12.0
                Container { padding: 14.0 background: var(--argui-muted) radius: 7.0
                    Text { content: "First" color: var(--argui-foreground) font_size: 14.0 weight: 500 }
                }
                Container { padding: 14.0 background: var(--argui-muted) radius: 7.0
                    Text { content: "Second" color: var(--argui-foreground) font_size: 14.0 weight: 500 }
                }
                Container { padding: 14.0 background: var(--argui-muted) radius: 7.0
                    Text { content: "Third" color: var(--argui-foreground) font_size: 14.0 weight: 500 }
                }
            }
        }

        Column { width: 100% gap: 12.0
            Row { width: 100% justify_content: "end"
                Text { content: "Right to left" color: var(--argui-foreground) font_size: 17.0 weight: 600 }
            }
            Row { width: 100% wrap: true gap: 12.0 justify_content: "end"
                Container { padding: 14.0 background: var(--argui-muted) radius: 7.0
                    Text { content: "Third" color: var(--argui-foreground) font_size: 14.0 weight: 500 }
                }
                Container { padding: 14.0 background: var(--argui-muted) radius: 7.0
                    Text { content: "Second" color: var(--argui-foreground) font_size: 14.0 weight: 500 }
                }
                Container { padding: 14.0 background: var(--argui-muted) radius: 7.0
                    Text { content: "First" color: var(--argui-foreground) font_size: 14.0 weight: 500 }
                }
            }
        }
    }
}
