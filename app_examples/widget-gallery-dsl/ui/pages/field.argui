import { Field, Input } from "@argui/ui"
import { Column, Container, Text } from "@argui/native"

export component FieldPage {
    private property email: string = ""
    private property invalid: bool = email != "" && !contains(email, "@")

    Column #field_page {
        width: 100%
        gap: 18.0

        Text { content: "Field" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Labels, help text, and validation stay with the control." color: var(--argui-muted-foreground) font_size: 14.0 }

        Container { width: 420px
            Field {
                label: "Email address"
                required: true
                description: "Use your work email to receive the invitation."
                error: invalid ? "Include an @ in the email address." : ""
                Input {
                    value <=> email
                    label: "Email address"
                    placeholder: "you@example.com"
                    invalid: invalid
                }
            }
        }
    }
}
