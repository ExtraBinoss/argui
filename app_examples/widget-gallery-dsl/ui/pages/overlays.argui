import { Button, Popover, Dialog } from "@argui/ui"
import { Column, Container, PopupWindow, Rectangle, Row, Text } from "@argui/native"

export effect WorleyBorder {
    shader: "../../assets/worley-border.wgsl"
    damage: "bounded"
    parameter intensity: float = 1.0
    parameter scale: float = 0.035
}

export component OverlaysPage {
    private property popover_open: bool = false
    private property dialog_open: bool = false
    private property shader_popover_open: bool = false

    Column {
        width: 100%
        gap: 18.0
        Text { content: "Overlays" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Anchored surfaces float above the page; translucent fills blur the colored rows behind them." color: var(--argui-muted-foreground) font_size: 14.0 }

        Container {
            width: 300px
            height: 180px
            background: var(--argui-muted)
            Column { x: 12px y: 60px gap: 8.0
                Row { gap: 8.0
                    Rectangle { width: 34px height: 26px radius: 5.0 background: solid(#5b73f1) }
                    Text { content: "Design review and project notes" color: var(--argui-foreground) font_size: 13.0 }
                }
                Row { gap: 8.0
                    Rectangle { width: 34px height: 26px radius: 5.0 background: solid(#d860a5) }
                    Text { content: "Release checklist and assets" color: var(--argui-foreground) font_size: 13.0 }
                }
                Text { content: "This row stays in place when opened." color: var(--argui-muted-foreground) font_size: 12.0 }
            }
            Container #popover_anchor {
                x: 12px
                y: 12px
                width: 180px
                Button { text: "Open popover" on click { popover_open = !popover_open } }
            }
        }
        Popover {
            open: popover_open
            anchor: "popover_anchor"
            initial_focus: "first"
            restore_focus: true
            surface_fill: solid(var(--argui-glass-surface))
            backdrop_filter: "blur(18px)"
            border_color: var(--argui-border)
            radius: 14.0
            on dismiss { popover_open = false }
            Column {
                gap: 10.0
                Text { content: "Popover content" color: var(--argui-foreground) font_size: 14.0 }
                Button { text: "Close popover" variant: "outline" on click { popover_open = false } }
            }
        }

        Container {
            width: 300px
            height: 170px
            background: var(--argui-muted)
            Row { x: 12px y: 65px gap: 8.0
                Rectangle { width: 38px height: 72px radius: 5.0 background: solid(#d860a5) }
                Rectangle { width: 38px height: 72px radius: 5.0 background: solid(#5b73f1) }
                Text { content: "Color bands behind glass" color: var(--argui-foreground) font_size: 13.0 }
            }
            Container #shader_anchor {
                x: 12px
                y: 12px
                width: 210px
                Button { text: "Open WGSL popover" variant: "outline" on click { shader_popover_open = !shader_popover_open } }
            }
        }
        PopupWindow {
            visible: shader_popover_open
            anchor: "shader_anchor"
            placement: "bottom_start"
            dismiss_policy: "outside_pointer_or_escape"
            initial_focus: "first"
            restore_focus: true
            width: 260px
            on dismiss { shader_popover_open = false }
            Rectangle {
                width: 260px
                background: solid(var(--argui-glass-surface))
                backdrop_filter: "blur(18px)"
                border_color: var(--argui-border)
                border_width: 2.0
                radius: 14.0
                effect: WorleyBorder { scope: "border" intensity: 0.9 scale: 0.035 }
                Column {
                    padding: 14.0
                    gap: 8.0
                    Text { content: "WGSL border on a base Rectangle" color: var(--argui-foreground) font_size: 14.0 }
                    Text { content: "Blurred backdrop, translucent fill, independent border shader." color: var(--argui-muted-foreground) font_size: 12.0 }
                }
            }
        }

        Button { text: "Open dialog" on click { dialog_open = true } }
        Dialog {
            open: dialog_open
            title: "Dialog title"
            description: "Escape closes the modal and returns focus to its trigger."
            on dismiss { dialog_open = false }
            Button { text: "Close dialog" on click { dialog_open = false } }
        }
    }
}
