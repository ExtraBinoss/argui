import { ListRow, ScrollView } from "@argui/ui"
import { Column, FocusScope, KeyBinding, Text } from "@argui/native"

export component ListPage {
    private property one: bool = false
    private property two: bool = false
    private property three: bool = false
    private property four: bool = false
    private property five: bool = false
    private property six: bool = false
    private property seven: bool = false
    private property eight: bool = false
    private property selected_count: int = (one ? 1 : 0) + (two ? 1 : 0) + (three ? 1 : 0) + (four ? 1 : 0) + (five ? 1 : 0) + (six ? 1 : 0) + (seven ? 1 : 0) + (eight ? 1 : 0)

    Column #list_page {
        width: 100%
        gap: 12.0

        Text { content: "List" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Select several rows by pointer or keyboard." color: var(--argui-muted-foreground) font_size: 14.0 }

        ScrollView { width: 460px height: 270px show_edge_shadows: true
        FocusScope {
            role: "list_box"
            accessible_name: "Items"
            focus_on_tab_navigation: false
            KeyBinding { shortcut: "ArrowDown" on activated { focus_next() } }
            KeyBinding { shortcut: "ArrowUp" on activated { focus_previous() } }
            Column { width: 100% gap: 4.0
                ListRow { label: "Item 1" height: 64px selected <=> one }
                ListRow { label: "Item 2" selected <=> two }
                ListRow { label: "Item 3" selected <=> three }
                ListRow { label: "Item 4" height: 64px selected <=> four }
                ListRow { label: "Item 5" selected <=> five }
                ListRow { label: "Item 6" selected <=> six }
                ListRow { label: "Item 7" height: 64px selected <=> seven }
                ListRow { label: "Item 8" selected <=> eight }
            }
        }
        }
        Text { content: str(selected_count) + " selected" color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
