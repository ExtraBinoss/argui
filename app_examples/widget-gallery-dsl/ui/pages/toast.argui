import { Button, Toast, ToastHost } from "@argui/ui"
import { Column, Text } from "@argui/native"

export component ToastPage {
    private property serial: int = 0
    private property first: int = 0
    private property second: int = 0
    private property third: int = 0

    Column #toast_page {
        width: 100%
        gap: 18.0
        Text { content: "Toast" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Show up to three notifications and close them individually." color: var(--argui-muted-foreground) font_size: 14.0 }
        Button { text: "Show notification" on click {
            third = second
            second = first
            serial = serial + 1
            first = serial
        } }
        Text { content: str((first > 0 ? 1 : 0) + (second > 0 ? 1 : 0) + (third > 0 ? 1 : 0)) + " visible" color: var(--argui-muted-foreground) font_size: 13.0 }

        ToastHost { open: first > 0
            if first > 0 {
                Toast { title: "Notification " + str(first) description: "Your changes have been saved successfully." variant: "success"
                    on dismiss { first = second second = third third = 0 } }
            }
            if second > 0 {
                Toast { title: "Notification " + str(second) description: "Your changes have been saved successfully." variant: "success"
                    on dismiss { second = third third = 0 } }
            }
            if third > 0 {
                Toast { title: "Notification " + str(third) description: "Your changes have been saved successfully." variant: "success"
                    on dismiss { third = 0 } }
            }
        }
    }
}
