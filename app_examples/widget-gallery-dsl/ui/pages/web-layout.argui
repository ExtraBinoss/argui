import { Column, Container, Rectangle, Row, Text } from "@argui/native"

component LayoutTile {
    in property label: string
    Rectangle {
        width: 86px height: 46px radius: 7.0 background: solid(var(--argui-primary))
        Row { width: 100% height: 100% align_items: "center" justify_content: "center"
            Text { content: label color: var(--argui-primary-foreground) weight: 700 font_size: 14.0 }
        }
    }
}

component GridCell {
    in property label: string
    Container {
        height: 46px grow: 1.0 radius: 7.0 background: var(--argui-primary)
        Row { width: 100% height: 100% align_items: "center" justify_content: "center"
            Text { content: label color: var(--argui-primary-foreground) weight: 700 font_size: 14.0 }
        }
    }
}

export component WebLayoutPage {
    Column {
        width: 100%
        gap: 18.0
        Text { content: "Web layout" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Flex flow, wrapping, three-column composition and logical text alignment from base primitives." color: var(--argui-muted-foreground) font_size: 14.0 }
        Text { content: "Flex row" color: var(--argui-foreground) weight: 700 font_size: 17.0 }
        Rectangle {
            width: 100% radius: 10.0 background: solid(var(--argui-muted))
            Row { width: 100% padding: 10.0 gap: 10.0 align_items: "center" justify_content: "space_between"
                LayoutTile { label: "A" }
                LayoutTile { label: "B" }
                LayoutTile { label: "C" }
            }
        }
        Text { content: "Wrapping tiles" color: var(--argui-foreground) weight: 700 font_size: 17.0 }
        Rectangle {
            width: 100% radius: 10.0 background: solid(var(--argui-muted))
            Row { width: 100% wrap: true padding: 10.0 gap: 10.0
                LayoutTile { label: "1" }
                LayoutTile { label: "2" }
                LayoutTile { label: "3" }
                LayoutTile { label: "4" }
                LayoutTile { label: "5" }
                LayoutTile { label: "6" }
            }
        }
        Text { content: "Three-column composition" color: var(--argui-foreground) weight: 700 font_size: 17.0 }
        Text { content: "Two rows of equal flex cells approximate the old grid; the DSL has no native Grid primitive yet." color: var(--argui-muted-foreground) font_size: 13.0 }
        Rectangle {
            width: 100% radius: 10.0 background: solid(var(--argui-muted))
            Column { width: 100% padding: 10.0 gap: 10.0
                Row { width: 100% gap: 10.0
                    GridCell { label: "1" }
                    GridCell { label: "2" }
                    GridCell { label: "3" }
                }
                Row { width: 100% gap: 10.0
                    GridCell { label: "4" }
                    GridCell { label: "5" }
                    GridCell { label: "6" }
                }
            }
        }
        Text { content: "Logical text alignment" color: var(--argui-foreground) weight: 700 font_size: 17.0 }
        Rectangle {
            width: 100% radius: 10.0 background: solid(var(--argui-muted))
            Column { width: 100% padding: 14.0 gap: 8.0
                Text { content: "Logical start · مرحبا" width: 100% color: var(--argui-foreground) font_size: 14.0 text_align: "start" }
                Text { content: "Centered content" width: 100% color: var(--argui-foreground) font_size: 14.0 text_align: "center" }
                Text { content: "Logical end · שלום" width: 100% color: var(--argui-foreground) font_size: 14.0 text_align: "end" }
            }
        }
    }
}
