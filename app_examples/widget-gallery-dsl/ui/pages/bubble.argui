import { Button, Input } from "@argui/ui"
import { Column, Container, Row, Text } from "@argui/native"
import { ConversationBubble } from "@argui/ui/bubble.argui"

export component BubblePage {
    private property liked: bool = false
    private property draft: string = ""
    private property sent_reply: string = ""

    Column {
        width: 100%
        gap: 20.0
        Text { content: "Bubble" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Conversation surfaces align with the speaker and can hold ordinary interactive controls." color: var(--argui-muted-foreground) font_size: 14.0 }

        Column {
            width: 100%
            gap: 14.0
            ConversationBubble {
                Text { content: "Ada · 10:42" color: var(--argui-muted-foreground) font_size: 12.0 weight: 600 }
                Text { content: "A compact message surface." color: var(--argui-foreground) font_size: 14.0 }
            }
            ConversationBubble {
                variant: "tinted"
                end: true
                Text { content: "You · 10:43" color: var(--argui-muted-foreground) font_size: 12.0 weight: 600 }
                Text { content: "A softer accent for a reply." color: var(--argui-foreground) font_size: 14.0 }
                Button { text: liked ? "♥ Liked" : "♡ Like" variant: "ghost" on click { liked = !liked } }
            }
            ConversationBubble {
                variant: "outline"
                Text { content: "Ada · 10:44" color: var(--argui-muted-foreground) font_size: 12.0 weight: 600 }
                Text { content: "A quiet outlined conversation." color: var(--argui-foreground) font_size: 14.0 }
            }
            if sent_reply != "" {
                ConversationBubble {
                    variant: "tinted"
                    end: true
                    Text { content: "You · just now" color: var(--argui-muted-foreground) font_size: 12.0 weight: 600 }
                    Text { content: sent_reply color: var(--argui-foreground) font_size: 14.0 }
                }
            }
        }

        Row {
            width: 100%
            gap: 10.0
            Container {
                width: 75%
                min_width: 0.0
                grow: 1.0
                Input { value <=> draft label: "Reply" placeholder: "Write a reply…" on submit { sent_reply = draft draft = "" } }
            }
            Button { text: "Send" enabled: draft != "" on click { sent_reply = draft draft = "" } }
        }
    }
}
