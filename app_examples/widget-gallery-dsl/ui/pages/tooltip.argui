import { Tooltip } from "@argui/ui"
import { Column, Container, Rectangle, Row, Text } from "@argui/native"

export component TooltipPage {
    private property status: string = "Hover a button or reach it with Tab. Escape dismisses the hint."

    Column #tooltip_page {
        width: 100%
        gap: 18.0
        Text { content: "Tooltip" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Short explanations appear beside the focused or hovered action." color: var(--argui-muted-foreground) font_size: 14.0 }
        Row {
            wrap: true
            gap: 16.0
            Container #save_tip_anchor {
                width: 160px
                Tooltip { label: "Save draft" description: "Save a local copy of your current draft." anchor: "save_tip_anchor"
                    on click { status = "Draft saved locally." } }
            }
            Container #preview_tip_anchor {
                width: 160px
                Tooltip { label: "Preview page" description: "Preview the page before sharing." anchor: "preview_tip_anchor"
                    surface_fill: solid(var(--argui-glass-surface)) backdrop_filter: "blur(10px)"
                    on click { status = "Page preview is ready." } }
            }
            Container #history_tip_anchor {
                width: 160px
                Tooltip { label: "View history" description: "See the previous versions of this project." anchor: "history_tip_anchor"
                    on click { status = "History: three saved versions." } }
            }
        }
        Text { content: "Glass tooltip" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
        Text { content: "Hover or focus the button to blur the colored detail behind the hint." color: var(--argui-muted-foreground) font_size: 13.0 }
        Container {
            width: 520px
            height: 184px
            background: var(--argui-muted)
            Row { x: 28px y: 81px gap: 6.0
                Rectangle { width: 42px height: 72px radius: 5.0 background: solid(#e05e92) }
                Rectangle { width: 42px height: 72px radius: 5.0 background: solid(#5880e9) }
                Rectangle { width: 42px height: 72px radius: 5.0 background: solid(#e9b24d) }
                Rectangle { width: 42px height: 72px radius: 5.0 background: solid(#55ae98) }
                Rectangle { width: 42px height: 72px radius: 5.0 background: solid(#e05e92) }
                Rectangle { width: 42px height: 72px radius: 5.0 background: solid(#5880e9) }
            }
            Container #glass_tip_anchor {
                x: 28px
                y: 20px
                width: 190px
                Tooltip {
                    label: "Glass tooltip"
                    description: "Colored detail stays soft behind this hint."
                    anchor: "glass_tip_anchor"
                    width: 286px
                    surface_fill: solid(var(--argui-glass-surface))
                    backdrop_filter: "blur(18px)"
                }
            }
        }
        Text { content: status color: var(--argui-foreground) font_size: 14.0 }
    }
}
