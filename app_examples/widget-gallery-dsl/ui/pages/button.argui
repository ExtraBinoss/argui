import { Button } from "@argui/ui"
import { Column, Row, Container, Text } from "@argui/native"
import { Spinner, Star } from "@argui/icons"

export component ButtonPage {
    private property click_count: int = 0
    private property last_used: string = "None"
    private property star_active: bool = false

    Column #button_page {
        width: 100%
        gap: 22.0

        Text { content: "Button" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Actions, variants and interactive states." color: var(--argui-muted-foreground) font_size: 14.0 }

        Text { content: "Variants" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
        Row {
            wrap: true
            gap: 10.0
            Button #primary { text: "Primary" on click { click_count = click_count + 1 last_used = "Primary" star_active = false } }
            Button #secondary { text: "Secondary" variant: "secondary" on click { click_count = click_count + 1 last_used = "Secondary" star_active = false } }
            Button #outline { text: "Outline" variant: "outline" on click { click_count = click_count + 1 last_used = "Outline" star_active = false } }
            Button #ghost { text: "Ghost" variant: "ghost" on click { click_count = click_count + 1 last_used = "Ghost" star_active = false } }
            Button #destructive { text: "Delete" variant: "destructive" on click { click_count = click_count + 1 last_used = "Delete" star_active = false } }
        }

        Text { content: "States and icons" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
        Row {
            wrap: true
            gap: 10.0
            Button #disabled { text: "Disabled" enabled: false variant: "outline" }
            Button #loading {
                text: "Loading"
                busy: true
                show_text: false
                Row {
                    gap: 8.0
                    Spinner {
                        size: 16px
                        color: var(--argui-primary-foreground)
                        rotation: 0.0
                        animate rotation { from: 0.0 to: 360.0 duration: 1000ms iterations: "infinite" }
                    }
                    Text { content: "Loading" color: var(--argui-primary-foreground) weight: 600 font_size: 15.0 }
                }
            }
            Button #icon {
                text: "Star"
                variant: "outline"
                show_text: false
                padding: 8.0
                Container {
                    width: 21px
                    height: 21px
                    radius: 11.0
                    background: star_active ? var(--argui-selection) : var(--argui-surface)
                    Star {
                        size: 17px
                        color: var(--argui-foreground)
                        states { lit when star_active { color: var(--argui-primary) rotation: 18.0 } }
                        animate color { transition: in-out duration: 180ms }
                        animate rotation { transition: in-out duration: 180ms }
                    }
                }
                on click { click_count = click_count + 1 last_used = "Star" star_active = !star_active }
            }
        }
        Text {
            content: "Clicks: " + str(click_count) + " · Last used: " + last_used
            color: var(--argui-muted-foreground)
            font_size: 13.0
        }
    }
}
