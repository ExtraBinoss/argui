import { ScrollView, Slider } from "@argui/ui"
import { Column, Container, Row, Text } from "@argui/native"

export component ScrollShadowPage {
    private property shadow_size: float = 20.0
    private property shadow_strength: float = 0.16
    private property entries: array<string> = [
        "Application shell", "Navigation menu", "Search field", "Settings panel",
        "Activity timeline", "Color palette", "Layers panel", "Canvas tools",
        "Export presets", "Recent projects", "Saved components", "Keyboard shortcuts",
        "Workspace", "Archive", "Preferences", "New document"
    ]

    Column {
        width: 100%
        gap: 18.0
        Text { content: "Scroll shadow" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Feathered shadows appear only when more content lies beyond the visible edge." color: var(--argui-muted-foreground) font_size: 14.0 }

        Row {
            width: 100%
            wrap: true
            gap: 24.0
            Column {
                gap: 7.0
                Text { content: "Fade width · " + str(shadow_size) + " px" color: var(--argui-foreground) font_size: 13.0 }
                Slider { label: "Fade width" minimum: 0.0 maximum: 60.0 value: shadow_size on changed(next) { shadow_size = next } }
            }
            Column {
                gap: 7.0
                Text { content: "Intensity · " + str(shadow_strength * 100.0) + "%" color: var(--argui-foreground) font_size: 13.0 }
                Slider { label: "Shadow intensity" minimum: 0.0 maximum: 0.4 value: shadow_strength on changed(next) { shadow_strength = next } }
            }
        }

        Row {
            wrap: true
            gap: 18.0
            Column {
                gap: 8.0
                Text { content: "Long list" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
                ScrollView {
                    width: 360px
                    height: 240px
                    show_edge_shadows: true
                    edge_shadow_width: shadow_size * 1px
                    edge_shadow_intensity: shadow_strength
                    Column {
                        width: 100%
                        gap: 3.0
                        for item in entries key item {
                            Container {
                                width: 100%
                                height: 34px
                                shrink: 0.0
                                background: var(--argui-surface)
                                Text { content: item color: var(--argui-foreground) font_size: 13.0 }
                            }
                        }
                    }
                }
            }
            Column {
                gap: 8.0
                Text { content: "Independent viewport" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
                ScrollView {
                    width: 260px
                    height: 180px
                    show_edge_shadows: true
                    edge_shadow_width: shadow_size * 1px
                    edge_shadow_intensity: shadow_strength
                    Column {
                        width: 100%
                        gap: 5.0
                        for item in entries key item {
                            Container {
                                width: 100%
                                height: 48px
                                shrink: 0.0
                                background: var(--argui-muted)
                                Text { content: item color: var(--argui-foreground) font_size: 13.0 }
                            }
                        }
                    }
                }
            }
        }
    }
}
