import { Button } from "@argui/ui"
import { Column, Row, Container, Rectangle, Text, Image, Svg, Path } from "@argui/native"

export effect AuroraTint {
    shader: "../../assets/aurora-tint.wgsl"
    damage: "bounded"
    parameter strength: float = 0.7
}

export component VisualCompositionPage {
    private property animated: bool = true
    private property angle: float = 0.0

    animate angle { from: 0.0 to: 360.0 duration: 6000ms iterations: "infinite" }

    Column #visual_composition_page {
        width: 100%
        gap: 18.0

        Text { content: "Visual composition" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Authored geometry, project assets, a shader, theme gradients and motion share one composition." color: var(--argui-muted-foreground) font_size: 14.0 }

        Row {
            gap: 12.0
            Button { text: animated ? "Pause motion" : "Play motion" variant: "outline" on click { animated = !animated } }
            Text { content: animated ? "Motion is playing" : "Motion is paused" color: var(--argui-muted-foreground) font_size: 13.0 }
        }

        Container #visual_canvas {
            width: 100%
            height: 260px
            Rectangle {
                width: 100%
                height: 260px
                radius: 16.0
                clip: true
                background: linear_gradient(
                    [var(--argui-primary), var(--argui-ring), var(--argui-surface)],
                    [0.0, 0.55, 1.0], 18.0, "oklab"
                )
                Image {
                    source: asset("../../assets/gallery-preview.webp")
                    width: 100%
                    height: 260px
                    fit: "cover"
                    opacity: 0.18
                }
            }
            Path #visual_path {
                effect: AuroraTint { strength: animated ? 0.7 : 0.1 }
                source: path(120.0, 120.0, [
                    move_to(60.0, 4.0),
                    cubic_to(76.0, 30.0, 90.0, 44.0, 116.0, 60.0),
                    cubic_to(90.0, 76.0, 76.0, 90.0, 60.0, 116.0),
                    cubic_to(44.0, 90.0, 30.0, 76.0, 4.0, 60.0),
                    cubic_to(30.0, 44.0, 44.0, 30.0, 60.0, 4.0),
                    close_path()
                ], true, 0.0, false)
                x: 30px
                y: 64px
                width: 120px
                height: 120px
                color: var(--argui-primary-foreground)
                opacity: 0.8
                rotation: animated ? angle : 0.0
            }
            Svg {
                source: asset("../../assets/spark.svg")
                x: 69px
                y: 103px
                width: 42px
                height: 42px
                color: var(--argui-primary)
            }
            Text {
                content: "A small universe"
                x: 174px
                y: 87px
                color: var(--argui-primary-foreground)
                font_size: 24.0
                weight: 700
            }
            Text {
                content: "Shape · light · image · motion"
                x: 174px
                y: 125px
                color: var(--argui-primary-foreground)
                font_size: 14.0
            }
        }
    }
}
