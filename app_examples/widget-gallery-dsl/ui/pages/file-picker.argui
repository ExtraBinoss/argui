import { FilePicker } from "@argui/ui"
import { Column, Rectangle, Row, Text } from "@argui/native"

export component FilePickerPage {
    in property host_status: string
    callback request_file(mode: string) -> string
    private property file_status: string = "No selection yet."
    private property files_status: string = "No selection yet."
    private property folder_status: string = "No selection yet."
    private property folders_status: string = "No selection yet."
    private property save_status: string = "No selection yet."
    private property request_count: int = 0

    Column #file_picker_page {
        width: 100%
        gap: 18.0
        Text { content: "File picker" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Choose files, folders, or an export destination with the system dialog." color: var(--argui-muted-foreground) font_size: 14.0 }

        Rectangle { width: 100% background: solid(var(--argui-surface)) border_color: var(--argui-border) border_width: 1.0 radius: 10.0
            Column { width: 100% padding: 18.0 gap: 10.0
                Text { content: "Open a document" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
                Text { content: "Choose one TXT, Markdown, or PDF document." color: var(--argui-muted-foreground) font_size: 13.0 }
                FilePicker { label: "Open a document" mode: "file" status: file_status
                    on request(mode) { request_count = request_count + 1 file_status = request_file(mode) file_status = file_status == "" ? "Native dialog unavailable in this host." : file_status } }
            }
        }
        Rectangle { width: 100% background: solid(var(--argui-surface)) border_color: var(--argui-border) border_width: 1.0 radius: 10.0
            Column { width: 100% padding: 18.0 gap: 10.0
                Text { content: "Select images" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
                Text { content: "Choose several images in a single dialog." color: var(--argui-muted-foreground) font_size: 13.0 }
                FilePicker { label: "Select images" mode: "files" status: files_status
                    on request(mode) { request_count = request_count + 1 files_status = request_file(mode) files_status = files_status == "" ? "Native dialog unavailable in this host." : files_status } }
            }
        }
        Rectangle { width: 100% background: solid(var(--argui-surface)) border_color: var(--argui-border) border_width: 1.0 radius: 10.0
            Column { width: 100% padding: 18.0 gap: 10.0
                Text { content: "Choose project folder" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
                Text { content: "Select the folder that contains your project." color: var(--argui-muted-foreground) font_size: 13.0 }
                FilePicker { label: "Choose project folder" mode: "folder" status: folder_status
                    on request(mode) { request_count = request_count + 1 folder_status = request_file(mode) folder_status = folder_status == "" ? "Native dialog unavailable in this host." : folder_status } }
            }
        }
        Rectangle { width: 100% background: solid(var(--argui-surface)) border_color: var(--argui-border) border_width: 1.0 radius: 10.0
            Column { width: 100% padding: 18.0 gap: 10.0
                Text { content: "Choose source folders" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
                Text { content: "Select several folders to include in a collection." color: var(--argui-muted-foreground) font_size: 13.0 }
                FilePicker { label: "Choose source folders" mode: "folders" status: folders_status
                    on request(mode) { request_count = request_count + 1 folders_status = request_file(mode) folders_status = folders_status == "" ? "Native dialog unavailable in this host." : folders_status } }
            }
        }
        Rectangle { width: 100% background: solid(var(--argui-surface)) border_color: var(--argui-border) border_width: 1.0 radius: 10.0
            Column { width: 100% padding: 18.0 gap: 10.0
                Text { content: "Choose export destination" color: var(--argui-foreground) weight: 600 font_size: 16.0 }
                Text { content: "Choose where to save report.txt without writing a file." color: var(--argui-muted-foreground) font_size: 13.0 }
                FilePicker { label: "Choose export destination" mode: "save" status: save_status
                    on request(mode) { request_count = request_count + 1 save_status = request_file(mode) save_status = save_status == "" ? "Native dialog unavailable in this host." : save_status } }
            }
        }
        Text { content: host_status color: var(--argui-muted-foreground) font_size: 13.0 }
        Text { content: "Picker requests: " + str(request_count) color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
