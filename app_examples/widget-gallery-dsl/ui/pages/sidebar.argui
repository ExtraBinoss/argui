import { SidebarNavItem } from "@argui/ui/sidebar-nav-item.argui"
import { Activity, Folder, LayoutSidebarLeftCollapse, LayoutSidebarLeftExpand, Settings } from "@argui/icons"
import { Column, Rectangle, Text } from "@argui/native"

export component SidebarPage {
    private property collapsed: bool = false
    private property opened: string = "Projects"

    Column #sidebar_page {
        width: 100%
        gap: 18.0

        Text { content: "Sidebar" color: var(--argui-foreground) weight: 700 font_size: 27.0 }
        Text { content: "Collapse workspace navigation to an icon rail. Every action remains available." color: var(--argui-muted-foreground) font_size: 14.0 }

        Rectangle {
            width: 248px
            states { compact when collapsed { width: 64px } }
            animate width { transition: in-out duration: 200ms }
            radius: 10.0
            border_color: var(--argui-border)
            border_width: 1.0
            background: solid(var(--argui-surface))
            Column { width: 100% padding: 8.0 gap: 8.0
                SidebarNavItem { label: collapsed ? "Expand navigation" : "Collapse navigation" collapsed: collapsed on click { collapsed = !collapsed }
                    if collapsed { LayoutSidebarLeftExpand { size: 20px color: var(--argui-foreground) } }
                    if !collapsed { LayoutSidebarLeftCollapse { size: 20px color: var(--argui-foreground) } }
                }
                if !collapsed {
                    Text { content: "Your workspace" color: var(--argui-muted-foreground) font_size: 12.0 weight: 600 }
                }
                SidebarNavItem { label: "Projects" collapsed: collapsed selected: opened == "Projects" on click { opened = "Projects" }
                    Folder { size: 20px color: opened == "Projects" ? var(--argui-primary) : var(--argui-foreground) }
                }
                SidebarNavItem { label: "Activity" collapsed: collapsed selected: opened == "Activity" on click { opened = "Activity" }
                    Activity { size: 20px color: opened == "Activity" ? var(--argui-primary) : var(--argui-foreground) }
                }
                SidebarNavItem { label: "Settings" collapsed: collapsed selected: opened == "Settings" on click { opened = "Settings" }
                    Settings { size: 20px color: opened == "Settings" ? var(--argui-primary) : var(--argui-foreground) }
                }
                if !collapsed {
                    Text { content: "Personal account" color: var(--argui-muted-foreground) font_size: 12.0 }
                }
            }
        }
        Text { content: "Opened " + opened color: var(--argui-muted-foreground) font_size: 13.0 }
    }
}
