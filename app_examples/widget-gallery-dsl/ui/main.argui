import { Button, Popover, Separator } from "@argui/ui"
import { Row, Column, Container, Text, VirtualWindow } from "@argui/native"
import { ButtonPage } from "./pages/button.argui"
import { AccordionPage } from "./pages/accordion.argui"
import { AlertPage } from "./pages/alert.argui"
import { AlertDialogPage } from "./pages/alert-dialog.argui"
import { AttachmentPage } from "./pages/attachment.argui"
import { BubblePage } from "./pages/bubble.argui"
import { ButtonGroupPage } from "./pages/button-group.argui"
import { CarouselPage } from "./pages/carousel.argui"
import { CalendarPage } from "./pages/calendar.argui"
import { DatePickerPage } from "./pages/date-picker.argui"
import { AspectRatioPage } from "./pages/aspect-ratio.argui"
import { CollapsiblePage } from "./pages/collapsible.argui"
import { EmptyPage } from "./pages/empty.argui"
import { AvatarPage } from "./pages/avatar.argui"
import { BreadcrumbPage } from "./pages/breadcrumb.argui"
import { ProgressPage } from "./pages/progress.argui"
import { CheckboxPage } from "./pages/checkbox.argui"
import { RadioGroupPage } from "./pages/radio-group.argui"
import { TabsPage } from "./pages/tabs.argui"
import { AnimationLabPage } from "./pages/animation-lab.argui"
import { ScrollShadowPage } from "./pages/scroll-shadow.argui"
import { LiquidGlassPage } from "./pages/liquid-glass.argui"
import { DirectionPage } from "./pages/direction.argui"
import { DrawerPage } from "./pages/drawer.argui"
import { FieldPage } from "./pages/field.argui"
import { FilePickerPage } from "./pages/file-picker.argui"
import { HoverCardPage } from "./pages/hover-card.argui"
import { InputGroupPage } from "./pages/input-group.argui"
import { InputOtpPage } from "./pages/input-otp.argui"
import { ItemPage } from "./pages/item.argui"
import { MarkerPage } from "./pages/marker.argui"
import { TypographyPage } from "./pages/typography.argui"
import { ComboboxPage } from "./pages/combobox.argui"
import { ContextMenuPage } from "./pages/context-menu.argui"
import { DataTablePage } from "./pages/data-table.argui"
import { MessagePage } from "./pages/message.argui"
import { MessageScrollerPage } from "./pages/message-scroller.argui"
import { NativeSelectPage } from "./pages/native-select.argui"
import { KbdPage } from "./pages/kbd.argui"
import { LabelPage } from "./pages/label.argui"
import { SkeletonPage } from "./pages/skeleton.argui"
import { NavigationMenuPage } from "./pages/navigation-menu.argui"
import { QuestionnairePage } from "./pages/questionnaire.argui"
import { ScrollAreaPage } from "./pages/scroll-area.argui"
import { TextSelectionPage } from "./pages/text-selection.argui"
import { SheetPage } from "./pages/sheet.argui"
import { SidebarPage } from "./pages/sidebar.argui"
import { TogglePage } from "./pages/toggle.argui"
import { DialogPage } from "./pages/dialog.argui"
import { PopoverPage } from "./pages/popover.argui"
import { TooltipPage } from "./pages/tooltip.argui"
import { ChartPage } from "./pages/chart.argui"
import { ColorPickerPage } from "./pages/color-picker.argui"
import { PaginationPage } from "./pages/pagination.argui"
import { ToggleGroupPage } from "./pages/toggle-group.argui"
import { SelectPage } from "./pages/select.argui"
import { ListPage } from "./pages/list.argui"
import { TablePage } from "./pages/table.argui"
import { ToastPage } from "./pages/toast.argui"
import { MenubarPage } from "./pages/menubar.argui"
import { I18nPage } from "./pages/i18n.argui"
import { WebLayoutPage } from "./pages/web-layout.argui"
import { DragDropPage } from "./pages/drag-drop.argui"
import { EditingPage } from "./pages/editing.argui"
import { WebViewPage } from "./pages/webview.argui"
import { AnimatedTextPage } from "./pages/animated-text.argui"
import { AsyncTasksPage } from "./pages/async-tasks.argui"
import { SplitPanePage } from "./pages/split-pane.argui"
import { CustomTimelinePage } from "./pages/custom-timeline.argui"
import { DamageControlPage } from "./pages/damage-control.argui"
import { SliderPage } from "./pages/slider.argui"
import { InputPage } from "./pages/input.argui"
import { TextAreaPage } from "./pages/text-area.argui"
import { OverlaysPage } from "./pages/overlays.argui"
import { SelectionPage } from "./pages/selection.argui"
import { ScrollViewPage } from "./pages/scroll-view.argui"
import { ScrollbarStylingPage } from "./pages/scrollbar-styling.argui"
import { MenuPage } from "./pages/menu.argui"
import { CardPage } from "./pages/card.argui"
import { BadgePage } from "./pages/badge.argui"
import { SeparatorPage } from "./pages/separator.argui"
import { SwitchPage } from "./pages/switch.argui"
import { MediaPage } from "./pages/media.argui"
import { VisualCompositionPage } from "./pages/visual-composition.argui"
import { VirtualListPage } from "./pages/virtual-list.argui"

export component Main {
    callback request_file(mode: string) -> string
    callback request_search(query: string)
    callback cancel_search()
    in-out property file_result: string = "No selection yet."
    in-out property search_status: string = "Search 10,000 local drafts."
    in-out property search_results: model<string>
    in-out property search_loading: bool = false
    private property dark: bool = false
    private property accent: int = 0
    private property theme_open: bool = false
    out property selected: string = "Button"
    private property sidebar_offset: float = 0.0
    private property navigation: array<string> = [
        "COMPONENTS", "Accordion", "Alert", "Alert dialog", "Animated text", "Aspect ratio",
        "Attachment", "Avatar", "Badge", "Breadcrumb", "Bubble",
        "Button", "Button group", "Calendar", "Card", "Carousel",
        "Chart", "Checkbox", "Collapsible", "Color picker", "Combobox",
        "Context menu", "Data table", "Date picker", "Dialog", "Direction",
        "Drawer", "Empty", "Field", "File picker", "Hover card",
        "Input & Search", "Input group", "Input OTP", "Item", "Kbd",
        "Label", "List", "Marker", "Media", "Menu",
        "Menubar", "Message", "Message scroller", "Native select", "Navigation menu",
        "Overlays", "Pagination", "Popover", "Progress", "Questionnaire",
        "Radio group", "Scroll area", "ScrollView", "Select", "Selection",
        "Separator", "Sheet", "Sidebar", "Skeleton", "Slider",
        "Switch", "Table", "Tabs", "Text area", "Toast",
        "Toggle", "Toggle group", "Tooltip", "Visual composition", "VList",
        "EXAMPLES", "Animation lab", "Async tasks", "Custom Timeline", "Damage control",
        "Drag & Drop", "Editing & Password", "Internationalization", "Liquid glass",
        "Scroll shadow", "Scrollbar styling", "Split Pane", "Text selection",
        "Typography & selection", "Web layout", "WebView"
    ]

    Column #gallery {
        width: 100%
        height: 100%
        background: var(--argui-background)

        Row #topbar {
            width: 100%
            wrap: true
            padding: 18.0
            gap: 16.0
            background: var(--argui-surface)

            Column {
                width: 50%
                min_width: 0.0
                grow: 1.0
                gap: 2.0
                Text { content: "Widget Gallery" color: var(--argui-foreground) font_size: 21.0 weight: 700 }
                Text { content: "Argui DSL components" color: var(--argui-muted-foreground) font_size: 12.0 }
            }

            Container #theme_anchor {
                width: 210px
                Button #theme_select {
                    text: dark ? "Dark · appearance" : "Light · appearance"
                    variant: "outline"
                    select_trigger: true
                    expanded: theme_open
                    on click { theme_open = !theme_open }
                }
            }
        }

        Separator {}

        if theme_open {
            Popover #theme_popover {
                open: theme_open
                anchor: "theme_anchor"
                width: 222px
                on dismiss { theme_open = false }
                Column {
                    gap: 8.0
                    Text { content: "Appearance" color: var(--argui-foreground) weight: 700 font_size: 14.0 }
                    Row {
                        gap: 8.0
                        Button { text: "Light" variant: "outline" on click {
                            dark = false
                            theme_open = false
                            set_theme_mode(accent == 0 ? "light" : accent == 1 ? "light-violet" : "light-emerald")
                        } }
                        Button { text: "Dark" variant: "outline" on click {
                            dark = true
                            theme_open = false
                            set_theme_mode(accent == 0 ? "dark" : accent == 1 ? "dark-violet" : "dark-emerald")
                        } }
                    }
                    Separator {}
                    Text { content: "Accent" color: var(--argui-muted-foreground) font_size: 12.0 }
                    Row {
                        wrap: true
                        gap: 8.0
                        Button { text: "Blue" variant: "outline" on click {
                            accent = 0
                            theme_open = false
                            set_theme_mode(dark ? "dark" : "light")
                        } }
                        Button { text: "Violet" variant: "outline" on click {
                            accent = 1
                            theme_open = false
                            set_theme_mode(dark ? "dark-violet" : "light-violet")
                        } }
                        Button { text: "Emerald" variant: "outline" on click {
                            accent = 2
                            theme_open = false
                            set_theme_mode(dark ? "dark-emerald" : "light-emerald")
                        } }
                    }
                }
            }
        }

        Row #workspace {
            width: 100%
            grow: 1.0
            min_height: 0.0
            wrap: true

            Column #sidebar {
                width: 250px
                height: 100%
                min_width: 0.0
                min_height: 0.0
                grow: 1.0
                padding: 16.0
                background: var(--argui-surface)

                VirtualWindow #sidebar_list {
                    width: 100%
                    height: 100%
                    row_height: 38.0
                    overscan: 2
                    offset <=> sidebar_offset
                    scrollbar_thumb: var(--argui-scrollbar-thumb)
                    for item in navigation key item {
                        Container { width: 100% height: 38px
                            if item == "COMPONENTS" || item == "EXAMPLES" {
                                Text { y: 11px content: item color: var(--argui-muted-foreground) weight: 700 font_size: 11.0 }
                            }
                            if item != "COMPONENTS" && item != "EXAMPLES" {
                                Button { text: item height: 32px variant: selected == item ? "secondary" : "ghost" on click { selected = item } }
                            }
                        }
                    }
                }
            }

            Column #content {
                width: 65%
                height: 100%
                min_width: 0.0
                min_height: 0.0
                grow: 3.0
                padding: 30.0
                scroll_y: true
                scrollbar_thumb: var(--argui-scrollbar-thumb)
                background: var(--argui-background)

                if selected == "Button" { ButtonPage {} }
                if selected == "Accordion" { AccordionPage {} }
                if selected == "Alert" { AlertPage {} }
                if selected == "Alert dialog" { AlertDialogPage {} }
                if selected == "Attachment" { AttachmentPage {} }
                if selected == "Bubble" { BubblePage {} }
                if selected == "Button group" { ButtonGroupPage {} }
                if selected == "Carousel" { CarouselPage {} }
                if selected == "Calendar" { CalendarPage {} }
                if selected == "Date picker" { DatePickerPage {} }
                if selected == "Aspect ratio" { AspectRatioPage {} }
                if selected == "Collapsible" { CollapsiblePage {} }
                if selected == "Empty" { EmptyPage { on browse_components { selected = "Card" } } }
                if selected == "Direction" { DirectionPage {} }
                if selected == "Drawer" { DrawerPage {} }
                if selected == "Field" { FieldPage {} }
                if selected == "File picker" { FilePickerPage { host_status: file_result on request_file(mode) { return request_file(mode) } } }
                if selected == "Hover card" { HoverCardPage {} }
                if selected == "Input group" { InputGroupPage {} }
                if selected == "Input OTP" { InputOtpPage {} }
                if selected == "Item" { ItemPage {} }
                if selected == "Marker" { MarkerPage {} }
                if selected == "Combobox" { ComboboxPage {} }
                if selected == "Context menu" { ContextMenuPage {} }
                if selected == "Data table" { DataTablePage {} }
                if selected == "Message" { MessagePage {} }
                if selected == "Message scroller" { MessageScrollerPage {} }
                if selected == "Native select" { NativeSelectPage {} }
                if selected == "Kbd" { KbdPage {} }
                if selected == "Label" { LabelPage {} }
                if selected == "Skeleton" { SkeletonPage {} }
                if selected == "Navigation menu" { NavigationMenuPage {} }
                if selected == "Questionnaire" { QuestionnairePage {} }
                if selected == "Scroll area" { ScrollAreaPage {} }
                if selected == "Sheet" { SheetPage {} }
                if selected == "Sidebar" { SidebarPage {} }
                if selected == "Toggle" { TogglePage {} }
                if selected == "Dialog" { DialogPage {} }
                if selected == "Popover" { PopoverPage {} }
                if selected == "Tooltip" { TooltipPage {} }
                if selected == "Chart" { ChartPage {} }
                if selected == "Color picker" { ColorPickerPage {} }
                if selected == "Pagination" { PaginationPage {} }
                if selected == "Toggle group" { ToggleGroupPage {} }
                if selected == "Select" { SelectPage {} }
                if selected == "List" { ListPage {} }
                if selected == "Table" { TablePage {} }
                if selected == "Toast" { ToastPage {} }
                if selected == "Menubar" { MenubarPage {} }
                if selected == "Avatar" { AvatarPage {} }
                if selected == "Breadcrumb" { BreadcrumbPage {} }
                if selected == "Progress" { ProgressPage {} }
                if selected == "Checkbox" { CheckboxPage {} }
                if selected == "Radio group" { RadioGroupPage {} }
                if selected == "Tabs" { TabsPage {} }
                if selected == "Slider" { SliderPage {} }
                if selected == "Input & Search" { InputPage {} }
                if selected == "Text area" { TextAreaPage {} }
                if selected == "Overlays" { OverlaysPage {} }
                if selected == "Selection" { SelectionPage {} }
                if selected == "Menu" { MenuPage {} }
                if selected == "ScrollView" { ScrollViewPage {} }
                if selected == "Scrollbar styling" { ScrollbarStylingPage {} }
                if selected == "Animation lab" { AnimationLabPage {} }
                if selected == "Scroll shadow" { ScrollShadowPage {} }
                if selected == "Liquid glass" { LiquidGlassPage {} }
                if selected == "Typography & selection" { TypographyPage {} }
                if selected == "Text selection" { TextSelectionPage {} }
                if selected == "Internationalization" { I18nPage {} }
                if selected == "Web layout" { WebLayoutPage {} }
                if selected == "Drag & Drop" { DragDropPage {} }
                if selected == "Editing & Password" { EditingPage {} }
                if selected == "WebView" { WebViewPage {} }
                if selected == "Animated text" { AnimatedTextPage {} }
                if selected == "Async tasks" { AsyncTasksPage {
                    status: search_status
                    results: search_results
                    loading: search_loading
                    on request_search(query) { request_search(query) }
                    on cancel_search { cancel_search() }
                } }
                if selected == "Split Pane" { SplitPanePage {} }
                if selected == "Custom Timeline" { CustomTimelinePage {} }
                if selected == "Damage control" { DamageControlPage {} }
                if selected == "Card" { CardPage {} }
                if selected == "Badge" { BadgePage {} }
                if selected == "Separator" { SeparatorPage {} }
                if selected == "Switch" { SwitchPage {} }
                if selected == "Media" { MediaPage {} }
                if selected == "Visual composition" { VisualCompositionPage {} }
                if selected == "VList" { VirtualListPage {} }
            }
        }
    }
}
