import { Button, Column, Text, Dialog, Input } from "@argui/ui"
import { TouchArea, Grid, Container, VirtualWindow } from "@argui/native"

export component Conformance {
    out property count: int = 2
    out property precision: float = 16777216.0 + 1.0
    out property exact: bool = 9223372036854775806 < 9223372036854775807
    out property ratio: float = 1
    out property optional: optional<float> = 2
    out property conditional: float = true ? 1 : 2.5
    out property label: string = "start"
    private property skipped: bool = false
    callback probe() -> bool

    Column {
        Button {
            text: "Run"
            on click {
                skipped = false && probe()
                skipped = true || probe()
                skipped = true ? true : probe()
                count += count
                ratio = count
                ratio += 1
                label += "!"
            }
        }
        Text { content: str(precision) + ":" + str(exact) }
        Text { content: str(count) + ":" + str(ratio) + ":" + label }
    }
}

component Counter {
    in property name: string
    private property count: int = 0
    Button { text: name + ":" + str(count) on click { count += 1 } }
}

export component KeyedRows {
    private property groups: array<int> = [1, 2]
    Column {
        Button { text: "Reverse" on click { groups = [2, 1] } }
        for group in groups key group {
            for row in [1, 2] key row {
                Counter { name: str(group) + str(row) }
            }
        }
    }
}

style SharedText for Text { content: "styled" }
style HoverText for Text {
    content: "rest"
    hover { content: "hovered" }
}
export component Styled {
    Column {
        Text { style: SharedText }
        Text { style: SharedText content: "inline" }
        Text #hover { style: HoverText }
    }
}

export theme CascadeTheme {
    --cascade-base: string = "base-light"
    --cascade-hover: string = "hover-light"
    dark {
        --cascade-base: "base-dark"
        --cascade-hover: "hover-dark"
    }
}
style CascadeText for Text {
    content: var(--cascade-base)
    hover { content: var(--cascade-hover) }
}
export component StyleCascade {
    private property chosen: bool = false
    Column {
        Button { text: "Choose state" on click { chosen = true } }
        Button { text: "Switch theme" on click { set_theme_mode("dark") } }
        Text #token { style: CascadeText }
        Text #layered {
            style: CascadeText
            content: "inline"
            states { chosen when chosen { content: "authored" } }
        }
    }
}

component MultiSlot {
    slot header { Text { content: "default header" } }
    slot body
    slot actions { Text { content: "default actions" } }
    Column { header body actions }
}
component ForwardSlots {
    slot header
    slot body
    slot actions
    MultiSlot {
        slot header { header }
        slot body { body }
        slot actions { actions }
    }
}
export component NamedSlots {
    private property count: int = 0
    Column {
        ForwardSlots {
            slot header { Text { content: "supplied header" } }
            slot body { Text { content: "body:" + str(count) } }
            slot actions { Button { text: "Add from slot" on click { count += 1 } } }
        }
        MultiSlot {}
    }
}
export component Playback {
    private property running: bool = true
    private property phase: float = 0.0
    animate phase { from: 0.0 to: 1.0 duration: 1000ms iterations: "infinite" playing: running }
    Column {
        Button { text: running ? "Pause" : "Resume" on click { running = !running } }
        Text #phase { content: str(phase) }
    }
}

export component Retained {
    private property count: int = 0
    Column {
        Text #unchanged { content: "Unchanged" }
        Button { text: "Increment" on click { count += 1 } }
        Text { content: str(count) }
    }
}

export component StyledRows {
    Column {
        for row in [1, 2] key row {
            Text { style: HoverText content: str(row) }
        }
    }
}

export component OuterObservation {
    Column {
        TouchArea #outer { width: 120px height: 30px }
        for row in [1, 2] key row {
            Text { content: (outer.has_hover ? "inside:" : "outside:") + str(row) }
        }
    }
}

component RowOutput {
    in property value: int
    out property doubled: int = value * 2
}

export component LexicalRows {
    Column {
        for item in [1, 2] key item {
            RowOutput #child { value: item }
            Text { content: str(child.doubled) }
        }
    }
}

component ConditionalOutput {
    out property label: string = "present"
}

export component OptionalChild {
    private property shown: bool = false
    Column {
        Button { text: "Toggle" on click { shown = !shown } }
        if shown { ConditionalOutput #child {} }
        Text { content: child.label == null ? "missing" : "present" }
    }
}

export component LayoutProof {
    Grid #dashboard {
        width: 600px
        height: 240px
        grid_columns: "100px 2fr"
        grid_rows: "40px 1fr"
        column_gap: 8.0
        row_gap: 6.0
        padding_left: 12.0
        padding_top: 10.0
        Container #heading {
            grid_column_start: 1
            grid_column_span: 2
            Text { content: "Dashboard" }
        }
        Container #sidebar {
            grid_row_start: 2
            grid_column_start: 1
            Text { content: "Navigation" }
        }
        Container #content {
            grid_row_start: 2
            grid_column_start: 2
            Text { content: "Content" }
        }
    }
}

export component ResponsiveForm {
    Grid #form {
        width: 100%
        grid_columns: "1fr"
        query_scope: "form"
        query_min_width: 520.0
        query_columns: "1fr 1fr"
        column_gap: 16.0
        Container #first { Text { content: "First field" } }
        Container #second { Text { content: "Second field" } }
    }
}

export component Indexed {
    private property items: array<int> = [7, 8]
    Column {
        Text { content: items[0] == null ? "bad" : "first present" }
        Text { content: items[9] == null ? "out of bounds" : "bad" }
        Text { content: items[-1] == null ? "negative missing" : "bad" }
        Text { content: str(unwrap_or(items[0], 0)) + ":" + str(unwrap_or(items[9], 99)) }
        Text { content: is_some(items[0]) && !is_some(items[9]) ? "optionals work" : "bad" }
    }
}

export component HandlerLocals {
    private property count: int = 0
    Column {
        Button {
            text: "Advance"
            on click {
                let next = count + 1
                if next > 1 {
                    let step = 3
                    next += step
                    count = next
                } else {
                    count = next
                }
            }
        }
        Text { content: str(count) }
    }
}

struct Pair {
    left: int
    right: string
}

export component StructValues {
    private property pair: Pair = Pair { left: 7, right: "seven" }
    Column {
        Text { content: str(pair.left) + ":" + pair.right }
    }
}

enum Stage { Ready Waiting }

export component EnumValues {
    private property stage: Stage = Stage.Ready
    Column {
        Button { text: "Change" on click { stage = Stage.Waiting } }
        Text { content: stage == Stage.Ready ? "ready" : "waiting" }
    }
}

export component DialogSlotsProof {
    Dialog {
        open: true
        slot header { Text { content: "Custom heading" } }
        slot body { Text { content: "Custom body" } }
        slot actions { Button { text: "Custom action" } }
    }
}

export component InputSlotsProof {
    Input {
        label: "Email"
        slot leading { Text { content: "Leading" } }
        slot trailing { Text { content: "Trailing" } }
        slot error { Text { content: "Validation error" } }
    }
}

export component EditableModel {
    in-out property rows: model<string>
    private property offset: float = 0.0
    VirtualWindow #table {
        offset <=> offset
        row_height: 20.0
        viewport_height: 120.0
        overscan: 1
        for row in rows key row {
            Text { content: row }
        }
    }
}

export component RichRows {
    in-out property rows: model<string>
    private property offset: float = 0.0
    VirtualWindow #rich_rows {
        offset <=> offset
        row_height: 20.0
        viewport_height: 120.0
        variable_height: true
        overscan: 1
        for row in rows key row {
            Column {
                Text { content: row }
                Text { content: "detail" }
            }
        }
    }
}

export component MeasuredContainer {
    Column {
        Container #probe { width: 200px height: 44px }
        Text { content: probe.measured_width == 200px && probe.measured_height == 44px ? "measured" : "missing" }
    }
}

export component HostSlots {
    slot header { Text { content: "fallback header" } }
    Column { header }
}

fn twice(value: int) -> int = value * 2
fn combine(value: int) -> int = twice(value) + 1

export component PureFunctions {
    private property value: int = 3
    Column {
        Button { text: "Advance pure" on click { value = value + 1 } }
        Text { content: "pure:" + str(combine(value)) }
    }
}
