import { VirtualList, Separator } from "@argui/ui"
import { Column, Row, Text } from "@argui/native"

export component Main {
    in property entries: array<string> = [
        "Record 00001", "Record 00002", "Record 00003", "Record 00004",
        "Record 00005", "Record 00006", "Record 00007", "Record 00008",
        "Record 00009", "Record 00010", "Record 00011", "Record 00012",
        "Record 00013", "Record 00014", "Record 00015", "Record 00016",
        "Record 00017", "Record 00018", "Record 00019", "Record 00020",
        "Record 00021", "Record 00022", "Record 00023", "Record 00024"
    ]
    private property list_offset: float = 0.0

    Column #app {
        width: 100%
        height: 100%
        min_height: 0.0
        padding: 24.0
        gap: 12.0
        background: var(--argui-background)

        Text { content: "Virtual list · DSL" color: var(--argui-foreground) font_size: 23.0 weight: 700 }
        Text { content: "The row template is authored here; VirtualList.argui mounts only the visible window." color: var(--argui-muted-foreground) font_size: 13.0 }
        Separator {}

        VirtualList #records {
            row_height: 44.0
            overscan: 3
            offset <=> list_offset
            scrollbar_thumb: var(--argui-scrollbar-thumb)
            for entry in entries key entry {
                Row {
                    width: 100%
                    height: 44px
                    padding: 10.0
                    background: var(--argui-surface)
                    Text { content: entry color: var(--argui-foreground) font_size: 14.0 }
                }
            }
        }
    }
}
