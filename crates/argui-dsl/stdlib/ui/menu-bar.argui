import { FocusScope, KeyBinding, Rectangle, Row } from "@argui/native"

export component MenuBar {
    in property label: string = "Menu bar"
    in property height: length = 44px
    slot content

    FocusScope {
        role: "menu_bar"
        accessible_name: label
        KeyBinding { shortcut: "ArrowRight" on activated { focus_next() } }
        KeyBinding { shortcut: "ArrowLeft" on activated { focus_previous() } }
        Rectangle {
            width: 100%
            background: solid(var(--argui-surface))
            border_color: var(--argui-border)
            border_width: 1.0
            radius: 8.0
            Row {
                width: 100%
                height: height
                padding: 4.0
                gap: 3.0
                align_items: "center"
                content
            }
        }
    }
}
