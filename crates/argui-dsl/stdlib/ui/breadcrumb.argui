import { Button } from "@argui/ui"
import { Row, Text } from "@argui/native"

export component Breadcrumb {
    in property links: array<string> = []
    in property current: string
    in property separator: string = "/"
    in property label: string = "Breadcrumb"
    callback activate(link: string)

    Row {
        tooltip: label
        wrap: true
        gap: 4.0
        align_items: "center"

        for link in links key link {
            Button {
                text: link
                variant: "ghost"
                text_color: var(--argui-muted-foreground)
                height: 30px
                padding: 6.0
                on click { activate(link) }
            }
            Text { content: separator color: var(--argui-muted-foreground) font_size: 14.0 }
        }
        Text { content: current color: var(--argui-foreground) weight: 600 font_size: 14.0 }
    }
}
