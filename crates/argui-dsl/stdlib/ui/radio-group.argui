import { Column, FocusScope, KeyBinding, Rectangle, Row, Text, TouchArea } from "@argui/native"
import { Circle, CircleDotFilled } from "@argui/icons"

export component RadioGroup {
    in property label: string
    in property options: array<string> = []
    in-out property value: string = ""
    in property enabled: bool = true
    callback changed(value: string)

    FocusScope {
        role: "group"
        accessible_name: label
        enabled: enabled
        focus_on_tab_navigation: false
        focus_on_click: false
        KeyBinding { shortcut: "ArrowDown" on activated { focus_next() } }
        KeyBinding { shortcut: "ArrowUp" on activated { focus_previous() } }

        Column {
            gap: 10.0
            for option in options key option {
                FocusScope {
                    role: "radio_button"
                    accessible_name: option
                    checked: value == option
                    enabled: enabled
                    keyboard_activation: "enter_or_space"
                    on click {
                        value = option
                        changed(value)
                    }
                    on focus {
                        value = option
                        changed(value)
                    }
                    TouchArea {
                        enabled: enabled
                        mouse_cursor: enabled ? "pointer" : "not_allowed"
                        Row {
                            gap: 9.0
                            padding: 6.0
                            align_items: "center"
                            Rectangle {
                                width: 18px
                                height: 18px
                                radius: 9.0
                                border_color: #00000000
                                border_width: 0.0
                                Rectangle { x: 0px y: 0px width: 18px height: 18px
                                    Circle { size: 18px color: var(--argui-border) opacity: 1.0 states { selected when value == option { opacity: 0.0 } } animate opacity { transition: in-out duration: 150ms } }
                                }
                                Rectangle { x: 0px y: 0px width: 18px height: 18px
                                    CircleDotFilled { size: 18px color: var(--argui-primary) opacity: 0.0 states { selected when value == option { opacity: 1.0 } } animate opacity { transition: in-out duration: 150ms } }
                                }
                            }
                            Text { content: option color: enabled ? var(--argui-foreground) : var(--argui-muted-foreground) font_size: 14.0 }
                        }
                    }
                }
            }
        }
    }
}
