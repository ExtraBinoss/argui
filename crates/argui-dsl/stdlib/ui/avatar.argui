import { Rectangle, Row, Text } from "@argui/native"

export component Avatar {
    in property name: string
    in property initials: string
    in property size: float = 40.0
    in property portrait: bool = false

    Rectangle {
        width: size * 1px
        height: size * 1px
        tooltip: name
        radius: size / 2.0
        clip: true
        background: solid(portrait ? var(--argui-primary) : var(--argui-muted))
        border_color: var(--argui-border)
        border_width: 1.0

        if portrait {
            Rectangle {
                x: size * 0.33 * 1px
                y: size * 0.16 * 1px
                width: size * 0.34 * 1px
                height: size * 0.34 * 1px
                radius: size * 0.17
                background: solid(var(--argui-primary-foreground))
            }
            Rectangle {
                x: size * 0.15 * 1px
                y: size * 0.56 * 1px
                width: size * 0.7 * 1px
                height: size * 0.5 * 1px
                radius: size * 0.22
                background: solid(var(--argui-primary-foreground))
            }
        }
        if !portrait {
            Row {
                width: size * 1px
                height: size * 1px
                align_items: "center"
                justify_content: "center"
                Text {
                    content: initials
                    color: var(--argui-foreground)
                    weight: 600
                    font_size: size * 0.38
                    no_wrap: true
                }
            }
        }
    }
}
