import { VList } from "@argui/native"

export component VirtualList {
    in property row_height: float
    in property overscan: int = 3
    in-out property offset: float = 0.0
    in property grow: float = 1.0
    in property scrollbar_thumb: color = var(--argui-scrollbar-thumb)
    in property edge_shadow_width: float = 0.0
    in property edge_shadow_intensity: float = 0.15
    in property edge_shadow_color: color = var(--argui-foreground)
    slot rows: template

    VList #virtual_viewport {
        width: 100%
        min_height: 0.0
        grow: grow
        row_height: row_height
        overscan: overscan
        offset <=> offset
        scrollbar_thumb: scrollbar_thumb
        edge_shadow_width: edge_shadow_width
        edge_shadow_intensity: edge_shadow_intensity
        edge_shadow_color: edge_shadow_color
        rows
    }
}
