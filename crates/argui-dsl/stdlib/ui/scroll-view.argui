import { Container, Column, Flickable, Rectangle, TouchArea } from "@argui/native"

export component ScrollView {
    in property width: length = 280px
    in property height: length = 220px
    in property enabled: bool = true
    in property show_scrollbar: bool = true
    in property show_edge_shadows: bool = false
    in property scrollbar_color: color = var(--argui-scrollbar-thumb)
    in property scrollbar_hover_color: color = var(--argui-primary)
    in property scrollbar_track_color: color = #00000000
    in property scrollbar_width: length = 12px
    in property scrollbar_thumb_width: length = 6px
    in property scrollbar_radius: float = 3.0
    in property edge_shadow_color: color = var(--argui-foreground)
    in property edge_shadow_width: length = 20px
    in property edge_shadow_intensity: float = 0.16
    out property offset_y: length = viewport.offset_y
    private property scrollbar_dragging: bool = false
    callback scrolled(offset: float)
    slot content

    Container {
        width: width
        height: height

        Flickable #viewport {
            width: show_scrollbar ? width - scrollbar_width : width
            height: 100%
            enabled: enabled
            on scroll(next) { scrolled(next) }
            Column {
                width: 100%
                shrink: 0.0
                content
            }
        }

        if show_scrollbar && viewport.content_height > viewport.viewport_height {
            TouchArea #scrollbar_drag {
                x: width - scrollbar_width
                y: 0px
                width: scrollbar_width
                height: viewport.viewport_height
                enabled: enabled
                mouse_cursor: "pointer"
                on pointer_down {
                    scrollbar_dragging = true
                    scroll_to(#viewport, 0px, (scrollbar_drag.mouse_y - viewport.viewport_height / viewport.content_height * viewport.viewport_height / 2.0) / (viewport.viewport_height - viewport.viewport_height / viewport.content_height * viewport.viewport_height) * (viewport.content_height - viewport.viewport_height))
                }
                on moved {
                    scroll_to(#viewport, 0px, scrollbar_dragging ? (scrollbar_drag.mouse_y - viewport.viewport_height / viewport.content_height * viewport.viewport_height / 2.0) / (viewport.viewport_height - viewport.viewport_height / viewport.content_height * viewport.viewport_height) * (viewport.content_height - viewport.viewport_height) : viewport.offset_y)
                }
                on pointer_up { scrollbar_dragging = false }
                on pointer_cancel { scrollbar_dragging = false }
                Rectangle {
                    width: scrollbar_width
                    height: viewport.viewport_height
                    radius: scrollbar_radius
                    background: solid(scrollbar_track_color)
                }
                Rectangle {
                    x: (scrollbar_width - scrollbar_thumb_width) / 2.0
                    y: viewport.offset_y / (viewport.content_height - viewport.viewport_height) * (viewport.viewport_height - viewport.viewport_height / viewport.content_height * viewport.viewport_height)
                    width: scrollbar_thumb_width
                    height: viewport.viewport_height / viewport.content_height * viewport.viewport_height
                    radius: scrollbar_radius
                    background: solid(scrollbar_drag.has_hover ? scrollbar_hover_color : scrollbar_color)
                }
            }
        }

        if show_edge_shadows {
            Rectangle {
                y: 0px
                width: show_scrollbar ? width - scrollbar_width : width
                height: edge_shadow_width
                background: linear_gradient([edge_shadow_color, edge_shadow_color, #00000000], [0.0, 0.12, 1.0], 90.0, "srgb")
                opacity: viewport.offset_y > 0px ? edge_shadow_intensity : 0.0
            }
            Rectangle {
                y: height - edge_shadow_width
                width: show_scrollbar ? width - scrollbar_width : width
                height: edge_shadow_width
                background: linear_gradient([#00000000, edge_shadow_color, edge_shadow_color], [0.0, 0.88, 1.0], 90.0, "srgb")
                opacity: viewport.offset_y < viewport.content_height - viewport.viewport_height ? edge_shadow_intensity : 0.0
            }
        }
    }
}
