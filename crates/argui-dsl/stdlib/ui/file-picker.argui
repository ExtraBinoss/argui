import { Button } from "@argui/ui/button.argui"
import { Column, FocusScope, Text } from "@argui/native"

export component FilePicker {
    in property label: string
    in property mode: string
    in property status: string = "No selection yet."
    in property selected_files: array<string> = []
    in property enabled: bool = true
    callback request(mode: string)

    Column {
        gap: 8.0
        Button { text: label variant: "outline" enabled: enabled on click { request(mode) } }
        FocusScope {
            role: "status"
            accessible_name: status
            focus_on_tab_navigation: false
            focus_on_click: false
            Text { content: status color: var(--argui-muted-foreground) font_size: 13.0 }
        }
        for file in selected_files key file {
            Text { content: file color: var(--argui-foreground) font_size: 13.0 }
        }
    }
}
