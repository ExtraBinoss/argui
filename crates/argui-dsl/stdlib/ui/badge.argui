import { Row, Text } from "@argui/native"

export component Badge {
    in property text: string
    in property variant: string = "secondary"

    Row {
        background: variant == "primary" ? var(--argui-primary) : variant == "outline" ? var(--argui-surface) : var(--argui-muted)
        border_color: variant == "outline" ? var(--argui-border) : variant == "primary" ? var(--argui-primary) : var(--argui-muted)
        radius: 6.0
        padding: 6.0
        Text {
            content: text
            color: variant == "primary" ? var(--argui-primary-foreground) : var(--argui-foreground)
            weight: 600
            font_size: 12.0
            no_wrap: true
        }
    }
}
