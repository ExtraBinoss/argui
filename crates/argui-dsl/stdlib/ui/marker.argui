import { Column, Container, Row, Text } from "@argui/native"

export component Marker {
    in property text: string
    in property variant: string = "inline"

    Column { width: 100%
        if variant == "separator" {
            Row { width: 100% gap: 10.0 align_items: "center"
                Container { height: 1px grow: 1.0 background: var(--argui-border) }
                Text { content: text color: var(--argui-muted-foreground) font_size: 13.0 no_wrap: true }
                Container { height: 1px grow: 1.0 background: var(--argui-border) }
            }
        }
        if variant != "separator" {
            Column { width: 100% gap: 4.0
                Row { padding: 8.0
                    Text { content: text color: var(--argui-muted-foreground) font_size: 13.0 }
                }
                if variant == "border" {
                    Container { width: 100% height: 1px background: var(--argui-border) }
                }
            }
        }
    }
}
