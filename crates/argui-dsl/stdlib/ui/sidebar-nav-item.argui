import { FocusScope, Rectangle, Row, Text, TouchArea } from "@argui/native"

export component SidebarNavItem {
    in property label: string
    in property collapsed: bool = false
    in property selected: bool = false
    in property enabled: bool = true
    callback click()
    slot icon

    FocusScope #focus_area {
        role: "button"
        accessible_name: label
        enabled: enabled
        keyboard_activation: "enter_or_space"
        on click { click() }
        TouchArea #touch {
            width: collapsed ? 44px : 220px
            height: 42px
            enabled: enabled
            mouse_cursor: enabled ? "pointer" : "not_allowed"
            Rectangle {
                width: collapsed ? 44px : 220px
                height: 42px
                radius: 8.0
                background: solid(selected ? var(--argui-selection) : touch.has_hover ? var(--argui-muted) : var(--argui-surface))
                border_color: focus_area.focus_visible ? var(--argui-ring) : #00000000
                border_width: focus_area.focus_visible ? 2.0 : 0.0
                Row {
                    width: 100%
                    height: 100%
                    padding: collapsed ? 11.0 : 12.0
                    gap: 12.0
                    align_items: "center"
                    icon
                    if !collapsed {
                        Text { content: label color: selected ? var(--argui-primary) : var(--argui-foreground) weight: selected ? 600 : 500 font_size: 14.0 }
                    }
                }
            }
        }
    }
}
