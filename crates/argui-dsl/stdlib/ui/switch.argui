import { FocusScope, TouchArea, Rectangle, Row, Text } from "@argui/native"

export component Switch {
    in property label: string
    in property checked: bool = false
    in property enabled: bool = true
    callback click()

    FocusScope #focus_area {
        enabled: enabled
        keyboard_activation: "enter_or_space"
        role: "switch"
        accessible_name: label
        checked: checked
        on click { click() }

        TouchArea #touch {
            enabled: enabled
            mouse_cursor: enabled ? "pointer" : "not_allowed"
            Row {
                gap: 12.0
                align_items: "center"
                Text { content: label color: enabled ? var(--argui-foreground) : var(--argui-muted-foreground) font_size: 14.0 }
                Rectangle {
                    width: 40px
                    height: 24px
                    radius: 12.0
                    background: solid(!enabled ? var(--argui-muted) : checked ? var(--argui-primary) : var(--argui-neutral-pressed))
                    border_color: focus_area.focus_visible ? var(--argui-ring) : checked ? var(--argui-primary) : var(--argui-border)
                    border_width: focus_area.focus_visible ? 2.0 : 1.0
                    Rectangle {
                        x: 3px
                        y: 3px
                        width: 18px
                        height: 18px
                        radius: 9.0
                        background: solid(enabled ? #ffffff : var(--argui-muted-foreground))
                        states { active when checked { x: 19px } }
                        animate x { transition: in-out duration: 180ms }
                    }
                }
            }
        }
    }
}
