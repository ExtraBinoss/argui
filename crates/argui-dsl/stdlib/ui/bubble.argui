import { Column, Container, Rectangle, Row, Text } from "@argui/native"

export component ConversationBubble {
    in property variant: string = "secondary"
    in property end: bool = false
    slot content

    Row {
        width: 100%
        if end { Container { grow: 1.0 } }
        Rectangle {
            width: 80%
            background: solid(variant == "tinted" ? var(--argui-selection) : variant == "outline" ? var(--argui-surface) : var(--argui-muted))
            border_color: variant == "outline" ? var(--argui-border) : variant == "tinted" ? var(--argui-ring) : var(--argui-muted)
            border_width: variant == "outline" ? 1.0 : 0.0
            radius: 16.0
            Column {
                width: 100%
                padding: 13.0
                gap: 8.0
                content
            }
        }
        if !end { Container { grow: 1.0 } }
    }
}
