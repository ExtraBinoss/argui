import { FocusScope, PopupWindow, Rectangle, Row, Text, TouchArea } from "@argui/native"

export component Tooltip {
    in property label: string
    in property description: string
    in property anchor: string
    in property width: length = 236px
    in property surface_fill: brush = solid(var(--argui-surface))
    in property border_color: color = var(--argui-border)
    in property backdrop_filter: string = "none"
    private property open: bool = false
    private property hovered: bool = false
    private property focused: bool = false
    callback click()

    FocusScope #trigger {
        role: "button"
        accessible_name: label
        keyboard_activation: "enter_or_space"
        on focus { focused = true open = true }
        on blur { focused = false open = hovered }
        on click { click() }
        TouchArea #touch {
            mouse_cursor: "pointer"
            on pointer_enter { hovered = true open = true }
            on pointer_leave { hovered = false open = focused }
            Rectangle {
                background: solid(touch.pressed ? var(--argui-neutral-pressed) : touch.has_hover ? var(--argui-muted) : var(--argui-surface))
                border_color: trigger.focus_visible ? var(--argui-ring) : var(--argui-border)
                border_width: trigger.focus_visible ? 2.0 : 1.0
                radius: 7.0
                Row { padding: 12.0 Text { content: label color: var(--argui-foreground) font_size: 14.0 weight: 600 } }
            }
        }
    }

    PopupWindow {
        visible: open
        anchor: anchor
        placement: "bottom_start"
        dismiss_policy: "escape"
        width: width
        initial_focus: ""
        restore_focus: false
        on dismiss { open = false }
        FocusScope {
            role: "tooltip"
            accessible_name: description
            focus_on_tab_navigation: false
            focus_on_click: false
            Rectangle {
                width: width
                background: surface_fill
                border_color: border_color
                border_width: 1.0
                backdrop_filter: backdrop_filter
                radius: 6.0
                shadow_blur: 10.0
                shadow_offset_y: 4.0
                shadow_color: #00000024
                Row { width: 100% padding: 10.0
                    Text { width: width - 20px content: description color: var(--argui-foreground) font_size: 14.0 }
                }
            }
        }
    }
}
