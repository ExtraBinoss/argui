import { FocusScope, KeyBinding, TouchArea } from "@argui/native"

export component ContextMenuTrigger {
    in-out property open: bool = false
    in-out property pointer_x: length = 0px
    in-out property pointer_y: length = 0px
    in property label: string = "Context menu"
    slot content

    FocusScope {
        role: "button"
        accessible_name: label
        keyboard_activation: "enter_or_space"
        expandable: true
        expanded: open
        on click { open = true }
        KeyBinding { shortcut: "Shift+F10" on activated { open = true } }
        KeyBinding { shortcut: "ContextMenu" on activated { open = true } }
        TouchArea #touch {
            mouse_cursor: "context_menu"
            on click {
                pointer_x = touch.mouse_x
                pointer_y = touch.mouse_y
                open = true
            }
            on context_menu {
                pointer_x = touch.mouse_x
                pointer_y = touch.mouse_y
                open = true
            }
            content
        }
    }
}
