import { Column, Container, FocusScope, Rectangle, Row, Text, TextInput, TouchArea } from "@argui/native"

export component ButtonGroup {
    in property label: string
    in property vertical: bool = false
    in property width: length = 360px
    slot content

    FocusScope {
        role: "group"
        accessible_name: label
        Rectangle {
            width: width
            background: solid(var(--argui-surface))
            border_color: var(--argui-border)
            border_width: 1.0
            radius: 8.0
            clip: true
            if vertical {
                Column { width: 100% content }
            }
            if !vertical {
                Row { width: 100% content }
            }
        }
    }
}

export component GroupAction {
    in property text: string
    in property show_text: bool = true
    in property selected: bool = false
    in property enabled: bool = true
    in property height: length = 38px
    in property padding: float = 12.0
    callback click()
    slot content

    FocusScope #focus_area {
        enabled: enabled
        keyboard_activation: "enter_or_space"
        role: "button"
        accessible_name: text
        checked: selected
        on click { click() }
        TouchArea #touch {
            enabled: enabled
            mouse_cursor: enabled ? "pointer" : "not_allowed"
            Rectangle {
                background: solid(!enabled ? var(--argui-muted) : touch.pressed ? var(--argui-neutral-pressed) : selected ? var(--argui-selection) : touch.has_hover ? var(--argui-muted) : var(--argui-surface))
                border_color: focus_area.focus_visible ? var(--argui-ring) : var(--argui-surface)
                border_width: focus_area.focus_visible ? 2.0 : 0.0
                Row {
                    height: height
                    padding: padding
                    gap: 6.0
                    align_items: "center"
                    justify_content: "center"
                    content
                    if show_text {
                        Text { content: text color: enabled ? var(--argui-foreground) : var(--argui-muted-foreground) weight: selected ? 700 : 500 font_size: 14.0 no_wrap: true }
                    }
                }
            }
        }
    }
}

export component GroupInput {
    in-out property value: string = ""
    in property label: string
    in property placeholder: string = ""
    callback submit(value: string)

    Row {
        height: 38px
        padding: 10.0
        min_width: 0.0
        align_items: "center"
        TextInput {
            width: 100%
            value <=> value
            label: label
            placeholder: placeholder
            text_color: var(--argui-foreground)
            placeholder_color: var(--argui-muted-foreground)
            caret_fill: solid(var(--argui-primary))
            on submit { submit(value) }
        }
    }
}

export component GroupSeparator {
    in property vertical: bool = false
    in property height: length = 38px

    if vertical {
        Container { width: 100% height: 1px background: var(--argui-border) }
    }
    if !vertical {
        Container { width: 1px height: height background: var(--argui-border) }
    }
}
