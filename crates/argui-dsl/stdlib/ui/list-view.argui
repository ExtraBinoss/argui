import { Container, Row, VirtualWindow, Rectangle, TouchArea } from "@argui/native"

export component ListView {
    in property row_height: float
    in property viewport_height: length = 360px
    in property overscan: int = 3
    in-out property offset: float = 0.0
    in property grow: float = 1.0
    in property scrollbar_thumb: color = var(--argui-scrollbar-thumb)
    in property scrollbar_hover: color = var(--argui-primary)
    in property scrollbar_track: color = #00000000
    in property scrollbar_width: length = 12px
    in property edge_shadow_width: float = 0.0
    in property edge_shadow_intensity: float = 0.15
    in property edge_shadow_color: color = var(--argui-foreground)
    private property thumb_height: length =
        virtual_viewport.visible_height <= 24px ? virtual_viewport.visible_height :
        virtual_viewport.content_height <= virtual_viewport.visible_height ? virtual_viewport.visible_height :
        virtual_viewport.visible_height / virtual_viewport.content_height * virtual_viewport.visible_height < 24px ? 24px :
        virtual_viewport.visible_height / virtual_viewport.content_height * virtual_viewport.visible_height
    slot rows: template

    Container {
        width: 100%
        height: viewport_height
        min_height: 0.0
        grow: grow

        Row {
            width: 100%
            height: viewport_height
            VirtualWindow #virtual_viewport {
                width: 100%
                height: viewport_height
                row_height: row_height
                viewport_height: viewport_height / 1px
                overscan: overscan
                offset <=> offset
                rows
            }

        if virtual_viewport.content_height > virtual_viewport.visible_height {
            TouchArea #scrollbar_drag {
                width: scrollbar_width
                height: virtual_viewport.visible_height
                mouse_cursor: "pointer"
                on pointer_down {
                    offset = virtual_viewport.visible_height > thumb_height ? ((scrollbar_drag.mouse_y - thumb_height / 2.0) / (virtual_viewport.visible_height - thumb_height) * (virtual_viewport.content_height - virtual_viewport.visible_height)) / 1px : offset
                }
                on moved {
                    offset = scrollbar_drag.pressed && virtual_viewport.visible_height > thumb_height ? ((scrollbar_drag.mouse_y - thumb_height / 2.0) / (virtual_viewport.visible_height - thumb_height) * (virtual_viewport.content_height - virtual_viewport.visible_height)) / 1px : offset
                }
                Rectangle {
                    width: scrollbar_width
                    height: virtual_viewport.visible_height
                    radius: 6.0
                    background: solid(scrollbar_track)
                }
                Rectangle {
                    x: (scrollbar_width - 6px) / 2.0
                    y: virtual_viewport.offset_y / (virtual_viewport.content_height - virtual_viewport.visible_height) * (virtual_viewport.visible_height - thumb_height)
                    width: 6px
                    height: thumb_height
                    radius: 3.0
                    background: solid(scrollbar_drag.has_hover ? scrollbar_hover : scrollbar_thumb)
                }
            }
        }
        }

        if edge_shadow_width > 0.0 {
            Rectangle {
                y: 0px
                width: 100%
                height: edge_shadow_width * 1px
                background: linear_gradient([edge_shadow_color, #00000000], [0.0, 1.0], 90.0, "srgb")
                opacity: virtual_viewport.offset_y > 0px ? edge_shadow_intensity : 0.0
            }
            Rectangle {
                y: virtual_viewport.visible_height - edge_shadow_width * 1px
                width: 100%
                height: edge_shadow_width * 1px
                background: linear_gradient([#00000000, edge_shadow_color], [0.0, 1.0], 90.0, "srgb")
                opacity: virtual_viewport.offset_y < virtual_viewport.content_height - virtual_viewport.visible_height ? edge_shadow_intensity : 0.0
            }
        }
    }
}
