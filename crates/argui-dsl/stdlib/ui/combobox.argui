import { PopupWindow, FocusScope, Rectangle, Row, Column, Container, TextInput } from "@argui/native"
import { MenuItem } from "@argui/ui/menu-item.argui"
import { ChevronDown } from "@argui/icons"

export component Combobox {
    in-out property value: string = ""
    in-out property open: bool = false
    in property options: array<string> = []
    in property anchor: string
    in property label: string = "Combobox"
    in property placeholder: string = "Type or choose"
    in property enabled: bool = true
    in property width: length = 220px
    callback changed(value: string)
    callback open_changed(open: bool)

    private property focused: bool = false
    private property query: string = ""

    FocusScope {
        focus_on_tab_navigation: false
        focus_on_click: false
        role: "combo_box"
        accessible_name: label
        expandable: true
        expanded: open

        Row {
            width: width
            height: 40px
            padding: 10.0
            gap: 8.0
            align_items: "center"
            background: enabled ? var(--argui-input) : var(--argui-muted)
            border_color: focused ? var(--argui-ring) : var(--argui-border)
            radius: 8.0
            Container {
                width: 70%
                min_width: 0.0
                grow: 1.0
                height: 20px
                TextInput #editor {
                    width: 100%
                    height: 20px
                    value <=> value
                    placeholder: placeholder
                    label: label
                    enabled: enabled
                    search: true
                    text_color: var(--argui-foreground)
                    placeholder_color: var(--argui-muted-foreground)
                    caret_fill: solid(var(--argui-primary))
                    on input(next) { query = next }
                    on focus {
                        focused = true
                        query = ""
                        open = true
                        open_changed(true)
                    }
                    on blur { focused = false }
                    on submit {
                        open = false
                        changed(value)
                        open_changed(false)
                    }
                }
            }
            ChevronDown { size: 16px color: var(--argui-muted-foreground) }
        }
    }

    if open && enabled {
        PopupWindow {
            anchor: anchor
            placement: "bottom_start"
            dismiss_policy: "outside_pointer_or_escape"
            containment: "none"
            initial_focus: ""
            restore_focus: false
            width: width
            on dismiss {
                open = false
                open_changed(false)
            }

            Rectangle {
                width: width
                background: solid(var(--argui-surface))
                border_color: var(--argui-border)
                border_width: 1.0
                radius: 8.0
                Column {
                    width: 100%
                    padding: 4.0
                    gap: 2.0
                    for option in options key option {
                        if query == "" || contains(lower(option), lower(query)) {
                            MenuItem {
                                text: option
                                selected: option == value
                                on select {
                                    value = option
                                    query = ""
                                    open = false
                                    changed(value)
                                    open_changed(false)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
