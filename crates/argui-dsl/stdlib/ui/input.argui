import { Column, Row, TextInput } from "@argui/native"

export component Input {
    in-out property value: string = ""
    in property placeholder: string = ""
    in property label: string = ""
    in property description: string = ""
    in property enabled: bool = true
    in property read_only: bool = false
    in property search: bool = false
    in property invalid: bool = false
    in property selection_color: color = var(--argui-selection)
    in property selection_fill: brush = solid(selection_color)
    in property selection_radius: float = 3.0
    in property caret_fill: brush = solid(var(--argui-primary))
    in property caret_width: float = 1.5
    in property caret_height: float = 0.0
    in property caret_radius: float = 0.0
    in property caret_count: int = 1
    in property caret_spacing: float = 6.0
    in property caret_offset_y: float = 0.0
    in property caret_blink: bool = true
    private property focused: bool = false
    callback submit(value: string)
    slot leading
    slot trailing
    slot error

    Column {
        width: 100%
        gap: 4.0
        Row {
            width: 100%
            height: 44px
            padding: 11.0
            gap: 10.0
            radius: 8.0
            background: enabled ? var(--argui-input) : var(--argui-muted)
            border_color: invalid ? var(--argui-destructive) : focused ? var(--argui-ring) : var(--argui-border)
            leading
            Column {
                width: 50%
                min_width: 0.0
                grow: 1.0
                TextInput {
                    width: 100%
                    value <=> value
                    placeholder: placeholder
                    label: label
                    description: description
                    enabled: enabled
                    read_only: read_only
                    search: search
                    invalid: invalid
                    text_color: enabled ? var(--argui-foreground) : var(--argui-muted-foreground)
                    placeholder_color: var(--argui-muted-foreground)
                    selection_color: selection_color
                    selection_fill: selection_fill
                    selection_radius: selection_radius
                    caret_fill: caret_fill
                    caret_width: caret_width
                    caret_height: caret_height
                    caret_radius: caret_radius
                    caret_count: caret_count
                    caret_spacing: caret_spacing
                    caret_offset_y: caret_offset_y
                    caret_blink: caret_blink
                    on focus { focused = true }
                    on blur { focused = false }
                    on submit { submit(value) }
                }
            }
            trailing
        }
        error
    }
}
