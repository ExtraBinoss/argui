import { FocusScope, TouchArea, Rectangle } from "@argui/native"

export component Slider {
    in-out property value: float = 0.0
    in property minimum: float = 0.0
    in property maximum: float = 100.0
    in property width: length = 240px
    in property enabled: bool = true
    in property label: string = "Slider"
    callback changed(value: float)

    private property fraction: float = maximum <= minimum ? 0.0 : value <= minimum ? 0.0 : value >= maximum ? 1.0 : (value - minimum) / (maximum - minimum)

    FocusScope #focus_area {
        enabled: enabled
        role: "slider"
        accessible_name: label

        TouchArea #touch {
            width: width
            height: 24px
            enabled: enabled
            mouse_cursor: enabled ? "pointer" : "not_allowed"
            on pointer_down {
                value = minimum + (touch.mouse_x / width <= 0.0 ? 0.0 : touch.mouse_x / width >= 1.0 ? 1.0 : touch.mouse_x / width) * (maximum - minimum)
                changed(value)
            }
            on moved {
                value = minimum + (touch.mouse_x / width <= 0.0 ? 0.0 : touch.mouse_x / width >= 1.0 ? 1.0 : touch.mouse_x / width) * (maximum - minimum)
                changed(value)
            }

            Rectangle {
                y: 9px
                width: width
                height: 6px
                radius: 3.0
                background: solid(var(--argui-muted))
            }
            Rectangle {
                y: 9px
                width: width * fraction
                height: 6px
                radius: 3.0
                background: solid(var(--argui-primary))
            }
            Rectangle {
                x: width * fraction - 10px
                y: 2px
                width: 20px
                height: 20px
                radius: 10.0
                background: solid(var(--argui-surface))
                border_color: focus_area.focus_visible ? var(--argui-ring) : var(--argui-primary)
                border_width: focus_area.focus_visible ? 2.0 : 1.0
            }
        }
    }
}
