import { Popover } from "@argui/ui/popover.argui"
import { FocusScope, Rectangle, Row, Text, TouchArea } from "@argui/native"

export component HoverCard {
    in property label: string
    in property anchor: string
    in-out property open: bool = false
    in property width: length = 270px
    callback open_changed(value: bool)
    slot content

    FocusScope #trigger {
        role: "button"
        accessible_name: label
        expandable: true
        expanded: open
        keyboard_activation: "enter_or_space"
        on focus {
            open = true
            open_changed(true)
        }
        on click {
            open = true
            open_changed(true)
        }
        TouchArea #touch {
            mouse_cursor: "pointer"
            on pointer_enter {
                open = true
                open_changed(true)
            }
            Rectangle {
                background: solid(touch.pressed ? var(--argui-neutral-pressed) : touch.has_hover ? var(--argui-muted) : var(--argui-surface))
                border_color: trigger.focus_visible ? var(--argui-ring) : var(--argui-border)
                border_width: trigger.focus_visible ? 2.0 : 1.0
                radius: 7.0
                Row {
                    padding: 12.0
                    Text { content: label color: var(--argui-foreground) font_size: 14.0 weight: 600 }
                }
            }
        }
    }

    Popover {
        open: open
        anchor: anchor
        width: width
        dismiss_policy: trigger.focus_visible ? "outside_pointer_or_escape" : "outside_hover_or_escape"
        on dismiss {
            open = false
            open_changed(false)
        }
        content
    }
}
