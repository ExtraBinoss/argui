import { Button } from "@argui/ui/button.argui"
import { FocusScope, Row, Text } from "@argui/native"

component PageNumber {
    in property number: int
    in property current: bool = false
    in property enabled: bool = true
    callback choose()

    Button {
        text: str(number)
        tooltip: current ? "Current page " + str(number) : "Page " + str(number)
        variant: current ? "primary" : "ghost"
        enabled: enabled
        height: 34px
        padding: 10.0
        on click { choose() }
    }
}

export component Pagination {
    in-out property page: int = 1
    in property total: int = 1
    in property enabled: bool = true
    callback selected(page: int)

    FocusScope {
        role: "navigation"
        accessible_name: "Pagination"
        focus_on_tab_navigation: false
        Row {
            wrap: true
            gap: 4.0
            Button { text: "Previous" variant: "outline" height: 34px enabled: enabled && page > 1 on click { page = page - 1 selected(page) } }

            if total <= 7 {
                for number in [1, 2, 3, 4, 5, 6, 7] key number {
                    if number <= total {
                        PageNumber { number: number current: number == page enabled: enabled on choose { page = number selected(page) } }
                    }
                }
            }
            if total > 7 && page <= 4 {
                for number in [1, 2, 3, 4, 5] key number {
                    PageNumber { number: number current: number == page enabled: enabled on choose { page = number selected(page) } }
                }
                Text { content: "…" color: var(--argui-muted-foreground) font_size: 15.0 }
                PageNumber { number: total enabled: enabled on choose { page = total selected(page) } }
            }
            if total > 7 && page > 4 && page < total - 3 {
                PageNumber { number: 1 enabled: enabled on choose { page = 1 selected(page) } }
                Text { content: "…" color: var(--argui-muted-foreground) font_size: 15.0 }
                PageNumber { number: page - 1 enabled: enabled on choose { page = page - 1 selected(page) } }
                PageNumber { number: page current: true enabled: enabled }
                PageNumber { number: page + 1 enabled: enabled on choose { page = page + 1 selected(page) } }
                Text { content: "…" color: var(--argui-muted-foreground) font_size: 15.0 }
                PageNumber { number: total enabled: enabled on choose { page = total selected(page) } }
            }
            if total > 7 && page >= total - 3 {
                PageNumber { number: 1 enabled: enabled on choose { page = 1 selected(page) } }
                Text { content: "…" color: var(--argui-muted-foreground) font_size: 15.0 }
                for distance in [4, 3, 2, 1, 0] key distance {
                    PageNumber { number: total - distance current: page == total - distance enabled: enabled on choose { page = total - distance selected(page) } }
                }
            }

            Button { text: "Next" variant: "outline" height: 34px enabled: enabled && page < total on click { page = page + 1 selected(page) } }
        }
    }
}
