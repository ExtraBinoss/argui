import { Button } from "@argui/ui"
import { Column, Rectangle, Row, Text } from "@argui/native"

export component Message {
    in property author: string
    in property timestamp: string
    in property body: string
    in property end: bool = false
    in property show_reaction: bool = false
    in-out property liked: bool = false
    callback react(liked: bool)

    Row {
        width: 100%
        justify_content: end ? "end" : "start"
        Column {
            width: 78%
            gap: 6.0
            align_items: end ? "end" : "start"
            Text {
                content: author + " · " + timestamp
                color: var(--argui-muted-foreground)
                font_size: 12.0
                weight: 500
            }
            Rectangle {
                width: 100%
                radius: 16.0
                background: solid(var(--argui-muted))
                Column { width: 100% padding: 12.0
                    Text { content: body color: var(--argui-foreground) font_size: 14.0 }
                }
            }
            if show_reaction {
                Button {
                    text: liked ? "Liked" : "Like"
                    variant: "ghost"
                    on click { liked = !liked react(liked) }
                }
            }
        }
    }
}
