import { Button } from "@argui/ui/button.argui"
import { Slider } from "@argui/ui/slider.argui"
import { Column, FocusScope, Rectangle, Row, Text, TouchArea } from "@argui/native"

export component ColorPicker {
    in-out property hue: float = 257.0
    in-out property saturation: float = 0.74
    in-out property value: float = 0.95
    in-out property opacity: float = 80.0
    in-out property format: string = "HEX"
    in property enabled: bool = true
    in property label: string = "Accent color"

    private property selected_color: color = hsv(hue, saturation, value, opacity / 100.0)
    private property pure_hue: color = hsv(hue, 1.0, 1.0, 1.0)
    private property lightness: float = value * (1.0 - saturation / 2.0)
    private property hsl_saturation: float = lightness <= 0.0 || lightness >= 1.0 ? 0.0 : (value - lightness) / (lightness < 0.5 ? 2.0 * lightness : 2.0 * (1.0 - lightness))

    FocusScope {
        role: "group"
        accessible_name: label
        focus_on_tab_navigation: false
        Column { width: 300px gap: 14.0
            Column { gap: 6.0
                Text { content: "Saturation and brightness" color: var(--argui-foreground) weight: 600 font_size: 13.0 }
                TouchArea #pad {
                    width: 280px height: 176px
                    enabled: enabled
                    mouse_cursor: enabled ? "crosshair" : "not_allowed"
                    on pointer_down {
                        saturation = pad.mouse_x / 280px < 0.0 ? 0.0 : pad.mouse_x / 280px > 1.0 ? 1.0 : pad.mouse_x / 280px
                        value = pad.mouse_y / 176px < 0.0 ? 1.0 : pad.mouse_y / 176px > 1.0 ? 0.0 : 1.0 - pad.mouse_y / 176px
                    }
                    on moved {
                        saturation = pad.pressed ? (pad.mouse_x / 280px < 0.0 ? 0.0 : pad.mouse_x / 280px > 1.0 ? 1.0 : pad.mouse_x / 280px) : saturation
                        value = pad.pressed ? (pad.mouse_y / 176px < 0.0 ? 1.0 : pad.mouse_y / 176px > 1.0 ? 0.0 : 1.0 - pad.mouse_y / 176px) : value
                    }
                    Rectangle {
                        width: 280px height: 176px radius: 9.0 clip: true
                        background: linear_gradient([#ffffff, pure_hue], [0.0, 1.0], 0.0, "srgb")
                        Rectangle {
                            width: 280px height: 176px
                            background: linear_gradient([#00000000, #000000], [0.0, 1.0], 90.0, "srgb")
                        }
                    }
                    Rectangle {
                        x: 280px * saturation - 7px
                        y: 176px * (1.0 - value) - 7px
                        width: 14px height: 14px radius: 7.0
                        background: solid(selected_color)
                        border_color: #ffffff
                        border_width: 2.0
                    }
                }
            }
            Column { gap: 6.0
                Text { content: "Hue · " + str(hue) + "°" color: var(--argui-foreground) weight: 600 font_size: 13.0 }
                TouchArea #hue_strip {
                    width: 280px height: 24px
                    enabled: enabled
                    mouse_cursor: enabled ? "pointer" : "not_allowed"
                    on pointer_down { hue = (hue_strip.mouse_x / 280px < 0.0 ? 0.0 : hue_strip.mouse_x / 280px > 1.0 ? 1.0 : hue_strip.mouse_x / 280px) * 360.0 }
                    on moved { hue = hue_strip.pressed ? (hue_strip.mouse_x / 280px < 0.0 ? 0.0 : hue_strip.mouse_x / 280px > 1.0 ? 1.0 : hue_strip.mouse_x / 280px) * 360.0 : hue }
                    Rectangle { y: 7px width: 280px height: 10px radius: 5.0 background: linear_gradient([#ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000], [0.0, 0.1667, 0.3333, 0.5, 0.6667, 0.8333, 1.0], 0.0, "srgb") }
                    Rectangle { x: 280px * hue / 360.0 - 8px y: 3px width: 16px height: 16px radius: 8.0 background: solid(pure_hue) border_color: #ffffff border_width: 2.0 }
                }
            }
            Column { gap: 5.0
                Text { content: "Opacity · " + str(opacity) + "%" color: var(--argui-foreground) weight: 600 font_size: 13.0 }
                Slider { label: "Opacity" value <=> opacity minimum: 0.0 maximum: 100.0 width: 280px enabled: enabled }
            }
            Row { gap: 5.0 wrap: true
                Button { text: "HEX" variant: format == "HEX" ? "secondary" : "ghost" enabled: enabled height: 30px padding: 9.0 on click { format = "HEX" } }
                Button { text: "RGB" variant: format == "RGB" ? "secondary" : "ghost" enabled: enabled height: 30px padding: 9.0 on click { format = "RGB" } }
                Button { text: "HSL" variant: format == "HSL" ? "secondary" : "ghost" enabled: enabled height: 30px padding: 9.0 on click { format = "HSL" } }
                Button { text: "HSV" variant: format == "HSV" ? "secondary" : "ghost" enabled: enabled height: 30px padding: 9.0 on click { format = "HSV" } }
            }
            Text { content: format == "HEX" ? color_hex(selected_color) : format == "RGB" ? str(color_red(selected_color)) + ", " + str(color_green(selected_color)) + ", " + str(color_blue(selected_color)) : format == "HSL" ? str(hue) + "°, " + str(hsl_saturation * 100.0) + "%, " + str(lightness * 100.0) + "%" : str(hue) + "°, " + str(saturation * 100.0) + "%, " + str(value * 100.0) + "%" color: var(--argui-foreground) weight: 600 font_size: 14.0 }
            Rectangle { width: 280px height: 48px radius: 9.0 background: solid(selected_color) border_color: var(--argui-border) border_width: 1.0 }
        }
    }
}
