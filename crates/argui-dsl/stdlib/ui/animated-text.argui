import { Rectangle, Text } from "@argui/native"

export component AnimatedText {
    in property first: string
    in property second: string
    in property show_second: bool = false
    in property mode: string = "fade"
    in property font_size: float = 44.0
    in property width: length = 170px
    in property height: length = 62px

    Rectangle {
        width: width
        height: height
        clip: true
        background: solid(#00000000)
        Text {
            content: first
            x: 0px
            y: 0px
            opacity: 1.0
            color: var(--argui-foreground)
            weight: 700
            font_size: font_size
            no_wrap: true
            states { hidden when show_second {
                x: mode == "slide" ? -width : 0px
                y: mode == "roll" ? -height : 0px
                opacity: mode == "fade" ? 0.0 : 1.0
            } }
            animate x { transition: in-out duration: 360ms }
            animate y { transition: in-out duration: 360ms }
            animate opacity { transition: in-out duration: 360ms }
        }
        Text {
            content: second
            x: mode == "slide" ? width : 0px
            y: mode == "roll" ? height : 0px
            opacity: mode == "fade" ? 0.0 : 1.0
            color: var(--argui-foreground)
            weight: 700
            font_size: font_size
            no_wrap: true
            states { shown when show_second {
                x: 0px
                y: 0px
                opacity: 1.0
            } }
            animate x { transition: in-out duration: 360ms }
            animate y { transition: in-out duration: 360ms }
            animate opacity { transition: in-out duration: 360ms }
        }
    }
}
