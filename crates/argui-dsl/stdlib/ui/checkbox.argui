import { FocusScope, Rectangle, Row, Text, TouchArea } from "@argui/native"
import { Check } from "@argui/icons"

export component Checkbox {
    in property label: string
    in-out property checked: bool = false
    in property enabled: bool = true
    callback changed(value: bool)

    FocusScope #focus_area {
        role: "check_box"
        accessible_name: label
        checked: checked
        enabled: enabled
        keyboard_activation: "enter_or_space"
        on click {
            checked = !checked
            changed(checked)
        }
        TouchArea {
            enabled: enabled
            mouse_cursor: enabled ? "pointer" : "not_allowed"
            Row {
                gap: 9.0
                padding: 6.0
                align_items: "center"
                Rectangle {
                    width: 18px
                    height: 18px
                    radius: 5.0
                    background: solid(!enabled ? var(--argui-muted) : checked ? var(--argui-primary) : var(--argui-surface))
                    border_color: focus_area.focus_visible ? var(--argui-ring) : enabled && checked ? var(--argui-primary) : var(--argui-border)
                    border_width: focus_area.focus_visible ? 2.0 : 1.0
                    Row { width: 100% height: 100% align_items: "center" justify_content: "center"
                        Check { size: 14px color: enabled ? var(--argui-primary-foreground) : var(--argui-muted-foreground) opacity: 0.0 states { active when checked { opacity: 1.0 } } animate opacity { transition: in-out duration: 150ms } }
                    }
                }
                Text { content: label color: enabled ? var(--argui-foreground) : var(--argui-muted-foreground) font_size: 14.0 }
            }
        }
    }
}
