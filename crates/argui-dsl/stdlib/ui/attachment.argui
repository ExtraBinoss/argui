import { Progress } from "@argui/ui/progress.argui"
import { Column, FocusScope, Rectangle, Row, Text } from "@argui/native"

export component FileAttachment {
    in property filename: string
    in property kind: string
    in property status: string
    in property progress: float = 100.0
    in property error: bool = false
    in property busy: bool = false
    slot actions

    FocusScope {
        role: "group"
        accessible_name: filename + ", " + status
        busy: busy
        Rectangle {
            width: 100%
            background: solid(var(--argui-surface))
            border_color: error ? var(--argui-destructive) : var(--argui-border)
            border_width: 1.0
            radius: 10.0
            Row {
                width: 100%
                padding: 14.0
                gap: 14.0
                align_items: "center"
                Rectangle {
                    width: 48px
                    height: 48px
                    radius: 8.0
                    background: solid(var(--argui-muted))
                    Row {
                        width: 100%
                        height: 100%
                        align_items: "center"
                        justify_content: "center"
                        Text { content: kind color: var(--argui-muted-foreground) weight: 700 font_size: 11.0 }
                    }
                }
                Column {
                    grow: 1.0
                    min_width: 0.0
                    gap: 5.0
                    Text { content: filename color: var(--argui-foreground) weight: 600 font_size: 14.0 }
                    Text { content: status color: error ? var(--argui-destructive) : var(--argui-muted-foreground) font_size: 12.0 }
                    if busy {
                        Progress { label: filename + " transfer progress" value: progress width: 200px }
                    }
                }
                actions
            }
        }
    }
}
