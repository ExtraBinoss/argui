import { PopupWindow, FocusScope, KeyBinding, Rectangle, Column } from "@argui/native"

export component Menu {
    in-out property open: bool = false
    in property anchor: string
    in property label: string = "Menu"
    in property width: length = 220px
    in property placement: string = "bottom_start"
    in property dismiss_policy: string = "outside_pointer_or_escape"
    in property focus_containment: string = "trap"
    in property restore_focus: bool = true
    callback dismiss()
    slot content

        PopupWindow {
            visible: open
            anchor: anchor
            placement: placement
            dismiss_policy: dismiss_policy
            containment: focus_containment
            initial_focus: "first"
            restore_focus: restore_focus
            width: width
            on dismiss {
                open = false
                dismiss()
            }

            FocusScope {
                role: "menu"
                accessible_name: label
                focus_on_tab_navigation: false
                focus_on_click: false

                KeyBinding { shortcut: "ArrowDown" on activated { focus_next() } }
                KeyBinding { shortcut: "ArrowUp" on activated { focus_previous() } }

                Rectangle {
                    width: width
                    background: solid(var(--argui-surface))
                    border_color: var(--argui-border)
                    border_width: 1.0
                    radius: 8.0
                    shadow_blur: 12.0
                    shadow_offset_y: 5.0
                    shadow_color: #00000026

                    Column {
                        width: 100%
                        padding: 4.0
                        gap: 2.0
                        content
                    }
                }
            }
        }
}
