import { FocusScope, Rectangle, Row, Text, TouchArea } from "@argui/native"

export component ListRow {
    in property label: string
    in-out property selected: bool = false
    in property height: length = 36px
    callback changed(selected: bool)

    FocusScope #focus_area {
        width: 100%
        role: "check_box"
        accessible_name: label
        checked: selected
        keyboard_activation: "enter_or_space"
        on click {
            selected = !selected
            changed(selected)
        }
        TouchArea {
            width: 100%
            height: height
            mouse_cursor: "pointer"
            Rectangle {
                width: 100%
                height: height
                radius: 6.0
                background: solid(selected ? var(--argui-selection) : var(--argui-surface))
                border_color: focus_area.focus_visible ? var(--argui-ring) : var(--argui-border)
                border_width: focus_area.focus_visible ? 2.0 : 1.0
                Row { width: 100% height: height padding: 8.0 align_items: "center"
                    Text { content: label color: var(--argui-foreground) font_size: 14.0 }
                }
            }
        }
    }
}
