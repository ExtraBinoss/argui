import { Column, Text } from "@argui/native"

export component Field {
    in property label: string
    in property description: string = ""
    in property error: string = ""
    in property required: bool = false
    slot content

    Column {
        width: 100%
        gap: 6.0
        Text {
            content: label + (required ? " *" : "")
            color: var(--argui-foreground)
            font_size: 14.0
            weight: 600
        }
        content
        if description != "" {
            Text { content: description color: var(--argui-muted-foreground) font_size: 13.0 }
        }
        if error != "" {
            Text { content: error color: var(--argui-destructive) font_size: 13.0 }
        }
    }
}
