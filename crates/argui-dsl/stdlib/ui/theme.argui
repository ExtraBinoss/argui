export theme ArguiDefaultTheme {
    --argui-background: color = #ffffff
    --argui-surface: color = #ffffff
    --argui-glass-surface: color = #f8fafc99
    --argui-foreground: color = #09090b
    --argui-muted: color = #f4f4f5
    --argui-neutral-hover: color = #e4e4e7
    --argui-neutral-pressed: color = #d4d4d8
    --argui-muted-foreground: color = #71717a
    --argui-border: color = #d4d4d8
    --argui-input: color = #ffffff
    --argui-scrollbar-thumb: color = #a1a1aa
    --argui-selection: color = #93c5fd66
    --argui-primary: color = #2563eb
    --argui-primary-foreground: color = #ffffff
    --argui-primary-hover: color = #1d4ed8
    --argui-primary-pressed: color = #1e40af
    --argui-ring: color = #93c5fd
    --argui-destructive: color = #dc2626
    --argui-destructive-hover: color = #b91c1c
    --argui-destructive-pressed: color = #991b1b

    light { --argui-background: #ffffff }
    dark {
        --argui-background: #09090b
        --argui-surface: #18181b
        --argui-glass-surface: #18181b99
        --argui-foreground: #fafafa
        --argui-muted: #27272a
        --argui-neutral-hover: #3f3f46
        --argui-neutral-pressed: #52525b
        --argui-muted-foreground: #a1a1aa
        --argui-border: #3f3f46
        --argui-input: #18181b
        --argui-scrollbar-thumb: #71717a
        --argui-selection: #60a5fa66
        --argui-ring: #60a5fa
    }
    light-violet {
        --argui-primary: #7c3aed
        --argui-primary-hover: #6d28d9
        --argui-primary-pressed: #5b21b6
        --argui-ring: #c4b5fd
        --argui-selection: #c4b5fd66
    }
    dark-violet {
        --argui-background: #09090b
        --argui-surface: #18181b
        --argui-glass-surface: #18181b99
        --argui-foreground: #fafafa
        --argui-muted: #27272a
        --argui-neutral-hover: #3f3f46
        --argui-neutral-pressed: #52525b
        --argui-muted-foreground: #a1a1aa
        --argui-border: #3f3f46
        --argui-input: #18181b
        --argui-scrollbar-thumb: #71717a
        --argui-primary: #8b5cf6
        --argui-primary-hover: #7c3aed
        --argui-primary-pressed: #6d28d9
        --argui-ring: #a78bfa
        --argui-selection: #a78bfa66
    }
    light-emerald {
        --argui-primary: #059669
        --argui-primary-hover: #047857
        --argui-primary-pressed: #065f46
        --argui-ring: #6ee7b7
        --argui-selection: #6ee7b766
    }
    dark-emerald {
        --argui-background: #09090b
        --argui-surface: #18181b
        --argui-glass-surface: #18181b99
        --argui-foreground: #fafafa
        --argui-muted: #27272a
        --argui-neutral-hover: #3f3f46
        --argui-neutral-pressed: #52525b
        --argui-muted-foreground: #a1a1aa
        --argui-border: #3f3f46
        --argui-input: #18181b
        --argui-scrollbar-thumb: #71717a
        --argui-primary: #10b981
        --argui-primary-hover: #059669
        --argui-primary-pressed: #047857
        --argui-ring: #34d399
        --argui-selection: #34d39966
    }
}
