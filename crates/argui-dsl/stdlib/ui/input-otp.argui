import { Container, Rectangle, Row, Text, TextInput } from "@argui/native"

export component InputOtp {
    in-out property value: string = ""
    in property label: string = "Verification code"
    in property enabled: bool = true
    private property focused: bool = false
    callback submit(value: string)

    Container {
        width: 258px
        height: 44px

        Row {
            x: 0px
            y: 0px
            width: 258px
            height: 44px
            gap: 6.0
            for index in [0, 1, 2, 3, 4, 5] key index {
                Rectangle {
                    width: 38px
                    height: 44px
                    background: solid(enabled ? var(--argui-input) : var(--argui-muted))
                    border_color: focused && slice(value, index, 1) == "" && (index == 0 || slice(value, index - 1, 1) != "") ? var(--argui-ring) : var(--argui-border)
                    border_width: focused && slice(value, index, 1) == "" && (index == 0 || slice(value, index - 1, 1) != "") ? 2.0 : 1.0
                    radius: 8.0
                    Row { width: 100% height: 100% justify_content: "center" align_items: "center"
                        Text {
                            content: slice(value, index, 1)
                            color: enabled ? var(--argui-foreground) : var(--argui-muted-foreground)
                            font_size: 19.0
                            weight: 600
                        }
                    }
                }
            }
        }

        TextInput #editor {
            x: 0px
            y: 0px
            width: 258px
            height: 44px
            value <=> value
            label: label
            enabled: enabled
            max_digits: 6
            text_color: #00000000
            caret_fill: solid(#00000000)
            on focus { focused = true }
            on blur { focused = false }
            on submit { submit(value) }
        }
    }
}
