import { PopupWindow, Rectangle, Column } from "@argui/native"

export component Popover {
    in property open: bool = false
    in property anchor: string
    in property width: length = 240px
    in property placement: string = "bottom_start"
    in property dismiss_policy: string = "outside_pointer_or_escape"
    in property initial_focus: string = ""
    in property restore_focus: bool = true
    in property surface_fill: brush = solid(var(--argui-surface))
    in property border_color: color = var(--argui-border)
    in property radius: float = 8.0
    in property backdrop_filter: string = "none"
    in property shadow_blur: float = 12.0
    in property shadow_color: color = #00000026
    callback dismiss()
    slot content

    PopupWindow {
        visible: open
        anchor: anchor
        placement: placement
        dismiss_policy: dismiss_policy
        initial_focus: initial_focus
        restore_focus: restore_focus
        width: width
        on dismiss { dismiss() }
        Rectangle {
            width: width
            background: surface_fill
            backdrop_filter: backdrop_filter
            border_color: border_color
            border_width: 1.0
            radius: radius
            shadow_blur: shadow_blur
            shadow_offset_y: 5.0
            shadow_color: shadow_color
            Column {
                width: 100%
                padding: 12.0
                content
            }
        }
    }
}
