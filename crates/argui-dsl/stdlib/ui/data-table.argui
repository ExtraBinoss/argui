import { Column, FocusScope, Rectangle, Row, TouchArea } from "@argui/native"

export component DataTable {
    in property label: string = "Data table"
    in property width: length = 680px
    slot content

    FocusScope {
        role: "grid"
        accessible_name: label
        focus_on_tab_navigation: false
        Rectangle {
            width: width
            background: solid(var(--argui-surface))
            border_color: var(--argui-border)
            border_width: 1.0
            radius: 10.0
            clip: true
            Column { width: 100% content }
        }
    }
}

export component DataTableRow {
    in property label: string
    in property selected: bool = false
    callback select()
    slot content

    FocusScope #focus_area {
        role: "row"
        accessible_name: label
        keyboard_activation: "enter_or_space"
        on click { select() }
        TouchArea #touch {
            mouse_cursor: "pointer"
            Rectangle {
                width: 100%
                background: solid(selected ? var(--argui-selection) : touch.has_hover ? var(--argui-muted) : var(--argui-surface))
                border_color: focus_area.focus_visible ? var(--argui-ring) : var(--argui-border)
                border_width: focus_area.focus_visible ? 2.0 : 0.0
                Row {
                    width: 100%
                    height: 52px
                    align_items: "center"
                    content
                }
            }
        }
    }
}
