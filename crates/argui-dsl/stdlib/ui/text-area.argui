import { Column, Container, Row, Text, TextInput } from "@argui/native"

export component TextArea {
    in-out property value: string = ""
    in property label: string = ""
    in property description: string = ""
    in property placeholder: string = ""
    in property height: length = 120px
    in property enabled: bool = true
    in property read_only: bool = false
    in property invalid: bool = false
    in property selection_fill: brush = solid(var(--argui-selection))
    in property selection_radius: float = 3.0
    in property caret_fill: brush = solid(var(--argui-primary))
    in property caret_width: float = 1.5
    in property caret_blink: bool = true
    private property focused: bool = false
    callback changed()
    slot corner

    Column {
        width: 100%
        gap: 6.0
        if label != "" {
            Text { content: label color: var(--argui-foreground) font_size: 13.0 weight: 600 }
        }
        Container {
            width: 100%
            height: height
            Row {
                width: 100%
                height: 100%
                padding: 10.0
                radius: 8.0
                background: enabled ? var(--argui-input) : var(--argui-muted)
                border_color: invalid ? var(--argui-destructive) : focused ? var(--argui-ring) : var(--argui-border)
                TextInput {
                    width: 100%
                    height: 100%
                    value <=> value
                    multiline: true
                    placeholder: placeholder
                    label: label
                    description: description
                    enabled: enabled
                    read_only: read_only
                    invalid: invalid
                    text_color: enabled ? var(--argui-foreground) : var(--argui-muted-foreground)
                    placeholder_color: var(--argui-muted-foreground)
                    selection_fill: selection_fill
                    selection_radius: selection_radius
                    caret_fill: caret_fill
                    caret_width: caret_width
                    caret_blink: caret_blink
                    on focus { focused = true }
                    on blur { focused = false }
                    on edit { changed() }
                }
            }
            corner
        }
        if description != "" {
            Text { content: description color: invalid ? var(--argui-destructive) : var(--argui-muted-foreground) font_size: 12.0 }
        }
    }
}
