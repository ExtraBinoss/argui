import { Column, Container, FocusScope, KeyBinding, Rectangle, Row, Text, TouchArea } from "@argui/native"

export component SplitHandle {
    in-out property size: float
    in property minimum: float
    in property maximum: float
    in property reset_size: float
    in property vertical: bool = false
    in property trailing: bool = false
    in property label: string = "Resize panels"
    in property length: length = 210px
    private property start_size: float = 0.0

    FocusScope #focus_area {
        width: vertical ? length : 8px
        height: vertical ? 8px : length
        role: "separator"
        accessible_name: label
        if !vertical {
            KeyBinding { shortcut: "ArrowLeft" on activated { size = trailing ? (size + 10.0 >= maximum ? maximum : size + 10.0) : (size - 10.0 <= minimum ? minimum : size - 10.0) } }
            KeyBinding { shortcut: "ArrowRight" on activated { size = trailing ? (size - 10.0 <= minimum ? minimum : size - 10.0) : (size + 10.0 >= maximum ? maximum : size + 10.0) } }
        }
        if vertical {
            KeyBinding { shortcut: "ArrowUp" on activated { size = trailing ? (size + 10.0 >= maximum ? maximum : size + 10.0) : (size - 10.0 <= minimum ? minimum : size - 10.0) } }
            KeyBinding { shortcut: "ArrowDown" on activated { size = trailing ? (size - 10.0 <= minimum ? minimum : size - 10.0) : (size + 10.0 >= maximum ? maximum : size + 10.0) } }
        }
        KeyBinding { shortcut: "Home" on activated { size = minimum } }
        KeyBinding { shortcut: "End" on activated { size = maximum } }
        TouchArea #touch {
            width: vertical ? length : 8px
            height: vertical ? 8px : length
            mouse_cursor: vertical ? "ns_resize" : "ew_resize"
            on pointer_down { start_size = size }
            on drag_x(delta) {
                size = vertical ? size : start_size + delta * (trailing ? -1.0 : 1.0) < minimum ? minimum : start_size + delta * (trailing ? -1.0 : 1.0) > maximum ? maximum : start_size + delta * (trailing ? -1.0 : 1.0)
            }
            on drag_y(delta) {
                size = vertical ? start_size + delta * (trailing ? -1.0 : 1.0) < minimum ? minimum : start_size + delta * (trailing ? -1.0 : 1.0) > maximum ? maximum : start_size + delta * (trailing ? -1.0 : 1.0) : size
            }
            on double_clicked { size = reset_size }
            Rectangle {
                x: vertical ? 0px : 3px
                y: vertical ? 3px : 0px
                width: vertical ? length : 2px
                height: vertical ? 2px : length
                background: solid(focus_area.focus_visible || touch.has_hover || touch.pressed ? var(--argui-primary) : var(--argui-border))
            }
        }
    }
}

export component SplitPanel {
    in property title: string
    in property detail: string
    in property accent: color = var(--argui-primary)

    Rectangle { width: 100% height: 100% radius: 10.0 clip: true background: solid(var(--argui-surface)) border_color: var(--argui-border) border_width: 1.0
        Column { width: 100% height: 100% padding: 12.0 gap: 10.0
            Row { gap: 8.0 align_items: "center"
                Container { width: 8px height: 8px radius: 4.0 background: accent }
                Text { content: title color: var(--argui-foreground) weight: 700 font_size: 11.0 no_wrap: true }
            }
            Text { content: detail color: var(--argui-muted-foreground) font_size: 13.0 }
        }
    }
}
