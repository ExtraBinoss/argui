import { FocusScope, Rectangle } from "@argui/native"

export component Progress {
    in property label: string = "Progress"
    in property value: float = 0.0
    in property indeterminate: bool = false
    in property width: length = 360px

    private property fraction: float = value <= 0.0 ? 0.0 : value >= 100.0 ? 1.0 : value / 100.0

    FocusScope {
        role: "progress"
        accessible_name: indeterminate ? label : label + " " + str(value) + "%"
        busy: indeterminate || value < 100.0
        focus_on_click: false
        focus_on_tab_navigation: false

        Rectangle {
            width: width
            height: 8px
            radius: 4.0
            clip: true
            background: solid(var(--argui-muted))

            if !indeterminate {
                Rectangle {
                    width: width * fraction
                    height: 8px
                    radius: 4.0
                    background: solid(var(--argui-primary))
                }
            }
            if indeterminate {
                Rectangle {
                    width: width * 0.3
                    height: 8px
                    radius: 4.0
                    background: solid(var(--argui-primary))
                    animate x { from: 0px to: width * 0.7 duration: 1600ms iterations: "infinite" }
                }
            }
        }
    }
}
