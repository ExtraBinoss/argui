import {
    Container,
    Pressable,
    Text,
    TextEditor
} from "@argui/native"

export component Button {
    in property text: string
    in property enabled: bool = true
    callback click()

    Pressable {
        label: text
        enabled: enabled
        padding: 10.0
        on click { click() }

        Text { text: text }
    }
}

export component Input {
    in-out property value: string = ""
    in property placeholder: string = ""
    in property label: string = ""
    in property enabled: bool = true
    in property read_only: bool = false
    in property invalid: bool = false
    callback submit(value: string)

    TextEditor {
        value <=> value
        placeholder: placeholder
        label: label
        enabled: enabled
        read_only: read_only
        invalid: invalid
        on submit { submit(value) }
    }
}

export component Card {
    slot content

    Container {
        padding: 16.0
        content
    }
}
