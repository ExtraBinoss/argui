{
  "name": "argui-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/docs-examples.mjs && nuxt dev --host 127.0.0.1",
    "build": "node scripts/catalogue.mjs && node scripts/docs-examples.mjs && node scripts/gallery.mjs --check && nuxt build",
    "generate": "node scripts/catalogue.mjs && node scripts/docs-examples.mjs && node scripts/gallery.mjs --check && nuxt generate",
    "preview": "nuxt preview --host 127.0.0.1",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "catalogue": "node scripts/catalogue.mjs",
    "docs:generate": "node scripts/docs-examples.mjs",
    "gallery:build": "node scripts/gallery.mjs",
    "gallery:copy": "node scripts/gallery.mjs --copy",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:generated": "node tests/generated.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.45.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "shiki": "^4.4.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11"
  }
}
